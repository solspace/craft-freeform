{% set value = submission[field.handle] is not null ? submission[field.handle].value : [] %}
<div class="field freeform-submission-table" data-freeform-table>
    <div class="heading">
        <label id="submission-table-{{ field.handle }}-label">{{ field.label }}</label>
    </div>
    <div class="freeform-cp-table-scroll">
    <table class="editable fullwidth" aria-labelledby="submission-table-{{ field.handle }}-label">
        <thead>
        <tr>
            {% for column in field.tableLayout %}
                <th scope="col" id="submission-table-{{ field.handle }}-heading-{{ loop.index0 }}">
                    {{ column.label|default('') }}
                </th>
            {% endfor %}
            <th scope="col"><span class="visually-hidden">{{ "Row actions"|t('app') }}</span></th>
        </tr>
        </thead>
        <tbody>
        {% if value is empty %}
            <tr>
                {% for index, column in field.tableLayout %}
                    {% set colName = field.handle ~ "[0][" ~ index ~ "]" %}
                    {% set colType = column.type|default("text") %}
                    {% set colClass = "" %}
                    {% if colType == "text" or colType == "textarea" or colType == "number" %}
                        {% set colClass = "textual table-cell-" ~ colType %}
                    {% elseif colType == "select" %}
                        {% set colClass = "thin table-cell-select" %}
                    {% else %}
                        {% set colClass = "table-cell-" ~ colType %}
                    {% endif %}
                    <td class="{{ colClass }}">
                        {% switch colType %}
                        {% case "select" %}
                            <div class="select small">
                                <select name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                        data-default-value="{{ column.value|default("") }}"
                                >
                                    {% for option in column.options %}
                                        <option value="{{ option }}">
                                            {{ option }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% case "radio" %}
                            <div class="freeform-cp-table-options" role="radiogroup" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}">
                                {% for option in column.options %}
                                    {% set choiceId = 'labeled-' ~ field.handle ~ '-' ~ 0 ~ '-' ~ index ~ '-' ~ loop.index0 %}
                                    <div>
                                        <input type="radio" class="radio" id="{{ choiceId }}" name="{{ colName }}" value="{{ option }}" {{ column.value == option ? 'checked="checked"' }} />
                                        <label for="{{ choiceId }}">{{ option }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% case "checkbox" %}
                            {% set choiceId = 'labeled-' ~ field.handle ~ '-' ~ 0 ~ '-' ~ index ~ '-0' %}
                            <div class="checkbox-wrapper">
                                <input type="checkbox" class="checkbox" id="{{ choiceId }}"
                                       data-default-value="{{ column.value|default("Yes") }}"
                                       name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                       value="{{ column.value|default("Yes") }}"
                                />
                                <label for="{{ choiceId }}"><span class="visually-hidden">{{ column.label|default('') }}</span></label>
                            </div>
                        {% case "file" %}
                            {% set metadata = column.metadata|default({}) %}
                            {% set fileCount = metadata.fileCount|default(1) %}
                            {% set fileInputName = colName %}
                            {% if fileCount > 1 %}
                                {% set fileInputName = colName ~ "[]" %}
                            {% endif %}
                            <input type="file" name="{{ fileInputName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"{% if fileCount > 1 %} multiple{% endif %} />
                        {% case "number" %}
                            {% set metadata = column.metadata|default({}) %}
                            {% set minMaxValues = metadata.minMaxValues|default([null, null]) %}
                            <input type="number"
                                   class="text fullwidth"
                                   name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                   value="{{ column.value|default("") }}"
                                   data-default-value="{{ column.value|default("") }}"
                                   placeholder="{{ column.placeholder|default("") }}"
                                   {% if minMaxValues[0] is not null %}min="{{ minMaxValues[0] }}"{% endif %}
                                   {% if minMaxValues[1] is not null %}max="{{ minMaxValues[1] }}"{% endif %}
                                   step="{{ metadata.step is defined and metadata.step is not null ? metadata.step : 1 }}"
                            />
                        {% case "textarea" %}
                            <textarea class="text fullwidth"
                                      name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                      data-default-value="{{ column.value|default("") }}"
                                      rows="2"
                            >
                                {{- column.value|default("") -}}
                            </textarea>
                        {% default %}
                            <input type="text"
                                   class="text fullwidth"
                                   name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                   value="{{ column.value|default("") }}"
                                   data-default-value="{{ column.value|default("") }}"
                                   placeholder="{{ column.placeholder|default("") }}"
                            />
                        {% endswitch %}
                    </td>
                {% endfor %}
                <td class="thin action">
                    <button type="button" class="delete icon"
                       data-freeform-table-remove-row
                       title="{{ 'Remove row'|t('freeform') }}" aria-label="{{ 'Remove row'|t('freeform') }}"></button>
                </td>
            </tr>
        {% else %}
            {% for rowIndex, row in value %}
                <tr>
                    {% for index, column in field.tableLayout %}
                        {% set colName = field.handle ~ "[" ~ rowIndex ~ "][" ~ index ~ "]" %}
                        {% set colValue = row[index]|default("") %}
                        {% set colType = column.type|default("text") %}
                        {% set colClass = "" %}
                        {% if colType == "text" or colType == "textarea" or colType == "number" %}
                            {% set colClass = "textual table-cell-" ~ colType %}
                        {% elseif colType == "select" %}
                            {% set colClass = "thin table-cell-select" %}
                        {% else %}
                            {% set colClass = "table-cell-" ~ colType %}
                        {% endif %}
                        <td class="{{ colClass }}">
                            {% switch colType %}
                            {% case "select" %}
                                <div class="select small">
                                    <select name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                            data-default-value="{{ column.value|default("") }}"
                                    >
                                        {% for option in column.options %}
                                            <option value="{{ option }}"{{ option == colValue ? " selected" }}>
                                                {{ option }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% case "radio" %}
                                <div class="freeform-cp-table-options" role="radiogroup" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}">
                                    {% for option in column.options %}
                                        {% set choiceId = 'labeled-' ~ field.handle ~ '-' ~ rowIndex ~ '-' ~ index ~ '-' ~ loop.index0 %}
                                        <div>
                                            <input type="radio" class="radio" id="{{ choiceId }}" name="{{ colName }}" value="{{ option }}" {{ colValue == option ? 'checked="checked"' }} />
                                            <label for="{{ choiceId }}">{{ option }}</label>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% case "checkbox" %}
                                {% set choiceId = 'labeled-' ~ field.handle ~ '-' ~ rowIndex ~ '-' ~ index ~ '-0' %}
                                <div class="checkbox-wrapper">
                                    <input type="checkbox" class="checkbox" id="{{ choiceId }}"
                                           name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                           data-default-value="{{ column.value|default("Yes") }}"
                                           value="{{ column.value|default("Yes") }}"
                                            {{ colValue ? "checked" }}
                                    />
                                    <label for="{{ choiceId }}"><span class="visually-hidden">{{ column.label|default('') }}</span></label>
                                </div>
                            {% case "file" %}
                                {% set metadata = column.metadata|default({}) %}
                                {% set fileCount = metadata.fileCount|default(1) %}
                                {% set fileInputName = colName %}
                                {% if fileCount > 1 %}
                                    {% set fileInputName = colName ~ "[]" %}
                                {% endif %}

                                {% set assetIds = [] %}
                                {% if colValue is iterable %}
                                    {% set assetIds = colValue %}
                                {% elseif colValue %}
                                    {% set assetIds = [colValue] %}
                                {% endif %}

                                {% if assetIds is not empty %}
                                    <div class="file-preview elements chips chips-small">
                                        {% for assetId in assetIds %}
                                            {% set asset = craft.app.assets.getAssetById(assetId) %}
                                            {% if asset %}
                                                {% set thumbSizes = [30, 60, 100, 200] %}
                                                {% set srcset = "" %}
                                                {%- if asset.kind == 'image' -%}
                                                    {%- for size in thumbSizes -%}
                                                        {% set thumbTransform = { width: size, height: size } %}
                                                        {% set srcset = srcset ~ ", " ~ asset.getUrl(thumbTransform) ~ " " ~ size ~ "w" %}
                                                    {%- endfor -%}
                                                    {% set srcset = srcset|trim(", ") %}
                                                {%- else -%}
                                                    {% set srcset = craft.app.assets.thumbUrl(asset, 200, 200) %}
                                                {%- endif -%}

                                                <div class="element small removable hasthumb chip" style="padding-right: 20px;">
                                                    <input type="hidden" name="{{ fileInputName }}"
                                                           value="{{ asset.id }}">
                                                    <a href="javascript:;" onclick="removeAsset(this);" class="icon delete"></a>
                                                    <div class="elementthumb thumb">
                                                        <img sizes="30px" srcset="{{ srcset }}" alt="">
                                                    </div>
                                                    <label class="chip-content">
                                                        <a href="javascript:;" data-asset-id="{{ asset.id }}">
                                                            {{ asset.title }}
                                                        </a>
                                                    </label>
                                                </div>
                                            {% elseif assetId %}
                                                <span class="chip">
                                                    {{ "Missing asset #{id}"|t('freeform', { id: assetId }) }}
                                                </span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                <input type="file" name="{{ fileInputName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"{% if fileCount > 1 %} multiple{% endif %} />
                            {% case "number" %}
                                {% set metadata = column.metadata|default({}) %}
                                {% set minMaxValues = metadata.minMaxValues|default([null, null]) %}
                                <input type="number"
                                       class="text fullwidth"
                                       name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                       value="{{ colValue }}"
                                       data-default-value="{{ column.value|default("") }}"
                                       placeholder="{{ column.placeholder|default("") }}"
                                       {% if minMaxValues[0] is not null %}min="{{ minMaxValues[0] }}"{% endif %}
                                       {% if minMaxValues[1] is not null %}max="{{ minMaxValues[1] }}"{% endif %}
                                       step="{{ metadata.step is defined and metadata.step is not null ? metadata.step : 1 }}"
                                />
                            {% case "textarea" %}
                                <textarea class="text fullwidth"
                                          name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                          data-default-value="{{ column.value|default("") }}"
                                          rows="2"
                                >
                                    {{- colValue -}}
                                </textarea>
                            {% default %}
                                <input type="text"
                                       class="text fullwidth"
                                       name="{{ colName }}" aria-labelledby="submission-table-{{ field.handle }}-heading-{{ index }}"
                                       value="{{ colValue }}"
                                       data-default-value="{{ column.value|default("") }}"
                                       placeholder="{{ column.placeholder|default("") }}"
                                />
                            {% endswitch %}
                        </td>
                    {% endfor %}
                    <td class="thin action">
                        <button type="button" class="delete icon"
                           data-freeform-table-remove-row
                           title="{{ 'Remove row'|t('freeform') }}" aria-label="{{ 'Remove row'|t('freeform') }}"></button>
                    </td>
                </tr>
            {% endfor %}
        {% endif %}
        </tbody>
    </table>
    </div>
    <div class="buttons freeform-cp-table-buttons">
        <button type="button" class="btn add icon dashed" data-freeform-table-add-row>{{ "Add a row"|t('freeform') }}</button>
    </div>
</div>
