{% extends "freeform/export/_layout" %}
{% hook "freeform.prepareCpTemplate" %}

{% set title = "Export Profiles"|t('freeform') %}

{% block contextMenu %}{% endblock %}

{% block actionButton %}

    {% if freeform.edition.atLeast('lite') and currentUser.can("freeform-pro-exportProfilesManage") %}

        <div class="buttons">
            {% if forms|length %}
                {% if forms|length > 1 %}
                    <craft-button type="button" variant="primary" icon="plus" class="menubtn action-btn ff-export-create" aria-label="{{ 'New Export Profile'|t('freeform') }}">{{ "New Export Profile"|t('freeform') }}<craft-icon name="chevron-down" slot="suffix"></craft-icon></craft-button>
                    <div class="menu">
                        <ul>
                            {% for form in forms %}
                                <li>
                                    <a href="{{ url('freeform/export/profiles/new/'~form.handle) }}">
                                        {% if form.color %}
                                            <span class="color-indicator" style="background-color: {{ form.color }};"></span>
                                        {% endif %}
                                        {{ form.name|t }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% else %}
                    <craft-button variant="primary" icon="plus" href="{{ url('freeform/export/profiles/new/'~(forms|first).handle|default) }}">
                        {{ "New Export Profile for {form}"|t({form: (forms|first).name}) }}
                    </craft-button>
                {% endif %}
            {% endif %}
        </div>

    {% endif %}

{% endblock %}

{% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\ExportIndexBundle') %}

{% set content %}

    {% if exportProfiles|length %}
        <div class="tablepane ff-export-tablepane">
        <table id="export-profiles" class="cp-table cp-table--spacious ff-export-table ff-export-profiles">
            <thead><tr>
            <th scope="col" class="ff-export-name-column">{{ "Name"|t('app') }}</th>
            <th scope="col">{{ "Form"|t('freeform') }}</th>
            <th scope="col" class="ff-export-count-column">{{ "Submissions"|t('freeform') }}</th>
            <th scope="col" class="ff-export-download-column">{{ "Actions"|t('app') }}</th>
            <th scope="col" class="ff-export-actions-column"><span class="visually-hidden">{{ "Delete"|t('freeform') }}</span></th>
            </tr></thead>
            <tbody>
            {% for profile in exportProfiles %}
                <tr data-id="{{ profile.id }}" data-name="{{ profile.name|t }}">
                    <th scope="row" class="ff-export-name-cell">
                        <div class="ff-export-heading">
                        {% if currentUser.can("freeform-pro-exportProfilesManage") %}
                            <a href="{{ url('freeform/export/profiles/' ~ profile.id) }}">
                                {{ profile.name }}
                            </a>
                        {% else %}
                            {{ profile.name }}
                        {% endif %}
                            <span class="ff-export-id">#{{ profile.id }}</span>
                        </div>
                    </th>
                    <td data-title="{{ 'Form'|t('freeform') }}">
                        {% set form = profile.form %}
                        {% if form %}
                            {% set canManage = currentUser.can("freeform-formsManage") or currentUser.can("freeform-formsManage:"~form.id) %}
                            {% if canManage %}
                                <a href="{{ url('freeform/forms/' ~ form.id) }}">
                                    {{ form.name }}
                                </a>
                            {% else %}
                                {{ form.name }}
                            {% endif %}
                        {% endif %}
                    </td>
                    <td data-title="{{ 'Submissions'|t('freeform') }}">
                        <span class="ff-export-badge ff-export-count">
                        {% if profile.limit > 0 and profile.submissionCount > profile.limit %}
                            {{ profile.limit }}
                        {% else %}
                            {{ profile.submissionCount }}
                        {% endif %}
                        </span>
                    </td>
                    <td class="ff-export-download-cell" data-title="{{ 'Actions'|t('app') }}">
                        <div class="file-download-list" role="group" aria-label="{{ profile.name }}">
                            {% for type, exporter in craft.freeformServices.exportProfiles.getAllowedExporterTypes(profile) %}
                                <craft-button type="button" data-type="{{ type }}" variant="fill" size="medium">{% include 'freeform/export/_file-type-icon' with {type: type, slot: 'prefix'} only %}{{ exporter }}</craft-button>
                            {% endfor %}
                        </div>
                        <form method="post" style="position: absolute; left:-9999px; top: -9999px;">
                            {{ csrfInput() }}
                            <input type="hidden" name="type" value="csv" />
                            <input type="hidden" name="profileId" value="{{ profile.id }}" />
                            <input type="hidden" name="action" value="freeform/export/profiles/export" />
                        </form>
                    </td>
                    <td class="ff-export-actions-cell">
                        {% if currentUser.can("freeform-pro-exportProfilesManage") %}
                            <button type="button" class="delete ff-export-delete" aria-label="{{ 'Delete'|t('freeform') }}: {{ profile.name }}" title="{{ 'Delete'|t('freeform') }}">
                                {% include 'freeform/export/_delete-icon' %}
                            </button>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
    {% if freeform.edition.atLeast('lite') %}
        <div id="noexport-profiles"{% if exportProfiles|length %} class="hidden"{% endif %}>
            {% embed "freeform/_components/empty-state" with {
                title: 'Create your first export profile'|t('freeform'),
                description: forms|length
                    ? 'Save a reusable export setup for a form. Choose the submissions, fields, and file format, then download the results whenever you need them.'|t('freeform')
                    : 'Create a form first, then save a reusable export setup with your preferred submissions, fields, and file format.'|t('freeform'),
                primaryAction: forms|length and currentUser.can('freeform-pro-exportProfilesManage') ? {label: 'Create export profile'|t('freeform')} : null,
                secondaryAction: {label: 'View documentation'|t('freeform'), href: 'https://docs.solspace.com/craft/freeform/v5/submissions/exporting/#export-profiles', newTab: true}
            } %}
                {% block icon %}
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M16 4v16m-6-6 6 6 6-6M6 22v5h20v-5"/></svg>
                {% endblock %}
                {% block primaryAction %}
                    {% if primaryAction %}
                        {% if forms|length > 1 %}
                            <div>
                                <button type="button" class="btn submit menubtn">{{ primaryAction.label }}</button>
                                <div class="menu"><ul>
                                    {% for form in forms %}<li><a href="{{ url('freeform/export/profiles/new/' ~ form.handle) }}">{{ form.name }}</a></li>{% endfor %}
                                </ul></div>
                            </div>
                        {% else %}
                            <a class="btn submit" href="{{ url('freeform/export/profiles/new/' ~ (forms|first).handle) }}">{{ primaryAction.label }}</a>
                        {% endif %}
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    {% elseif not exportProfiles|length %}
        <div class="zilch">{{ "Upgrade to the Lite or Pro edition of Freeform to get access to Export Profiles."|t('freeform') }}</div>
    {% endif %}
{% endset %}

{% js %}
    var adminTable = new Craft.AdminTable({
    tableSelector: '#export-profiles',
    noObjectsSelector: '#noexport-profiles',
    noItemsSelector: '#noexport-profiles',
    newObjectBtnSelector: '#newprofilecontainer',
    deleteAction: Craft.getCpUrl('freeform/export/profiles/delete'),
    confirmDeleteMessage: '{{ "Are you sure you want to delete this profile?"|t }}'
    });

    $('.file-download-list > [data-type]').on({
        click: function() {
            var parent = $(this).closest(".file-download-list");
            var type = $(this).data('type');

            parent.next().find("input[name=type]").val(type);
            parent.next("form").submit();
        }
    });
{% endjs %}
