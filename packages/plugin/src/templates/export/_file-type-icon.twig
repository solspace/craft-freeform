{% set fileIcons = {excel: 'file-excel', csv: 'file-csv', json: 'file-code', xml: 'file-xml', text: 'file-lines'} %}
<span class="ff-export-file-icon ff-export-file-icon--{{ type }}" aria-hidden="true">
    {{ svg('@app/icons/solid/' ~ (fileIcons[type] ?? 'file') ~ '.svg')|attr({focusable: 'false'}) }}
</span>
