{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "../../",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "allowJs": true,
    "types": ["jquery", "grecaptcha"],
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "types/"
    ],
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@components/*": ["./src/components/*"],
      "types/*": ["./src/types/*"]
    }
  }
}
