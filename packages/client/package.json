{
  "name": "@ff/client",
  "version": "1.0.0",
  "description": "Freeform Client",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rm -rf ../plugin/src/Resources/js/client",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest --config ./config/vitest/vitest.config.ts",
    "test:coverage": "vitest --config ./config/vitest/vitest.config.ts --maxWorkers=4 --collect-coverage",
    "test:watch": "vitest --config ./config/vitest/vitest.config.ts --watch --maxWorkers=4"
  },
  "keywords": [
    "Freeform",
    "Craft CMS",
    "App"
  ],
  "author": "Solspace Inc.",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "config/**",
    "src/**/persistence.ts",
    "src/**/*.persistence.ts"
  ],
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@monaco-editor/react": "4.7.0",
    "@react-spring/web": "10.1.2",
    "@reduxjs/toolkit": "2.12.0",
    "@sindresorhus/transliterate": "2.3.1",
    "@tanstack/react-query": "5.101.4",
    "@tinymce/tinymce-react": "6.3.0",
    "@yaireo/tagify": "4.37.1",
    "axios": "1.19.0",
    "date-fns": "4.4.0",
    "dompurify": "3.4.13",
    "html-to-image": "1.11.13",
    "lodash": "4.18.1",
    "marked": "18.0.9",
    "react": "19.2.8",
    "react-datepicker": "9.1.0",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "3.5.0",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.2",
    "react-zoom-pan-pinch": "4.0.4",
    "recharts": "3.10.1",
    "redux": "5.0.1",
    "sortablejs": "1.15.7",
    "styled-components": "6.5.2",
    "tinymce": "8.8.2",
    "uuid": "14.0.1"
