{%- set demoPrefix = "%prefix%" -%}
{%- set demoRouteSegment = demoPrefix|split('/')|last -%}
{% set baseUrlSegments = 1 %}
{%- if craft.app.request.segment(baseUrlSegments) != demoRouteSegment -%}
    {%- if craft.app.request.segment(baseUrlSegments + 1) == demoRouteSegment -%}
        {%- set baseUrlSegments = baseUrlSegments + 1 -%}
    {%- elseif craft.app.request.segment(baseUrlSegments + 2) == demoRouteSegment -%}
        {%- set baseUrlSegments = baseUrlSegments + 2 -%}
    {%- elseif craft.app.request.segment(baseUrlSegments + 3) == demoRouteSegment -%}
        {%- set baseUrlSegments = baseUrlSegments + 3 -%}
    {%- endif -%}
{%- endif -%}
{%- set demoBaseUrl = siteUrl ~ demoPrefix -%}
{%- set assetBaseUrl = craft.app.request.hostInfo ~ craft.app.request.baseUrl ~ '/assets/' ~ demoPrefix -%}
{%- set demoRequestedArea = craft.app.request.segment(baseUrlSegments + 1) -%}
{# Keep old /custom links as aliases for Forms with the assigned template. #}
{%- set demoArea = demoRequestedArea == 'custom' ? 'forms' : demoRequestedArea -%}
{%- set pageTemplate = demoRequestedArea == 'custom' ? 'default' : craft.app.request.segment(baseUrlSegments + 2)|default('basic-light') -%}
{%- set pageTemplateFile = pageTemplate == 'default' ? null : pageTemplate ~ '/index.twig' -%}
{%- if demoArea == "submissions" -%}
    {%- set spamMode = craft.app.request.segment(baseUrlSegments + 2) != "delete" and (craft.app.request.segment(baseUrlSegments + 4) == "spam" or craft.app.request.segment(baseUrlSegments + 3) == "spam") -%}
{%- endif -%}
{%- if demoArea == "forms" -%}
    {%- set formHandle = craft.app.request.segment(baseUrlSegments + (demoRequestedArea == 'custom' ? 2 : 3)) -%}
{%- elseif demoArea == "submissions" and craft.app.request.segment(baseUrlSegments + 2) == "delete" -%}
    {%- set formHandle = craft.app.request.segment(baseUrlSegments + 3) -%}
    {%- set pageTemplateFile = null -%}
{%- elseif demoArea == "submissions" -%}
    {%- set formHandle = craft.app.request.segment(baseUrlSegments + 2) -%}
    {%- set pageTemplateFile = null -%}
{%- elseif demoArea == "extras" -%}
    {%- set formHandle = "" -%}
    {%- set pageTemplateFile = "basic-light/index.twig" -%}
{%- elseif demoArea is empty -%}
    {%- set formHandle = "" -%}
    {%- set pageTemplate = "basic-light" %}
{%- endif -%}
{%- if formHandle -%}
    {%- set form = freeform.form(formHandle, {
        formattingTemplate: pageTemplateFile,
    }) -%}
{%- endif -%}

{# Resolve the assigned template just as the renderer does: custom files take precedence.
   The route remains "default"; only bundled templates get known demo dependencies. #}
{%- set assignedTemplate = null -%}
{%- set customTemplate = null -%}
{%- set sampleTemplate = null -%}
{%- set assetTemplate = pageTemplate -%}
{%- if demoArea == 'forms' and pageTemplate == 'default' and form|default(null) -%}
    {%- set assignedTemplate = form.settings.general.formattingTemplate -%}
    {%- set customTemplate = assignedTemplate ? freeform.settingsService.customFormTemplates|filter(candidate => candidate.filePath ends with assignedTemplate)|first : null -%}
    {%- set sampleTemplate = assignedTemplate and not customTemplate ? freeform.settingsService.solspaceFormTemplates|filter(candidate => candidate.filePath ends with assignedTemplate)|first : null -%}
    {%- set assetTemplate = sampleTemplate ? sampleTemplate.fileName|split('/')|first : 'default' -%}
{%- endif -%}
{%- set colorMode = assetTemplate in ["basic-dark", "bootstrap-5-dark", "tailwind-3-dark", "tailwind-4-dark", "daisyui-5-dark", "conversational"] ? "dark" : "light" -%}

<!doctype html>
<html lang="en"
{%- if colorMode == "dark" %}
 data-theme="dark"
{%- endif -%}
{%- if assetTemplate == "bootstrap-5-dark" %} data-bs-theme="dark"{%- endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>{% block title %}{{ pageTitle ? "Freeform Demo | " ~ pageTitle : "Freeform Demo" }}{% endblock %}</title>
    {% if demoArea == "forms" and formHandle %}
        {% if assetTemplate in ["daisyui-5-light", "daisyui-5-dark"] %}
            <link href="https://cdn.jsdelivr.net/npm/daisyui@5.7.27" rel="stylesheet" type="text/css">
            <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
        {% endif %}
        {% if assetTemplate in ["bootstrap-5", "bootstrap-5-dark", "bootstrap-5-floating-labels"] %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        {% endif %}
        {% if assetTemplate == "foundation-6" %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/css/foundation.min.css" crossorigin="anonymous">
            <script src="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/js/foundation.min.js" crossorigin="anonymous"></script>
        {% endif %}
        {% if assetTemplate in ["tailwind-4-light", "tailwind-4-dark"] %}
            <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
        {% endif %}
    {% endif %}
    <link href="{{ assetBaseUrl }}/css/demo.css" rel="stylesheet">
    <script src="{{ assetBaseUrl }}/js/demo.js" defer></script>
    <link rel="apple-touch-icon" sizes="180x180" href="{{ assetBaseUrl }}/favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ assetBaseUrl }}/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ assetBaseUrl }}/favicon/favicon-16x16.png">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

{% block headerCss %}{% endblock %}

</head>
<body{% if spamMode is defined and spamMode == true %} class="freeform-spam-mode"{% endif %}>

    {% set forms = freeform.forms %}
    {% include "demo/_navigation" %}

    <main class="freeform-form-content" id="main-content">

{% block content %}{% endblock %}

    </main>

{% block footerJs %}{% endblock %}

{% if demoArea in ["forms", "extras"] %}
    <script>
        document.addEventListener('freeform-ready', (event) => {
            event.options.scrollOffset = -200;
        });
    </script>
{% endif %}

</body>
</html>
