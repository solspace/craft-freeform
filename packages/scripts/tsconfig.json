{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "es6",
    "moduleResolution": "node",
    "target": "es5",
    "lib": ["ES2016", "DOM"],
    "jsx": "react",
    "allowJs": true,
    "baseUrl": "./src",
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "types/"
    ],
    "paths": {
      "@lib/*": ["lib/*"],
      "@components/*": ["components/*"]
    }
  }
}
