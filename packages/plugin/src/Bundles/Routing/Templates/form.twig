<!doctype html>
<html lang="{{ craft.app.language|e('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ form.name }}</title>
    {# Only known bundled templates receive framework assets. Custom templates
       can have any name (including one that shadows a bundled template) and
       must provide their own assets. #}
    {% if not isCustomFormattingTemplate and formattingTemplate in ['bootstrap-5/index.twig', 'bootstrap-5-dark/index.twig', 'bootstrap-5-floating-labels/index.twig'] %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    {% elseif not isCustomFormattingTemplate and formattingTemplate == 'foundation-6/index.twig' %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/css/foundation.min.css" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/js/foundation.min.js" crossorigin="anonymous"></script>
    {% elseif not isCustomFormattingTemplate and formattingTemplate == 'daisyui-5-light/index.twig' %}
        {% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\FormattingTemplates\\DaisyUI5LightComponentsBundle') %}
    {% elseif not isCustomFormattingTemplate and formattingTemplate == 'daisyui-5-dark/index.twig' %}
        {% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\FormattingTemplates\\DaisyUI5DarkComponentsBundle') %}
    {% elseif not isCustomFormattingTemplate and formattingTemplate in ['tailwind-4-light/index.twig', 'tailwind-4-dark/index.twig'] %}
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
    {% elseif not isCustomFormattingTemplate and formattingTemplate in ['tailwind-3/index.twig', 'tailwind-3-dark/index.twig'] %}
        <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    {% endif %}
    <style>
        html { overflow: hidden; }
        body { margin: 0; }
    </style>
</head>
<body>
    <main id="freeform-embed-content" style="display: flow-root">
        {{ form.render() }}
    </main>
</body>
</html>
