{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../plugin/src/Resources/js/client/",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": [
      "config/@types",
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      "@config/*": ["client/config/*"],
      "@editor/*": ["client/src/app/pages/forms/edit/*"],
      "@components/*": ["client/src/app/components/*"],
      "@form-controls/*": ["client/src/app/components/form-controls/*"],
      "@ff-icons/*": ["client/src/assets/icons/*"],
      "@ff-client/*": ["client/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
