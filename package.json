{
  "name": "root",
  "workspaces": [
    "packages/client",
    "packages/scripts",
    "packages/styles"
  ],
  "engines": {
    "pnpm": ">=11"
  },
  "private": true,
  "description": "Freeform plugin for Craft CMS",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "concurrently": "10.0.3",
    "husky": "9.1.7",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "concurrently -n client,scripts,styles \"pnpm --filter @ff/client dev\" \"pnpm --filter @ff/scripts dev\" \"pnpm --filter @ff/styles dev\"",
    "client": "pnpm --filter @ff/client dev",
    "front-end": "concurrently -n scripts,styles \"pnpm --filter @ff/scripts dev\" \"pnpm --filter @ff/styles dev\"",
    "build": "pnpm -r --if-present build",
    "format": "biome check --write",
    "format:verify": "biome check",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "prepare": "husky"
  },
  "author": "Solspace, Inc.",
  "license": "ISC"
}
