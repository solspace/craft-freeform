{# name: FAQ #}
{# description: A practical FAQ section powered by a Twig list. #}
{% set questions = [
    { question: 'Are the dragons actually tiny?', answer: 'Pocket-sized, with full-sized opinions about snacks.' },
    { question: 'Is a helmet included?', answer: 'Yes. A fireproof scarf is a good idea, too.' },
    { question: 'Can I bring my own treasure?', answer: 'Of course. Please label it before boarding.' }
] %}
<section id="faq" style="padding: 2rem; border-radius: 1rem; background: #f5f3ff; color: #3b0764;">
    <h2 style="margin: 0 0 1rem;">🐉 Tiny Dragon FAQs</h2>
    {% for item in questions %}
        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #ddd6fe;">
            <strong>{{ item.question }}</strong>
            <p style="margin: .25rem 0 0;">{{ item.answer }}</p>
        </div>
    {% endfor %}
</section>
