{% import "_includes/forms" as forms %}

{{ forms.multiselectField({
    label: field.label,
    class: 'fullwidth',
    inputAttributes: field.enableSearch ? {
        'data-freeform-searchable': field.searchableConfig|json_encode,
    } : {},
    name: field.handle,
    id: field.handle,
    required: field.required,
    errors: submission.errors(field.handle),
    values: submission[field.handle] is not null ? submission[field.handle].value : [],
    options: field.options.toTwigArray,
}) }}
