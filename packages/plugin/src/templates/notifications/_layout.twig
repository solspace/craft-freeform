{% extends "freeform/_layouts/main" %}
{% hook "freeform.prepareCpTemplate" %}

{% set selectedSubnavItem = "notifications" %}

{% set title = title ?? "Email Notifications"|t('freeform') %}

{% block toolbar %}
    {% if showTemplateSearch ?? false %}
        {% include 'freeform/notifications/_search' only %}
    {% endif %}
{% endblock %}

{% block sidebar %}

    {% set segment = craft.app.request.segment(3) %}
    {% set settings = freeform.settings %}

    {% set items = [] %}
    {% if currentUser.can('freeform-notificationsAccess') %}
        {% if settings.emailTemplateMethod != 'form' %}
            {% set items = items|merge([{heading: 'Templates'|t('freeform')}]) %}
            {% if settings.emailTemplateStorageType in ['files_database', 'files'] %}
                {% set items = items|merge([{
                    title: 'Files'|t('freeform'),
                    url: url('freeform/notifications/files'),
                    selected: segment == 'files',
                }]) %}
            {% endif %}
            {% if settings.emailTemplateStorageType in ['files_database', 'database'] %}
                {% set items = items|merge([{
                    title: 'Database'|t('freeform'),
                    url: url('freeform/notifications/database'),
                    selected: segment == 'database',
                }]) %}
            {% endif %}
        {% endif %}
        {% set items = items|merge([
            {heading: 'Layout'|t('freeform')},
            {
                title: 'Wrappers'|t('freeform'),
                url: url('freeform/notifications/wrappers'),
                selected: segment == 'wrappers',
            },
        ]) %}
    {% endif %}
    {% if craft.freeform.pro == 'pro' and currentUser.can('freeform-pdfTemplatesAccess') %}
        {% set items = items|merge([
            {heading: 'Attachments'|t('freeform')},
            {
                title: 'PDFs'|t('freeform'),
                url: url('freeform/notifications/pdf-templates'),
                selected: segment == 'pdf-templates',
            },
        ]) %}
    {% endif %}
    {% include 'freeform/_components/sidebar-navigation' with {items: items, scope: 'notifications'} only %}

{% endblock %}
