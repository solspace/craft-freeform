    <div class="source-item source-item--heading">
        <span class="type-heading-small">{{ heading }}</span>
        {% embed '_includes/disclosure-toggle' with {
            controls: controls,
            persist: true,
            storageKey: storageKey,
            attributes: {class: 'source-item__toggle'},
        } %}
            {% block content %}
                <span class="cp-icon puny">{{ iconSvg('angle-down') }}</span>
                <span class="visually-hidden">{{ 'Expand {heading} sources'|t('app', {heading: heading}) }}</span>
            {% endblock %}
        {% endembed %}
    </div>
