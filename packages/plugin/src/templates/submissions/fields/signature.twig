{% set signatureField = submission[field.handle] %}
{% set selectedValue = signatureField is not null ? signatureField.value : '' %}
{% set imageDataUrl = signatureField is not null ? signatureField.imageDataUrl : null %}
<div class="field">
    <div class="heading">
        <label>{{ field.label }}</label>
    </div>
    <div class="signature-wrapper" data-signature-filename="signature-{{ submission.formId }}-{{ submission.id }}">
        <input type="hidden" name="{{ field.handle }}" value="{{ selectedValue }}" />
        {% if imageDataUrl %}
            <img src="{{ imageDataUrl }}"
                 data-freeform-signature-preview="detail"
                 class="signature-preview"
                 alt="{{ field.label }}"
                 decoding="async" />
            <div class="download-signature-links" role="group" aria-label="{{ 'Download signature'|t('freeform') }}">
                {% for type, label in {png: 'PNG', jpg: 'JPG'} %}
                    <button type="button" class="btn signature-download" data-signature-download="{{ type }}">
                        <span class="signature-download-icon" data-icon="download" aria-hidden="true"></span>
                        <span>{{ 'Download {type}'|t('freeform', {type: label}) }}</span>
                    </button>
                {% endfor %}
            </div>
        {% else %}
            <p class="light">{{ 'No signature available.'|t('freeform') }}</p>
        {% endif %}
    </div>
</div>
