{% set clipHorizontalOverflow = not isCustomFormattingTemplate and formattingTemplate in ['tailwind-4-light/index.twig', 'tailwind-4-dark/index.twig'] %}
<!doctype html>
<html lang="{{ craft.app.language|e('html_attr') }}"{% if not isCustomFormattingTemplate and formattingTemplate == 'bootstrap-5-dark/index.twig' %} data-bs-theme="dark"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ form.name }}</title>
    {% include 'freeform-embed/framework-assets' %}
    {% for url in cssUrls %}
        <link rel="stylesheet" href="{{ url|e('html_attr') }}" crossorigin="anonymous">
    {% endfor %}
    <style>
        html { {% if clipHorizontalOverflow %}overflow-x: clip;{% endif %} {% if isDark %}background: #1f2226; color-scheme: dark;{% endif %} }
        body { margin: 0; padding: 24px; min-height: 100vh; box-sizing: border-box; {% if clipHorizontalOverflow %}overflow-x: clip;{% endif %} {% if isDark %}background: #1f2226; color: #e5e7eb;{% endif %} }
        #freeform-preview-status { position: relative; display: flex; align-items: flex-start; gap: 10px; margin-bottom: 20px; padding: 12px 16px; border: 1px solid #bfdbfe; border-radius: 8px; background: #eff6ff; color: #1e3a8a; font: 14px/1.5 system-ui, sans-serif; box-shadow: none; scroll-margin-top: 16px; animation: freeform-preview-notice-in .22s ease-out; }
        #freeform-preview-status[hidden] { display: none; }
        #freeform-preview-status > svg { flex: none; width: 20px; height: 20px; margin-top: 1px; color: #2563eb; }
        {% if isDark %}
        #freeform-preview-status { border-color: #365b85; background: #172b46; color: #dbeafe; }
        #freeform-preview-status > svg { color: #93c5fd; }
        {% endif %}
        #freeform-preview-status:focus, #freeform-preview-status:focus-visible { outline: none; box-shadow: none; }
        @keyframes freeform-preview-notice-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
        @media (prefers-reduced-motion: reduce) { #freeform-preview-status { animation: none; } }
    </style>
    <script id="freeform-preview-config" type="application/json">{{ previewConfigJson|raw }}</script>
    <script>{{ previewScript|raw }}</script>
    {{ head() }}
</head>
<body{% if isDark %} style="background-color: #1f2226; color: #e5e7eb"{% endif %}>
    {{ beginBody() }}
    <div id="freeform-preview-status" role="status" tabindex="-1" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v6M12 7v.1" stroke-linecap="round" />
        </svg>
        <span>{{ (form.pages|length > 1 ? 'Submissions are disabled in Preview. Choose another page using the page selector.' : 'Submissions are disabled in Preview.')|t('freeform') }}</span>
    </div>
    <main>{{ formMarkup }}</main>
    {% for url in jsUrls %}
        <script src="{{ url|e('html_attr') }}" crossorigin="anonymous"></script>
    {% endfor %}
    {{ endBody() }}
</body>
</html>
