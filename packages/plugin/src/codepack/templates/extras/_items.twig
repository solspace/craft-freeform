{% if mode == 'header' %}
    {% set example = examples|filter(item => item.handle == exampleHandle)|first %}
    {% include "demo/extras/_example-header.twig" %}
{% elseif mode == 'browser' %}
    {% include "demo/extras/_browser.twig" %}
{% elseif mode == 'navigation' %}
    {% for example in examples %}
        <a href="{{ demoBaseUrl }}/extras/{{ example.handle }}"{% if craft.app.request.segment(baseUrlSegments + 2) == example.handle %} class="active" aria-current="page"{% endif %}>{{ example.title }}</a>
    {% endfor %}
{% endif %}
