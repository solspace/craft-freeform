    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.3",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.12.0",
    "react-spring": "^10.0.3",
    "react-tippy": "^1.4.0",
    "react-zoom-pan-pinch": "^3.7.0",
