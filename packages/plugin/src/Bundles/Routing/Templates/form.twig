<!doctype html>
<html lang="{{ craft.app.language|e('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ form.name }}</title>
    {# The built-in formatting templates use framework classes. A standalone
       page needs the corresponding framework CSS, just like the demo pages. #}
    {% if formattingTemplate starts with 'bootstrap-5/' %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    {% elseif formattingTemplate starts with 'foundation-6/' %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/css/foundation.min.css" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/js/foundation.min.js" crossorigin="anonymous"></script>
    {% elseif formattingTemplate starts with 'tailwind-4-' %}
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
    {% elseif formattingTemplate starts with 'tailwind-3' %}
        <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    {% endif %}
    <style>
        html { overflow: hidden; }
        body { margin: 0; }
    </style>
</head>
<body>
    <main id="freeform-embed-content" style="display: flow-root">
        {{ form.render() }}
    </main>
</body>
</html>
