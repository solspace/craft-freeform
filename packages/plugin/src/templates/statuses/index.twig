{% extends "freeform/_layouts/settings" %}
{% hook "freeform.prepareCpTemplate" %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
] %}

{% set selectedSubnavItem = "statuses" %}
{% set fullPageForm = false %}

{% block actionButton %}

    {% if not readOnly and currentUser.can("freeform-settingsAccess") %}
        <a id="newstatuscontainer" class="btn submit add icon" href="{{ url('freeform/settings/statuses/new/') }}">
            {{ "New Status"|t('freeform') }}
        </a>
    {% endif %}

{% endblock %}

{% set title = "Statuses"|t('freeform') %}

{% block content %}

    {{ parent() }}

    {% if statuses|length %}
        <table id="statuses" class="data fullwidth collapsible cp-table cp-table--spacious freeform-settings-table">
            <thead><tr>
            <th scope="col">{{ "Name"|t('freeform') }}</th>
            <th scope="col">{{ "Handle"|t('freeform') }}</th>
            <th scope="col">{{ "Default"|t('freeform') }}</th>
            {% if not readOnly %}
                <th class="thin"></th>
                <th class="thin"></th>
            {% endif %}
            </tr></thead>
            <tbody>
            {% for status in statuses %}
                <tr data-id="{{ status.id }}" data-name="{{ status.name|t('freeform') }}">
                    <th scope="row" data-title="{{ 'Name'|t('freeform') }}">
                        <span class="ff-status-name">
                        <craft-indicator fill="{{ status.color }}" appearance="solid" aria-hidden="true"></craft-indicator>
                        {% if not readOnly and currentUser.can("freeform-settingsAccess") %}
                            <a href="{{ url('freeform/settings/statuses/' ~ status.id) }}">
                                {{ status.name }}
                            </a>
                        {% else %}
                            {{ status.name }}
                            {% endif %}
                        </span>
                        </th>
                        <td data-title="{{ 'Handle'|t('freeform') }}">
                            <code>
                                {{ status.handle }}
                            </code>
                        </td>
                        <td class="thin centeralign" data-title="{{ 'Default'|t('freeform') }}">{% if status.id == defaultStatusId %}<span data-icon="check" aria-label="{{ 'Yes'|t('app') }}"></span>{% endif %}</td>
                        {% if not readOnly %}
                            <td class="thin">
                                {% if currentUser.can("freeform-settingsAccess") and (statuses|length) > 1 %}
                                    <a class="move icon" title="{{ 'Reorder'|t('freeform') }}" aria-label="{{ 'Reorder'|t('freeform') }}" role="button"></a>
                                {% endif %}
                            </td>
                            <td class="thin">
                                {% if currentUser.can("freeform-settingsAccess") and status.id != defaultStatusId and (statuses|length) > 1 %}
                                    <a class="delete icon" title="{{ 'Delete'|t('freeform') }}" aria-label="{{ 'Delete'|t('freeform') }}" role="button" tabindex="0"></a>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        {{ ui('empty', {label: "No statuses exist yet."|t('freeform')}) }}
    {% endif %}
{% endblock %}

{% js %}
    var adminTable = new Craft.AdminTable({
        tableSelector: '#statuses',
        noObjectsSelector: '#nostatuses',
        newObjectBtnSelector: '#newstatuscontainer',
        deleteAction: 'freeform/statuses/delete',
        confirmDeleteMessage: '{{ "Are you sure you want to delete this status?"|t('freeform') }}',
        sortable: true,
        reorderAction: 'freeform/statuses/reorder',
        reorderSuccessMessage: '{{ "Success"|t('freeform') }}',
        reorderFailMessage:    '{{ "Failed"|t('freeform') }}',
    });
{% endjs %}
