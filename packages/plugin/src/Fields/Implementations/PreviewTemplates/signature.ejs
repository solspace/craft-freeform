<%
    const configuredWidth = typeof width === 'undefined' ? 400 : Number(width);
    const configuredHeight = typeof height === 'undefined' ? 100 : Number(height);
    const padWidth = Number.isFinite(configuredWidth) && configuredWidth > 0 ? configuredWidth : 400;
    const padHeight = Number.isFinite(configuredHeight) && configuredHeight > 0 ? configuredHeight : 100;
    const customAppearance = typeof customizeAppearance === 'undefined' || customizeAppearance !== false;
    const previewPenColor = customAppearance ? penColor : '#000000';
    const previewBackground = customAppearance ? backgroundColor : 'var(--white, #fff)';
    const clearLabel =
        (typeof Craft !== 'undefined' && Craft.t)
            ? Craft.t('freeform', 'Clear')
            : 'Clear';
%>
<div class="ff-signature-preview" style="max-width: <%- padWidth * 1.25 %>px;">
    <div class="ff-signature-preview__pad" style="
        aspect-ratio: <%- padWidth %> / <%- padHeight %>;
        <% if (customAppearance) { %>--ff-signature-preview-border: <%- borderColor %>;<% } %>
        background-color: <%- previewBackground %>;
    ">
        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 480 140"
             preserveAspectRatio="xMidYMid meet"
             aria-hidden="true"
             focusable="false">
            <path d="M58 93 C72 80 100 52 104 38 C108 23 94 30 87 46
                     C79 66 78 102 91 95 C103 88 111 64 110 67
                     C105 83 102 97 110 94 L126 78 C117 96 124 96 134 86
                     C148 71 147 83 139 93 C151 84 156 80 154 88
                     C151 99 163 90 173 84 C187 76 185 88 175 93
                     C166 96 169 83 185 83 C196 83 202 89 214 83
                     M190 94 C216 68 240 43 252 32 C265 21 266 34 254 48
                     C239 66 213 105 226 98 C242 89 252 70 250 73
                     C238 96 244 97 260 83 C273 71 261 94 268 92
                     L284 81 C277 96 282 96 295 85 C308 75 301 93 309 90
                     C327 81 321 80 317 90 C329 92 339 82 348 85
                     C360 90 370 88 386 84 M115 109 C179 99 283 106 363 100
                     C383 98 395 97 407 99"
                  fill="none"
                  stroke="<%- previewPenColor %>"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round" />
        </svg>
    </div>
    <% if (showClearButton) { %>
        <button type="button" class="ff-signature-preview__clear" tabindex="-1"><%- clearLabel %></button>
    <% } %>
</div>
