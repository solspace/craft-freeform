{% extends "freeform/notifications/_layout" %}
{% import "_includes/forms" as forms %}

{% set selectedSubnavItem = "notifications" %}
{% set saveShortcutRedirect = 'freeform/notifications/pdf-templates/{id}' %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "PDF Templates"|t("freeform"), url: url("freeform/notifications/pdf-templates") },
    { label: title, url: url("freeform/notifications/pdf-templates/" ~ (template.getAttribute('id') ?: 'new') ) },
] %}

{% set fullPageForm = true %}

{% set additionalButtons %}
    {% if previewForms|length %}
        {{ ui('button', {
            id: 'pdf-preview-open',
            type: 'button',
            variant: 'outline',
            label: 'Preview PDF'|t('freeform'),
        }) }}
    {% endif %}
{% endset %}

{% set formActions = [
    {
        label: 'Save and continue editing'|t('app'),
        redirect: saveShortcutRedirect|hash,
        shortcut: true,
        retainScroll: true,
    },
    {
        label: 'Save and add another'|t('app'),
        redirect: cpUrl('freeform/notifications/pdf-templates/new')|hash,
    },
] %}

{% block content %}

    <input type="hidden" name="action" value="freeform/pdf/pdf-templates/save">
    <input type="hidden" name="id" value="{{ template.getAttribute('id') }}" />
    {{ redirectInput('freeform/notifications/pdf-templates') }}
    {{ csrfInput() }}

    {{ forms.textField({
        first: true,
        label: "Name"|t('freeform'),
        instructions: "What this template will be called in the control panel."|t('freeform'),
        id: 'name',
        name: 'name',
        value: template.getAttribute('name'),
        errors: template.getErrors('name'),
        autofocus: true,
        required: true
    }) }}

    {{ forms.textareaField({
        label: "Description"|t('freeform'),
        instructions: "Description of this template."|t('freeform'),
        id: 'description',
        name: 'description',
        value: template.getAttribute('description'),
        errors: template.getErrors('description'),
        required: false
    }) }}

    <hr>

    {{ forms.autosuggestField({
        first: true,
        label: "File Name"|t('freeform'),
        instructions: "The name of the PDF file when it's generated. Can use Twig variables."|t('freeform'),
        id: 'fileName',
        name: 'fileName',
        placeholder: "e.g. tickets-{{ form.handle }}-event-{{ firstName }}-{{ lastName }}",
        value: template.getAttribute('fileName'),
        errors: template.getErrors('fileName'),
        required: true
    }) }}

    {{ forms.textareaField({
        label: "PDF Body (HTML)"|t('freeform'),
        instructions: "The HTML content of the PDF file. See documentation for availability of variables."|t('freeform'),
        id: "body",
        name: "body",
        value: template.getAttribute('body'),
        errors: template.getErrors("body"),
        required: false,
    }) }}

    <style>
        .content-footer:has(#pdf-preview-open) > .flex > .flex-1 {
            display: none;
        }

        #editor {
            display: none;
            overflow: hidden;

            width: 100%;
            height: 400px;
            margin-top: -20px;

            border-radius: 3px;
            border: 1px solid #e0e5ea;
        }

        .ace_gutter-layer, .ace_gutter-cell {
            background: var(--secondary-pane-bg, #f4f7fc);
        }

        #editor:not(.ace_focus) .ace_active-line {
            background: var(--ui-control-bg-color, #f4f7fc) !important;
        }

        #body {
            display: none;
        }
    </style>
    <div id="editor">{{ template.getAttribute('body') }}</div>

    {% if previewForms|length %}
        {% include 'freeform/pdf-templates/_preview' %}
    {% endif %}

{% endblock %}

{% js %}
    var editor = ace.edit("editor");
    editor.setTheme("ace/theme/github");
    var textarea = $('textarea[name="body"]').hide();

    editor.getSession().setValue(textarea.val());
    editor.getSession().on('change', function() {
        textarea.val(editor.getSession().getValue());
    });

    editor.getSession().setUseWorker(false);
    editor.getSession().setMode("ace/mode/html");

    document.getElementById("editor").style.display = "block";
{% endjs %}
