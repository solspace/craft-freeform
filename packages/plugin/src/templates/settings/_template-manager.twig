{% extends "freeform/_layouts/settings" %}

{% import "_includes/forms" as forms %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
] %}

{% set title = "Template Manager"|t("freeform") %}

{% macro listFiles(files) %}
    {% if files|length %}
        <ul class="ff-template-file-list">
            {% for file in files %}
                {% set name = file.name is defined ? file.name : file %}
                {% set fileName = file.fileName is defined ? file.fileName : file %}
                <li>
                    <span class="ff-template-file-name">{{ name }}</span>
                    {% if fileName != name %}<code>{{ fileName }}</code>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="ff-template-empty">{{ "No Twig files found in this directory yet."|t('freeform') }}</p>
    {% endif %}
{% endmacro %}

{% block content %}

    {{ parent() }}

    <input type="hidden" name="action" value="freeform/settings/save-settings">
    {{ redirectInput('freeform/settings/template-manager') }}
    {{ csrfInput() }}

    <div class="ff-template-manager">

    <h2 class="first">{{ "Formatting Templates"|t('freeform') }}</h2>

    {% set suggestionsData = [] %}
    {% for directory in craft.freeform.getAllSiteTemplatesDirectories() %}
        {% set suggestionsData = suggestionsData|merge([{
            "name": directory
        }]) %}
    {% endfor %}

    {{ forms.autosuggestField({
        label: "Directory Path"|t('freeform'),
        id: "formTemplateDirectory",
        class: "code",
        disabled: readOnly,
        suggestEnvVars: false,
        suggestAliases: false,
        suggestions:[{
            "label":"Existing Directories",
            "data": suggestionsData
        }],
        tip: null,
        limit: 10,
        name: "settings[formTemplateDirectory]",
        value: settings.formTemplateDirectory,
        errors: settings.getErrors("formTemplateDirectory"),
        instructions: "Choose an existing directory inside Craft's templates folder. Twig files here control form markup."|t('freeform'),
        placeholder: "e.g. _freeform/formatting",
    }) }}

    {% if settings.absoluteFormTemplateDirectory %}
        {% set formattingFiles = freeform.plugin.settings.customFormTemplates %}
        <div class="ff-template-directory-preview">
            <div class="ff-template-directory-header">
                <div class="ff-template-directory-title">
                    <strong>{{ settings.formTemplateDirectory }}</strong>
                    <span class="ff-template-file-count">{{ formattingFiles|length }} {{ "files"|t('freeform') }}</span>
                </div>
                <div class="btn-group">
                    {% if not readOnly %}
                        <button type="button" class="btn small icon add menubtn" id="add-formatting-template">
                            {{ "Clone a Sample Template"|t('freeform') }}
                        </button>
                    {% endif %}
                    <div class="menu" id="demo-template-list">
                        <ul>
                            {% for template in solspaceTemplates %}
                                <li>
                                    <a data-template="{{ template.fileName }}">{{ template.name }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
            {{ _self.listFiles(formattingFiles) }}
        </div>
    {% endif %}

    <hr />

    <h2>{{ "Success Templates"|t('freeform') }}</h2>

    {% set suggestionsData = [] %}
    {% for directory in craft.freeform.getAllSiteTemplatesDirectories() %}
        {% set suggestionsData = suggestionsData|merge([{
            "name": directory
        }]) %}
    {% endfor %}

    {{ forms.autosuggestField({
        label: "Directory Path"|t('freeform'),
        id: "successTemplateDirectory",
        class: "code",
        suggestEnvVars: false,
        suggestAliases: false,
        suggestions:[{
            "label":"Existing Directories",
            "data": suggestionsData
        }],
        tip: null,
        limit: 10,
        name: "settings[successTemplateDirectory]",
        value: settings.successTemplateDirectory,
        errors: settings.getErrors("successTemplateDirectory"),
        disabled: readOnly,
        instructions: "Choose an existing directory inside Craft's templates folder. Twig files here render success messages."|t('freeform'),
        placeholder: "e.g. _freeform/success",
    }) }}

    {% if settings.absoluteSuccessTemplateDirectory %}
        {% set successFiles = freeform.plugin.settings.successTemplates %}
        <div class="ff-template-directory-preview">
            <div class="ff-template-directory-header">
                <div class="ff-template-directory-title">
                    <strong>{{ settings.successTemplateDirectory }}</strong>
                    <span class="ff-template-file-count">{{ successFiles|length }} {{ "files"|t('freeform') }}</span>
                </div>
                {% if not readOnly %}
                    <div class="btn-group">
                        <button type="button" class="btn small icon add menubtn" id="add-success-template">
                            {{ "Add Sample"|t('freeform') }}
                        </button>
                        <div class="menu" id="success-sample-template-list">
                            <ul>
                                {% for id, sample in successTemplateSamples %}
                                    <li><a data-sample="{{ id }}">{{ sample.name|t('freeform') }}</a></li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </div>
            {{ _self.listFiles(successFiles) }}
        </div>
    {% endif %}

    <hr />

    <h2>{{ "Email Notification Templates"|t('freeform') }}</h2>

    {{ forms.selectField({
        label: "Template Method"|t('freeform'),
        id: 'template-method',
        instructions: "Choose whether you want to use form-specific templates, global templates, or both."|t('freeform'),
        name: "settings[emailTemplateMethod]",
        value: settings.emailTemplateMethod,
        errors: settings.errors("emailTemplateMethod"),
        disabled: readOnly,
        options: {
            "form": "Form-specific only" | t('freeform'),
            "global": "Global only" | t('freeform'),
            "all": "Form-specific & Global" | t('freeform'),
        },
    }) }}

    <div id="global-email-block" class="{{ settings.emailTemplateMethod == 'form' ? 'hidden' }}">
        {{ forms.selectField({
            label: "Template Storage Type"|t('freeform'),
            id: 'storage-type',
            instructions: "Choose whether you want to enable email notification templates stored as files, in the database, or have both options available."|t('freeform'),
            name: "settings[emailTemplateStorageType]",
            value: settings.emailTemplateStorageType,
            errors: settings.errors("emailTemplateStorageType"),
            disabled: readOnly,
            options: {
                "files": "File" | t('freeform'),
                "database": "Database" | t('freeform'),
                "files_database": "File & Database" | t('freeform'),
            },
        }) }}

        <div class="hidden">
            {{ forms.lightswitchField({
                id: "allow-builder-templates",
                label: "Allow New Templates to be created inside the Form Builder"|t("freeform"),
                instructions: "Choose whether to allow admins to create new email notification templates inside the form builder."|t("freeform"),
                name: "settings[allowBuilderTemplateCreation]",
                value: settings.allowBuilderTemplateCreation,
                errors: settings.errors("allowBuilderTemplateCreation"),
                disabled: readOnly,
                on: settings.allowBuilderTemplateCreation,
            }) }}


            {% set isBuilder = settings.allowBuilderTemplateCreation %}
            {% set isCombined = settings.emailTemplateStorageType == "files_database" %}
            <div id="template-default" class="field {{ isBuilder ? 'builder-templates' }} {{ isCombined ? 'combined' }} {{ not isBuilder or not isCombined ? "hidden" }}">
                {{ forms.selectField({
                    label: "New Template Type for Form Builder"|t('freeform'),
                    instructions: "Select which storage method to use when creating new email notifications from within in the form builder."|t('freeform'),
                    name: "settings[emailTemplateDefault]",
                    value: settings.emailTemplateDefault,
                    errors: settings.errors("emailTemplateDefault"),
                    disabled: readOnly,
                    options: {
                        "files": "File" | t('freeform'),
                        "database": "Database" | t('freeform'),
                    },
                }) }}
            </div>
        </div>

        <div id="files-directory" class="field {{ settings.emailTemplateStorageType not in ["files", "files_database"] ? "hidden" }}">

            {{ forms.lightswitchField({
                label: "Control Panel Management for File-based Email Templates"|t('freeform'),
                instructions: "Allows users to create and edit file-based email templates from the Notifications area and form builder."|t('freeform'),
                name: "settings[allowFileTemplateEdit]",
                on: settings.allowFileTemplateEdit,
                errors: settings.errors("allowFileTemplateEdit"),
                disabled: readOnly,
                tip: "Managing template files from inside the Control Panel may not be suitable for workflows that rely on external file management or version control."|t('freeform'),
            }) }}

            {% set suggestionsData = [] %}
            {% for directory in craft.freeform.getAllSiteTemplatesDirectories() %}
                {% set suggestionsData = suggestionsData|merge([{
                    "name": directory
                }]) %}
            {% endfor %}

            {{ forms.autosuggestField({
                label: "File Directory Path"|t('freeform'),
                id: "emailTemplateDirectory",
                class: "code",
                suggestEnvVars: false,
                suggestAliases: false,
                suggestions:[{
                    "label":"Existing Directories",
                    "data": suggestionsData
                }],
                tip: null,
                limit: 10,
                name: "settings[emailTemplateDirectory]",
                value: settings.emailTemplateDirectory,
                errors: settings.getErrors("emailTemplateDirectory"),
                disabled: readOnly,
                instructions: "Choose an existing directory inside Craft's templates folder. Twig files here power email notifications."|t('freeform'),
                placeholder: "e.g. _freeform/notifications",
            }) }}

            {% if settings.absoluteEmailTemplateDirectory %}
                {% set emailFiles = craft.freeform.settings.listTemplatesInEmailTemplateDirectory() %}
                <div class="ff-template-directory-preview">
                    <div class="ff-template-directory-header">
                        <div class="ff-template-directory-title">
                            <strong>{{ settings.emailTemplateDirectory }}</strong>
                            <span class="ff-template-file-count">{{ emailFiles|length }} {{ "files"|t('freeform') }}</span>
                        </div>
                        {% if not readOnly %}
                            <div class="btn-group">
                                <button type="button" class="btn small icon add menubtn" id="add-email-template">
                                    {{ "Add Sample"|t('freeform') }}
                                </button>
                                <div class="menu" id="email-sample-template-list">
                                    <ul>
                                        {% for id, sample in emailTemplateSamples %}
                                            <li><a data-sample="{{ id }}">{{ sample.name|t('freeform') }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    {{ _self.listFiles(emailFiles) }}
                </div>

            {% endif %}

        </div>
    </div>

    {{ forms.autosuggestField({
        label: "Default From Email for New Templates"|t('freeform'),
        id: "defaultFromEmail",
        class: "code",
        suggestEnvVars: true,
        suggestAliases: false,
        limit: 10,
        name: "settings[defaultFromEmail]",
        value: settings.defaultFromEmail,
        errors: settings.getErrors("defaultFromEmail"),
        disabled: readOnly,
        instructions: "The default email address to be included in the 'From Email' setting of new email notification templates."|t('freeform'),
    }) }}

    {{ forms.autosuggestField({
        label: "Default From Name for New Templates"|t('freeform'),
        id: "defaultFromName",
        class: "code",
        suggestEnvVars: true,
        suggestAliases: false,
        limit: 10,
        name: "settings[defaultFromName]",
        value: settings.defaultFromName,
        errors: settings.getErrors("defaultFromName"),
        disabled: readOnly,
        instructions: "The default name to be included in the 'From Email' setting of new email notification templates."|t('freeform'),
    }) }}

    {% if
        not readOnly
        and craft.freeform.notifications.databaseNotificationCount > 0
        and settings.emailTemplateStorageType in ['files', 'files_database']
        and settings.emailTemplateMethod != 'form'
    %}

        <div class="pane">

            <h2>{{ "Template Conversion Utility"|t('freeform') }}</h2>

            <div class="field" id="notifications-migrator">
                <div class="heading">
                    <label>
                        {{ 'Convert Database Email Templates to File-based Templates'|t('freeform') }}
                    </label>
                </div>
                <div class="instructions">
                    <p>
                        {{ 'This utility allows you to create file-based copies of your existing database email templates. Existing forms that use the selected database templates will automatically be updated to use the new file-based versions instead. File-based templates can still be managed from inside the Control Panel if enabled.'|t('freeform') }}
                    </p>
                </div>
                <div class="input">
                    <div style="margin-bottom: 10px;">
                        <input
                                type="checkbox"
                                class="checkbox"
                                name="removeFiles"
                                value="1"
                                id="remove-files"
                                checked
                        />
                        <label for="remove-files">
                            {{ "Remove original database email templates after conversion"|t('freeform') }}
                        </label>
                    </div>

                    <button class="btn" id="migrate">
                        {{ "Convert Templates"|t('freeform') }}
                    </button>
                </div>
            </div>

        </div>

    {% endif %}

    </div>

{% endblock %}

{% css %}
    .ff-template-manager #formTemplateDirectory,
    .ff-template-manager #successTemplateDirectory,
    .ff-template-manager #emailTemplateDirectory { max-width: 900px; }

    .ff-template-directory-preview {
        width: min(100%, 900px);
        margin: 14px 0 4px;
        border: 1px solid var(--hairline-color, #dce3eb);
        border-radius: 8px;
        background: var(--white, #fff);
    }
    .ff-template-directory-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 52px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--hairline-color, #dce3eb);
        border-radius: 8px 8px 0 0;
        background: var(--gray-050, #f7f9fc);
    }
    .ff-template-directory-title {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px 10px;
        min-width: 0;
        color: var(--text-color, #3f4d5a);
    }
    .ff-template-directory-title::before {
        content: "folder";
        font: 16px/1 Craft;
        color: var(--gray-500, #708095);
    }
    .ff-template-directory-title strong { overflow-wrap: anywhere; }
    .ff-template-file-count {
        padding: 2px 7px;
        border-radius: 999px;
        background: var(--gray-200, #e6edf4);
        color: var(--gray-600, #627182);
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }
    .ff-template-directory-header .btn-group { flex: 0 0 auto; }
    .ff-template-directory-header .btn { display: inline-flex; align-items: center; justify-content: center; }
    .ff-template-file-list { margin: 0; padding: 4px 0; list-style: none; }
    .ff-template-file-list li {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 36px;
        padding: 6px 14px;
    }
    .ff-template-file-list li + li { border-top: 1px solid var(--hairline-color, #edf0f4); }
    .ff-template-file-list li::before {
        content: "templates";
        flex: 0 0 16px;
        font: 15px/1 Craft;
        color: var(--gray-500, #708095);
    }
    .ff-template-file-name { min-width: 0; overflow-wrap: anywhere; }
    .ff-template-file-list code {
        margin-inline-start: auto;
        padding: 0;
        background: transparent;
        color: var(--gray-500, #8491a0);
        font-size: 11px;
        white-space: nowrap;
    }
    .ff-template-empty { margin: 0; padding: 14px; color: var(--gray-500, #708095); }
    @media (max-width: 700px) {
        .ff-template-directory-header { align-items: flex-start; flex-wrap: wrap; }
        .ff-template-file-list li { flex-wrap: wrap; }
        .ff-template-file-list code { width: 100%; margin-inline-start: 24px; white-space: normal; }
    }
{% endcss %}

{% js %}
    function addMessageTemplateSample(button, endpoint) {
        if (!$(button).length) return;
        new Garnish.MenuBtn($(button), {
            onOptionSelect: function(option) {
                var data = { sample: $(option).data('sample') };
                data["{{ craft.app.config.general.csrfTokenName }}"] = "{{ craft.app.request.csrfToken }}";
                $.ajax({
                    url: endpoint,
                    type: 'post',
                    dataType: 'json',
                    data: data,
                    success: function(response) {
                        if (!response.errors.length) {
                            window.location.reload();
                        } else {
                            response.errors.forEach(function(message) { Craft.cp.displayError(message); });
                        }
                    },
                    error: function() { Craft.cp.displayError({{ 'Could not add the sample template.'|t('freeform')|json_encode|raw }}); }
                });
            }
        });
    }

    addMessageTemplateSample('#add-email-template', "{{ url('freeform/settings/add-email-template') }}");
    addMessageTemplateSample('#add-success-template', "{{ url('freeform/settings/add-success-template') }}");
{% endjs %}
