{% extends "freeform/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
] %}

{% set title = "Demo Templates"|t('freeform') %}
{% set fullPageForm = false %}

{% macro listFiles(file) %}
    {% import _self as dir %}

    {% set isFolder = file.isFolder %}
    <li class="{{ isFolder ? 'dir' : 'file' }}">
        <span>{{ file.name }}</span>
        {% if isFolder %}
            <ul>
                {% for childFile in file.files %}
                    {{ dir.listFiles(childFile) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}
{% import _self as dir %}

{% block actionButton %}{% endblock %}

{% block content %}
    {{ parent() }}

    <div id="demo-installer" class="freeform-demo-installer">
        <div data-install-setup>
            <h2 class="first">{{ "Install demo templates"|t('freeform') }}</h2>
            <p class="light">{{ "Try your forms on the front end with ready-to-use examples you can explore and customize."|t('freeform') }}</p>

            <ul class="freeform-demo-summary">
                <li>
                    <span data-icon="templates" aria-hidden="true"></span>
                    <span><strong>{{ "Templates"|t('app') }}</strong><span class="light">{{ "{count} files"|t('freeform', {count: codePack.templates.contents.fileCount}) }}</span></span>
                </li>
                <li>
                    <span data-icon="folder" aria-hidden="true"></span>
                    <span><strong>{{ "Assets"|t('app') }}</strong><span class="light">{{ "{count} files"|t('freeform', {count: codePack.assets.contents.fileCount}) }}</span></span>
                </li>
                <li>
                    <span data-icon="routes" aria-hidden="true"></span>
                    <span><strong>{{ "Routes"|t('app') }}</strong><span class="light">{{ "{count} routes"|t('freeform', {count: codePack.routes.data|length}) }}</span></span>
                </li>
            </ul>

            <form method="post" id="demo-install-form" data-read-only="{{ readOnly ? 'true' : 'false' }}" data-checked-prefix="{{ prefix }}">
                <input type="hidden" name="action" value="freeform/codepack/install">
                {{ redirectInput('freeform/settings/demo-templates') }}
                {{ csrfInput() }}

                <div class="freeform-demo-install-row">
                    {{ forms.textField({
                        label: "Demo Folder"|t('freeform'),
                        instructions: "This folder name is used for both locations below."|t('freeform'),
                        id: 'prefix',
                        name: 'prefix',
                        value: prefix,
                        placeholder: 'freeform-demo',
                        disabled: readOnly,
                        required: true,
                    }) }}
                    <div class="freeform-demo-actions">
                        <button type="submit" class="btn submit{{ readOnly ? ' disabled' }}" {{ readOnly ? 'disabled' }}>{{ "Install demo templates"|t('freeform') }}</button>
                    </div>
                </div>
                <p id="demo-prefix-error" data-prefix-error class="error" hidden>{{ "Enter a folder name using letters, numbers, hyphens, underscores, or dots. Start with a letter or number."|t('freeform') }}</p>
                <div class="pane warning freeform-demo-note" data-existing-templates role="note" {{ not templatesExist ? 'hidden' }}>
                    <p><strong>{{ "Folder already exists."|t('freeform') }}</strong> {{ "Installing here may overwrite existing files. Choose a different folder or back up its contents first."|t('freeform') }}</p>
                </div>
                <div class="freeform-demo-check-status" role="status" aria-live="polite" hidden>
                    <span data-destination-status></span>
                    <button type="button" class="btn small" data-retry-destination hidden>{{ "Retry check"|t('freeform') }}</button>
                </div>
                {% include 'freeform/codepack/_destinations' %}
            </form>

            <div data-install-error class="freeform-demo-error error" role="alert" tabindex="-1" {{ exceptionMessage is not defined ? 'hidden' }}>{{ exceptionMessage ?? '' }}</div>

            <details class="freeform-demo-details">
                <summary>{{ "View files and routes"|t('freeform') }}</summary>
                <div id="components-wrapper">
                    <div>
                        <h3 class="freeform-demo-section-heading">
                            <span data-icon="templates" aria-hidden="true"></span>
                            <span>{{ "Templates"|t('app') }}</span>
                            <span class="freeform-demo-count">{{ codePack.templates.contents.fileCount }}</span>
                        </h3>
                        <div class="freeform-demo-file-preview" data-file-preview>
                            <div id="demo-template-files" class="freeform-demo-file-list">
                                <ul class="directory-structure">
                                    <li class="dir"><span data-name="/">{{ prefix }}/</span>
                                        <ul>{% for file in codePack.templates.contents %}{{ dir.listFiles(file) }}{% endfor %}</ul>
                                    </li>
                                </ul>
                            </div>
                            <button type="button" class="freeform-demo-view-files" data-view-files aria-controls="demo-template-files" aria-expanded="false" hidden>{{ "View all files"|t('freeform') }}</button>
                        </div>
                    </div>
                    <div>
                        <h3 class="freeform-demo-section-heading">
                            <span data-icon="folder" aria-hidden="true"></span>
                            <span>{{ "Assets"|t('app') }}</span>
                            <span class="freeform-demo-count">{{ codePack.assets.contents.fileCount }}</span>
                        </h3>
                        <ul class="directory-structure">
                            <li class="dir"><span data-name="/">{{ prefix }}/</span>
                                <ul>{% for file in codePack.assets.contents %}{{ dir.listFiles(file) }}{% endfor %}</ul>
                            </li>
                        </ul>
                    </div>
                    <div class="freeform-demo-routes">
                        <h3 class="freeform-demo-section-heading">
                            <span data-icon="routes" aria-hidden="true"></span>
                            <span>{{ "Routes"|t('app') }}</span>
                            <span class="freeform-demo-count">{{ codePack.routes.data|length }}</span>
                        </h3>
                        <ul class="directory-structure routes">
                            {% for route in codePack.routes.data %}
                                <li><span class="route" data-name="/{{ route.urlPattern }}">{{ prefix }}/{{ route.urlPattern }}</span><div class="template">{{ route.template }}</div></li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </details>
        </div>

        <div data-install-progress hidden role="status" aria-live="polite" tabindex="-1">
            <h2 class="first">{{ "Installing demo templates…"|t('freeform') }}</h2>
            <p class="light">{{ "Copying templates and assets, and configuring routes. Please keep this page open."|t('freeform') }}</p>
            <progress class="freeform-demo-progress" aria-label="{{ 'Installing demo templates'|t('freeform') }}"></progress>
        </div>
        <div data-install-result role="status" aria-live="polite" tabindex="-1" hidden></div>
    </div>
{% endblock %}
