{# name: Sidebar #}
{# description: A narrow stack of links, a helpful note, and a contact prompt. #}
<aside aria-label="Helpful sidebar" style="box-sizing: border-box; width: 100%; min-width: 0; padding: 1.5rem; border: 1px solid #ddd6fe; border-radius: 1rem; background: #faf7ff; color: #3b0764; overflow-wrap: anywhere;">
    <p style="margin: 0 0 .5rem; color: #6d28d9; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;">Before takeoff</p>
    <h2 style="margin: 0 0 .75rem; font-size: 1.5rem; line-height: 1.2;">Your tiny flight guide</h2>
    <p style="margin: 0 0 1.5rem;">Everything a dragon passenger needs, stacked within easy reach.</p>

    <nav aria-label="Quick links" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: .5rem; margin-bottom: 1.5rem;">
        <a href="#about" style="display: block; padding: .7rem .85rem; border-radius: .5rem; background: #ede9fe; color: #3b0764; text-decoration: none;">Meet your ride →</a>
        <a href="#features" style="display: block; padding: .7rem .85rem; border-radius: .5rem; background: #ede9fe; color: #3b0764; text-decoration: none;">What is included →</a>
        <a href="#faq" style="display: block; padding: .7rem .85rem; border-radius: .5rem; background: #ede9fe; color: #3b0764; text-decoration: none;">Flight questions →</a>
    </nav>

    <div style="margin-bottom: 1.5rem; padding: 1rem; border-left: 3px solid #fbbf24; border-radius: .4rem; background: #fffbeb;">
        <strong>Dragon's tip</strong>
        <p style="margin: .35rem 0 0;">Pack a snack. Your pilot will absolutely ask for one.</p>
    </div>

    <a href="#contact" style="display: block; padding: .8rem 1rem; border-radius: .5rem; background: #3b0764; color: white; font-weight: 700; text-align: center; text-decoration: none;">Ask the dragon desk</a>
</aside>
