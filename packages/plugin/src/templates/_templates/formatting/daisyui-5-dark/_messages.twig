{% set successBanner %}
    <div{{ form.attributes.success|raw }}>{{ form.successMessage|t('freeform') }}</div>
{% endset %}
{% set errorBanner %}
    <div{{ form.attributes.errors|raw }}>
        <div>
            <div>{{ form.errorMessage|t('freeform') }}</div>
            <ul data-freeform-banner-errors{% if not form.errors|length %} hidden{% endif %}>
                {% for error in form.errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        </div>
    </div>
{% endset %}
{% if form.settings.ajax %}
    <template data-freeform-success-template>{{ successBanner }}</template>
    <template data-freeform-error-template>{{ errorBanner }}</template>
{% else %}
    {% if form.submittedSuccessfully %}{{ successBanner }}{% endif %}
    {% if form.hasErrors %}{{ errorBanner }}{% endif %}
{% endif %}
