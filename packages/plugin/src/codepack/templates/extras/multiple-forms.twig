{% extends "demo/_layout" %}

{% set pageTitle = "Multiple Forms in the Same Page | Examples" %}

{# Replace 'freeformMultipleForms' with your form handle #}
{% set demoFormHandle = "freeformMultipleForms" %}

{% block content %}

    {% set form = freeform.form(demoFormHandle, { formattingTemplate: pageTemplateFile }) %}

    <article class="freeform-form-browser freeform-example-detail" aria-labelledby="example-title">
    {% set exampleDescription %}This example shows how you might have the same form (or 2 similar ones) more than once in the same template. Some complex field types and features might otherwise behave incorrectly unless some adjustments are made to the templates.{% endset %}
    {% include "demo/extras/_items.twig" with { mode: 'header', exampleHandle: 'multiple-forms' } %}

    {% if form %}
        <section class="freeform-submissions-panel freeform-example-demo-panel" aria-labelledby="live-example-title">
            <div class="freeform-submissions-toolbar"><h3 id="live-example-title">Try the example</h3></div>
            <div class="freeform-example-demo-body">

        <h3 class="freeform-form-title">{{ form.name }} <small>(1st instance)</small></h3>

        {# Apply 'id' and 'fieldIdPrefix' parameters with unique values, and an additional argument of 'first-form' after the properties #}
        {{ form.render(
            {
                attributes: {
                    id: "first-instance",
                    class: "first-class",
                },
                fieldIdPrefix: 'first-form-',
            },
            "first-form"
        ) }}

        <div class="freeform-example-instance-divider" aria-hidden="true"></div>

        <h3 class="freeform-form-title">{{ form.name }} <small>(2nd instance)</small></h3>

        {# Apply 'id' and 'fieldIdPrefix' parameters with unique values, and an additional argument of 'second-form' after the properties #}
        {{ form.render(
            {
                attributes: {
                    "=id": "second-instance",
                    "=class": "second-class",
                },
                fieldIdPrefix: 'second-form-',
            },
            "two"
        ) }}

            </div>
        </section>

    {% else %}

        {% set setupNoticeMessage %}<p>Use a form with the handle <code>{{ demoFormHandle }}</code> to run this example.</p>{% endset %}
        {% include "demo/extras/_setup-notice.twig" %}

    {% endif %}

    {# Instructions to get this page working correctly #}
    {% embed "demo/extras/_setup.twig" %}
        {% block instructions %}
        <ol>
            <li>Rename your test form handle to <code>{{ demoFormHandle }}</code> or adjust the form handle name inside this template to match your test form.</li>
        </ol>
        {% endblock %}
    {% endembed %}
    <p class="freeform-example-template-note">Template: <code>extras/multiple-forms.twig</code></p>
    </article>

{% endblock %}
