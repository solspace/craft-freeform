{
  "name": "root",
  "packageManager": "pnpm@11.10.0",
  "workspaces": [
    "packages/app",
    "packages/builder",
    "packages/scripts",
    "packages/styles"
  ],
  "private": true,
  "description": "Freeform plugin for Craft CMS",
  "dependencies": {
    "transliteration": "2.6.1"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.2",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "10.0.0",
    "prettier": "2.8.8",
    "typescript": "4.9.5"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ff/app --filter @ff/builder --filter @ff/scripts --filter @ff/styles dev",
    "front-end": "pnpm --parallel --filter @ff/scripts --filter @ff/styles dev",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write '**/*.{ts,tsx,md,json,js,jsx,css}'",
    "format:verify": "prettier --list-different '**/*.{ts,tsx,md,json,js,jsx,css}'",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "author": "Solspace, Inc.",
  "license": "ISC",
  "volta": {
    "node": "26.5.0"
  }
}
