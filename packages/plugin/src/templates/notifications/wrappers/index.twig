{% extends "freeform/notifications/_layout" %}

{% set title = 'Notification Wrappers'|t('freeform') %}

{% set canManageTemplates = currentUser.can('freeform-notificationsManage') %}

{% block actionButton %}
    {% if canManageTemplates %}
        <div class="buttons"><a class="btn submit add icon" href="{{ url('freeform/notifications/wrappers/new') }}">{{ 'New Wrapper'|t('freeform') }}</a></div>
    {% endif %}
{% endblock %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: 'Email Notifications'|t('freeform'), url: url('freeform/notifications') },
    { label: 'Wrappers'|t('freeform'), url: url('freeform/notifications/wrappers') },
] %}

{% set content %}
    {% if list|length %}
        <div class="tablepane ff-notification-tablepane">
            <table data-file-templates class="data fullwidth ff-notification-table">
                <thead><tr>
                    <th scope="col" class="ff-notification-name-column">{{ 'Template'|t('freeform') }}</th>
                    <th scope="col">{{ 'Handle'|t('freeform') }}</th>
                    {% if canManageTemplates %}<th scope="col" class="ff-notification-actions-column"><span class="visually-hidden">{{ 'Actions'|t('freeform') }}</span></th>{% endif %}
                </tr></thead>
                <tbody>
                    {% for wrapper in list %}
                        <tr data-id="{{ wrapper.id }}" data-name="{{ wrapper.name }}">
                            <th scope="row" class="ff-notification-name-cell">
                                <div class="ff-notification-heading">
                                    {% if canManageTemplates %}<a href="{{ url('freeform/notifications/wrappers/' ~ wrapper.id) }}">{{ wrapper.name }}</a>{% else %}<span>{{ wrapper.name }}</span>{% endif %}
                                    <span class="ff-notification-id" title="{{ 'ID {id}'|t('freeform', {id: wrapper.id}) }}">#{{ wrapper.id }}</span>
                                </div>
                                {% if wrapper.description %}<p class="ff-notification-description">{{ wrapper.description }}</p>{% endif %}
                            </th>
                            <td class="ff-notification-filename-cell"><code class="ff-notification-filename" title="{{ wrapper.handle }}">{{ wrapper.handle }}</code></td>
                            {% if canManageTemplates %}
                                <td class="ff-notification-actions-cell">{% include 'freeform/notifications/_actions' with {notificationType: 'wrappers', templateName: wrapper.name} only %}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    <div data-notification-empty{% if list|length %} hidden{% endif %}>
        {% include 'freeform/notifications/_empty' with {kind: 'wrappers'} %}
    </div>
{% endset %}
