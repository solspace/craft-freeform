{% if integration and integration.enabled %}
    <div class="field">
        <div class="buttons">
            <a class="btn small fm-button" data-action="freeform/form-monitor/disable-me">
                {{ "Disable Monitoring"|t('freeform') }}
            </a>
            <a class="btn small fm-button" data-action="freeform/form-monitor/delete-me">
                {{ "Disable & Delete Monitoring Data"|t('freeform') }}
            </a>
        </div>
    </div>

    {% js %}
        var confirmDisableMessage = '{{ "Are you sure you want to disable monitoring? This action cannot be undone."|t('freeform') }}';
        var confirmDeleteMessage = '{{ "Are you sure you want to disable monitoring and delete all monitoring data? This action cannot be undone."|t('freeform') }}';

        $('[data-action="freeform/form-monitor/disable-me"]').on('click', function() {
            if (confirm(confirmDisableMessage)) {
                Craft.postActionRequest($(this).data('action'), {}, function(response) {
                    if (response.success) {
                        window.location.reload();
                    } else {
                        Craft.cp.displayError(response.error);
                    }
                });
            }
        });

        $('[data-action="freeform/form-monitor/delete-me"]').on('click', function() {
            if (confirm(confirmDeleteMessage)) {
                Craft.postActionRequest($(this).data('action'), {}, function(response) {
                    if (response.success) {
                        window.location.reload();
                    } else {
                        Craft.cp.displayError(response.error);
                    }
                });
            }
        });
    {% endjs %}
{% endif %} 