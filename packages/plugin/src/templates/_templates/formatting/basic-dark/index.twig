{% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\FormattingTemplates\\BasicDarkBundle') %}

{% import "freeform/_templates/formatting/basic-dark/_row.twig" as rowMacro %}

{# Signature pads may grow to 125% of their configured width; use 1 to prevent enlargement. #}
{# Render the opening form tag #}
{{ form.renderTag({
    attributes: {
        form: { "data-freeform-theme": "dark", class: "freeform-form", "data-freeform-basic-dark": true, "data-freeform-signature-responsive": true, "data-freeform-signature-theme": "basic-dark", "data-freeform-signature-max-scale": 1.25 },
        row: { class: "freeform-row" },
        success: { class: "freeform-form-success", role: "status" },
        errors: { class: "freeform-form-errors", role: "alert" },
        novalidate: true,
    },
    fields: {
        "@file-dnd": {
            attributes: { input: { "data-theme": "dark" } },
        },
        "@global": {
            attributes: {
                input: {
                    class: ["freeform-input"]
                },
                label: { class: "freeform-label" },
                instructions: { class: "freeform-instructions" },
                error: { class: "freeform-errors" },
            },
        },
        ":required": {
            attributes: {
                label: { "+class": "freeform-required" },
            }
        },
        ":errors": {
            attributes: {
                input: { "+class": "is-invalid has-validation freeform-has-errors" },
            },
        },
        "@group": {
            attributes: {
                label: { "+class": "group-label" },
            },
        },
        "@signature": {
            attributes: {
                input: { "-class": "freeform-input", "+class": "freeform-signature-clear" },
            },
        }
    }
}) }}

{# Success and error message handling for non-AJAX forms #}
{% if not form.settings.ajax %}
    {% if form.submittedSuccessfully %}
        <div{{ form.attributes.success|raw }}>
            <p>{{ form.successMessage | t('freeform') }}</p>
        </div>
    {% endif %}
    {% if form.hasErrors %}
        <div{{ form.attributes.errors|raw }}>
            <p>{{ form.errorMessage | t('freeform') }}</p>

            {% if form.errors|length %}
                <ul>
                    {% for error in form.errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}
{% endif %}

{# Render page tabs if multi-page #}
{% if form.pages|length > 1 %}
    <ul class="freeform-pages">
        {% for page in form.pages %}
            <li {% if form.currentPage.index == page.index %}class="active" aria-current="step"{% endif %}>
                {% if form.currentPage.index == page.index %}
                    <b>{{ page.label }}</b>
                {% else %}
                    {{ page.label }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}

{# Display form field rows and columns #}
{{ rowMacro.render(form.rows, form) }}

{# Render the closing form tag #}
{{ form.renderClosingTag }}
