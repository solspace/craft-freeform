{% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\FormattingTemplates\\DaisyUI5DarkBundle') %}
{% import 'freeform/_templates/formatting/daisyui-5-dark/_row.twig' as rowMacro %}

{# Signature pads may grow to 125% of their configured width; use 1 to prevent enlargement. #}
{% set formTagProperties = {
    attributes: {
        form: { 'data-freeform-theme': 'dark', class: 'ff-daisy-form', 'data-theme': 'dark', 'data-freeform-daisyui': true, "data-freeform-signature-responsive": true, "data-freeform-signature-theme": "daisyui-5-dark", "data-freeform-signature-max-scale": 1.25 },
        row: { class: 'ff-daisy-row' },
        success: { class: 'ff-daisy-banner alert alert-success', role: 'status' },
        errors: { class: 'ff-daisy-banner alert alert-error', role: 'alert' },
        novalidate: true,
    },
    buttons: {
        attributes: {
            container: { class: 'ff-daisy-actions' },
            submit: { class: 'btn btn-primary' },
            back: { class: 'btn' },
            save: { class: 'btn btn-neutral' },
        },
    },
    fields: {
        '@global': {
            attributes: {
                container: { class: 'ff-daisy-field' },
                label: { class: 'ff-daisy-label' },
                input: { class: 'input' },
                instructions: { class: 'ff-daisy-help' },
                error: { class: 'ff-daisy-error' },
            },
        },
        ':required': {
            attributes: { label: { '+class': 'ff-daisy-required' } },
        },
        ':errors': {
            attributes: { input: { '+class': 'input-error', 'aria-invalid': 'true' } },
        },
        '@checkboxes, @radios, @opinion-scale, @rating, @cards': {
            attributes: { container: { tag: 'fieldset' }, label: { tag: 'legend' } },
        },
        '@checkboxes': {
            attributes: { input: { '=class': 'checkbox' }, optionLabel: { class: 'ff-daisy-option' } },
        },
        '@radios': {
            attributes: { input: { '=class': 'radio' }, optionLabel: { class: 'ff-daisy-option' } },
        },
        '@checkbox': {
            attributes: { input: { '=class': 'checkbox' } },
        },
        '@dropdown': {
            attributes: { input: { '=class': 'select ff-daisy-select-control' } },
        },
        '@multiple-select': {
            attributes: { input: { '=class': 'ff-daisy-multiple ff-daisy-select-control' } },
        },
        '@textarea': {
            attributes: { input: { '=class': 'textarea' } },
        },
        '@file': {
            attributes: { input: { '=class': 'file-input' } },
        },
        '@range': {
            attributes: { input: { '=class': 'range range-primary' } },
        },
        '@summary': {
            attributes: { input: { '=class': 'ff-daisy-summary' } },
        },
        '@signature': {
            attributes: { input: { "-class": "input", "+class": "btn btn-outline freeform-signature-clear" } },
        },
        '@stripe': {
            attributes: { input: { '-class': 'input' } },
        },
    },
} %}
{% if form.type == 'Page' %}
    {% do form.registerContext(formTagProperties) %}
    <div class="{{ formTagProperties.attributes.form.class }} freeform-page"{% for name, value in formTagProperties.attributes.form %}{% if name starts with 'data-' %} {{ name }}="{{ value is same as(true) ? 'true' : value }}"{% endif %}{% endfor %}{% if form.pageBackgroundColor %} style="background-color: {{ form.pageBackgroundColor }}"{% endif %}>
{% else %}
    {{ form.renderTag(formTagProperties) }}
{% endif %}

{% if form.type != 'Page' %}
    {% include "freeform/_templates/formatting/daisyui-5-dark/_messages.twig" %}
{% endif %}

{% if form.type != 'Page' and form.pages|length > 1 %}
    <nav class="ff-daisy-page-nav" aria-label="{{ 'Form progress'|t('freeform') }}">
        <ol class="steps">
            {% for page in form.pages %}
                <li class="step{% if form.currentPage.index >= page.index %} step-primary{% endif %}"{% if form.currentPage.index == page.index %} aria-current="step"{% endif %}>{{ page.label }}</li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}

{{ rowMacro.render(form.canvasRows, form) }}
{% if form.type == 'Page' %}</div>{% else %}{{ form.renderClosingTag }}{% endif %}
