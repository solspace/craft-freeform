<html lang="{{ craft.app.language }}">
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;

            padding: 0;
            margin: 0;
            background-color: #f9f9f9;
        }

        header {
            background-color: #0388FE;
            height: 50px;

            padding: 20px 40px;
        }

        header img {
            width: auto;
            height: 100%;
            max-width: 100%;
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }

        .errors {
            color: #d9534f;
        }

        h1 {
            color: #d9534f;
        }
        p {
            font-size: 16px;
        }

        .info {
            font-size: 14px;
            color: #555;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <header>
        <img alt="Freeform 5 for Craft CMS" src="https://docs.solspace.com/img/intro/freeform-dark.png">
    </header>

    <div class="container">
        <h1>
            {{ "An Error Occurred"|t('freeform') }}
        </h1>
        <div class="errors">
            {% for message in messages %}
                <p>{{ message|t('freeform') }}</p>
            {% endfor %}
        </div>
        <p class="info">
            {{ "Please check your credentials and try again, or contact support."|t('freeform') }}
        </p>
    </div>
</body>
</html>
