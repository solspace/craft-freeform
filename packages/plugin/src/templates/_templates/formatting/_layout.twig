{% do view.registerCss(field.layoutCss, {}, 'freeform-layout') %}
{% import rowTemplate as rowMacro %}
{{ field.renderContainerOpeningTag }}
    <div class="freeform-layout-columns" data-cards="{{ field.cardStyle ? 'true' : 'false' }}" data-stack="{{ field.stackedOnMobile ? 'true' : 'false' }}" data-freeform-background-image="{{ field.backgroundImageUrl|e('html_attr') }}" data-appearance="{{ field.appearanceStyle ? 'true' : 'false' }}" data-design="{{ field.designed ? 'true' : 'false' }}" data-design-treatment="{{ field.designTreatment == 'bold' ? 'bold' : 'soft' }}" style="{{ field.layoutStyle|e('html_attr') }}">
        {% for row in field.layout %}
            {% for column in row %}
                {{ column.renderContainerOpeningTag }}
                    {{ rowMacro.render(column.layout, form) }}
                {{ column.renderContainerClosingTag }}
            {% endfor %}
        {% endfor %}
    </div>
{{ field.renderContainerClosingTag }}
