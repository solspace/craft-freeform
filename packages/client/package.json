{
  "name": "@ff/client",
  "version": "1.0.0",
  "description": "Freeform Client",
  "scripts": {
    "dev": "NODE_ENV=development pnpm run watch",
    "build": "pnpm run clean && NODE_ENV=production pnpm run compile",
    "watch": "webpack serve --config ./config/webpack/dev.config.js",
    "clean": "rm -rf ../plugin/src/Resources/js/client",
    "compile": "webpack --config ./config/webpack/prod.config.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest --config ./config/vitest/vitest.config.ts",
    "test:coverage": "vitest --config ./config/vitest/vitest.config.ts --maxWorkers=4 --collect-coverage",
    "test:watch": "vitest --config ./config/vitest/vitest.config.ts --watch --maxWorkers=4"
  },
  "keywords": [
    "Freeform",
    "Craft CMS",
    "App"
  ],
  "author": "Solspace Inc.",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "config/**",
    "src/**/persistence.ts",
    "src/**/*.persistence.ts"
  ],
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@monaco-editor/react": "^4.7.0",
    "@react-spring/web": "^10.0.3",
    "@reduxjs/toolkit": "^2.11.2",
    "@sindresorhus/transliterate": "^2.3.1",
    "@tanstack/react-query": "^5.90.21",
    "@tinymce/tinymce-react": "^6.3.0",
    "@yaireo/tagify": "^4.36.0",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "dompurify": "3.3.2",
    "html-to-image": "^1.11.13",
    "lodash": "^4.17.23",
    "marked": "^17.0.4",
    "react": "^19.2.4",
    "react-datepicker": "8.10.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^2.15.0",
    "redux": "^5.0.1",
    "sortablejs": "^1.15.6",
    "styled-components": "^6.3.11",
    "tinymce": "^7.7.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.10.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sortablejs": "^1.15.8",
    "@types/yaireo__tagify": "^4.18.0",
    "css-loader": "^7.1.2",
    "immutability-helper": "^3.1.1",
    "jsdom": "^26.0.0",
    "react-refresh": "^0.16.0",
    "react-refresh-typescript": "^2.0.10",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.11",
    "ts-loader": "^9.5.4",
    "typescript-plugin-styled-components": "^3.0.0",
    "url-loader": "^4.1.1",
    "vitest": "^4.0.18",
    "vitest-tsconfig-paths": "^3.4.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^5.9.0"
  }
}
