{% extends "demo/_layout" %}

{% block title %}Freeform Demo | Submission #{{ craft.app.request.segment(baseUrlSegments + 3) }} for {{ form ? form.name : 'Unknown form' }}{% endblock %}

{% block content %}

    {% set submissionId = craft.app.request.segment(baseUrlSegments + 3) %}

    {# Allow Admins only to view submission data for Demo Templates by default #}
    {% if currentUser and currentUser.admin %}

        {% set submission = form ? freeform.submissions({
            id: submissionId,
            form: formHandle,
            isSpam: spamMode
        }).one : null %}

        {% if submission %}

            {% include "demo/submissions/_detail" %}

        {% else %}

            <div class="freeform-warning-notice{{ colorMode == "dark" ? " freeform-notice-dark" }}">
                Sorry, no submission was found.
            </div>

        {% endif %}

    {% else %}

        <div class="freeform-warning-notice{{ colorMode == "dark" ? " freeform-notice-dark" }}">
            Sorry, you do not have permission to access this page.
        </div>

    {% endif %}

{% endblock %}
