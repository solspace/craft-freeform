{% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\FormattingTemplates\\Tailwind4DarkBundle') %}

{% import "freeform/_templates/formatting/tailwind-4-dark/_row.twig" as rowMacro %}

{# Signature pads may grow to 125% of their configured width; use 1 to prevent enlargement. #}
{# Render the opening form tag #}
{% set formTagProperties = {
  attributes: {
    form: { "data-freeform-theme": "dark", class: "freeform-form", "data-freeform-tailwind": true, "data-freeform-signature-responsive": true, "data-freeform-signature-theme": "tailwind-4-dark", "data-freeform-signature-max-scale": 1.25 },
    row: { class: "flex gap-x-2 -mx-2 mb-4" },
    success: { class: "rounded-md bg-green-900/20 p-4 mb-10", role: "status" },
    errors: { class: "rounded-md bg-red-900/20 p-4 mb-10", role: "alert" },
    novalidate: true,
  },
  buttons: {
    attributes: {
      container: { class: "flex flex-wrap -mx-7.5 mb-4" },
      column: { class: "mx-6" },
      buttonWrapper: {},
      submit: { class: "rounded-md mx-1.5 px-5 py-2 text-md font-semibold text-white bg-indigo-500 hover:bg-indigo-400" },
      back: { class: "rounded-md mx-1.5 px-5 py-2 text-md font-normal text-white bg-gray-700 hover:bg-gray-600" },
      save: { class: "rounded-md mx-1.5 px-5 py-2 text-md font-normal text-white bg-gray-800 hover:bg-gray-700" },
    },
  },
  fields: {
    "@global": {
      attributes: {
        container: { class: "w-full px-2" },
        label: { class: "block text-sm/6 mb-1 font-medium text-white" },
        input: {
          class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-white outline outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6",
        },
        instructions: { class: "text-sm text-gray-400 -mt-1.5 mb-1" },
        error: { class: "mt-1 text-sm text-red-700" },
      },
    },
    ":required": {
      attributes: {
        label: { "+class": "freeform-required" },
        input: { required: "" },
      },
    },
    ":errors": {
      attributes: {
        input: { "+class": "outline-1 -outline-offset-1 outline-red-700 border-1 border-red-700" },
      },
    },
    "@checkboxes, @radios, @opinion-scale, @rating, @cards": {
      attributes: {
        container: { tag: "fieldset" },
        label: { tag: "legend" },
      },
    },
    "@checkboxes, @radios": {
      attributes: {
        input: {
          "-class": "block w-full px-3 py-1.5 rounded-md text-base text-white outline outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6",
          "+class": "appearance-none size-4 border border-white/10 checked:border-indigo-500 checked:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500",
        },
        optionLabel: { class: "block text-sm/6 font-medium text-white" },
      },
    },
    "@radios": {
      attributes: {
        input: {
          "+class": "relative rounded-full before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden",
        },
        optionLabel: { class: "ml-2" },
      },
    },
    "@checkboxes": {
      attributes: {
        input: {
          "+class": "col-start-1 row-start-1 rounded-sm bg-white indeterminate:border-indigo-500 indeterminate:bg-indigo-500",
        },
      },
    },
    "@opinion-scale": {
      attributes: {
        optionLabel: { "=class": "relative flex items-center justify-between cursor-pointer bg-white/10 px-3 py-1.5 rounded-md text-base text-white text-sm outline-1 -outline-offset-1 outline-white/10 rounded-md peer-checked:outline-2 peer-checked:outline-indigo-500 hover:bg-white/5" },
        input: { "-class": "appearance-none block w-full" },
      },
    },
    "@cards": {
      attributes: {
        optionLabel: { "=class": "relative flex flex-col gap-1 h-full items-left justify-start cursor-pointer bg-white/10 pb-3 rounded-md text-base text-white text-sm outline-1 -outline-offset-1 outline-white/10 rounded-md peer-checked:outline-2 peer-checked:outline-indigo-500 hover:bg-white/5" },
        input: { "-class": "appearance-none block w-full" },
      },
      cardAttributes: {
        card: { class: "group min-w-0 mb-2 sm:mb-0" },
        image: { class: "mb-1 rounded-t-md" },
        content: { class: "flex items-center justify-between px-3" },
        cardLabel: { "=class": "text-lg font-bold" },
        cardDescription: { class: "text-xs px-3" },
        cardMetadata: { class: "list-disc list-outside text-xs pl-6 pr-3" },
      }
    },
    "@range": {
      attributes: {
        container: { "+class": "freeform-range-tailwind freeform-range-tailwind-dark" },
        input: { "=class": "block w-full accent-indigo-500" },
      },
    },
    "@rating": {
      attributes: {
        optionLabel: { "+class": "mr-1" },
      },
    },
    "@checkbox": {
      attributes: {
        label: {
          class: "block text-sm/6 font-medium text-white",
        },
        input: {
          "-class": "block w-full px-3 py-1.5 rounded-md text-base text-white outline outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6",
          "+class": "col-start-1 row-start-1 rounded-sm appearance-none size-4 rounded-full border border-white/10 bg-white checked:border-indigo-500 checked:bg-indigo-500 indeterminate:border-indigo-500 indeterminate:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500",
        },
      },
    },
    "@dropdown": {
      attributes: {
        input: {
          "-class": "block px-3 placeholder:text-gray-400",
          "+class": "col-start-1 row-start-1 appearance-none pr-8 pl-3",
        },
      },
    },
    "@multiple-select": {
      attributes: {
        input: {
          "-class": "placeholder:text-gray-400",
          "+class": "h-30 overflow-auto",
        },
      },
    },
    "@file-dnd": {
      attributes: {
        input: {
          "-class": "block w-full outline outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500",
          "+class": "justify-center rounded-md !bg-white/1 !border border-dashed !border-white/15",
        },
      },
    },
    "@file": {
      attributes: {
        label: {
          "=class": "freeform-upload-btn inline-flex items-center justify-center gap-2 px-3 py-1.5 text-sm text-white font-normal bg-white/10 rounded-md cursor-pointer ring-1 ring-white/10 ring-inset hover:bg-white/5",
        },
        input: {
          "=class": "freeform-file-upload-input absolute inset-0 w-0 h-0 opacity-0 cursor-pointer",
        },
      },
    },
    "@table": {
      attributes: {
        label: { "-class": "block" },
        input: { "-class": "appearance-none block w-full" },
      },
    },
    "@group": {
      attributes: {
        container: { "+class": "-mb-4" },
        label: { "-class": "font-medium", "+class": "font-semibold" },
      },
    },
    "@signature": {
      attributes: {
        input: { "-class": "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-white outline outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6", "+class": "freeform-signature-clear" },
      },
    },
    "@stripe": {
      attributes: {
        input: { "-class": "rounded-md bg-white/5 px-3 py-1.5 text-base text-white outline outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" },
      },
    },
  },
} %}
{% if form.type == 'Page' %}
    {% do form.registerContext(formTagProperties) %}
    <div class="{{ formTagProperties.attributes.form.class }} freeform-page"{% for name, value in formTagProperties.attributes.form %}{% if name starts with 'data-' %} {{ name }}="{{ value is same as(true) ? 'true' : value }}"{% endif %}{% endfor %}{% if form.pageBackgroundColor %} style="background-color: {{ form.pageBackgroundColor }}"{% endif %}>
{% else %}
    {{ form.renderTag(formTagProperties) }}
{% endif %}

{# Reuse the same icon banners for standard and AJAX submissions #}
{% if form.type != 'Page' %}
    {% include "freeform/_templates/formatting/tailwind-4-dark/_messages.twig" %}
{% endif %}

{# Render page tabs if multi-page #}
{% if form.type != 'Page' and form.pages|length > 1 %}

<nav class="mb-10" aria-label="Progress">
  <ol role="list" class="divide-y divide-white/15 rounded-md border bg-black/10 border-white/15 sm:flex sm:divide-y-0">
  {% for page in form.pages %}
    <li class="relative sm:flex sm:flex-1"{% if form.currentPage.index == page.index %} aria-current="step"{% endif %}>
      <div class="group flex w-full items-center">
        <span class="flex items-center px-3 sm:px-6 py-2 sm:py-4 text-sm font-medium">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full {% if form.currentPage.index > page.index %}bg-indigo-500{% elseif form.currentPage.index == page.index %}border-2 border-indigo-500{% else %}border-2 border-white/10{% endif %}">
          {% if form.currentPage.index > page.index %}
            <svg class="size-6 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon">
              <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />
            </svg>
          {% else %}
            <span class="{{ form.currentPage.index == page.index ? 'border-indigo-500 text-indigo-500 font-semibold' : 'border-white/15 text-gray-400' }}">{{ page.index + '1' }}</span>
          {% endif %}
          </span>
          <span class="ml-4 text-sm font-medium {% if form.currentPage.index > page.index %}text-white{% elseif form.currentPage.index == page.index %}text-indigo-500 font-semibold{% else %}text-gray-400{% endif %}">{{ page.label }}</span>
        </span>
      </div>
      {% if (page.index + 1) != form.pages.count %}
      <div class="absolute top-0 right-0 hidden h-full w-5 sm:block" aria-hidden="true">
        <svg aria-hidden="true" focusable="false" class="size-full text-white/15" viewBox="0 0 22 80" fill="none" preserveAspectRatio="none">
          <path d="M0 -2L20 40L0 82" vector-effect="non-scaling-stroke" stroke="currentcolor" stroke-linejoin="round" />
        </svg>
      </div>
      {% endif %}
    </li>
  {% endfor %}
  </ol>
</nav>
{% endif %}

{# Display form field rows and columns #}
{{ rowMacro.render(form.canvasRows, form) }}

{# Render the closing form tag #}
{% if form.type == 'Page' %}</div>{% else %}{{ form.renderClosingTag }}{% endif %}
