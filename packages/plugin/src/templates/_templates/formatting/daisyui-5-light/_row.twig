{% macro getFieldTemplate(type) -%}
    {{- 'freeform/_templates/formatting/daisyui-5-light/fields/' ~ type ~ '.twig' -}}
{%- endmacro %}

{% macro render(rows, form) %}
    {% import _self as self %}
    {% for row in rows %}
        {% tag form.attributes.row.tag with form.attributes.row.toHtmlTagArray %}
            {% for field in row %}
                {% include [self.getFieldTemplate(field.type), self.getFieldTemplate('_default')] %}
            {% endfor %}
        {% endtag %}
    {% endfor %}
{% endmacro %}
