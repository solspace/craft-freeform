{% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\FormattingTemplates\\Bootstrap5FloatingLabelsBundle') %}

{% import "freeform/_templates/formatting/bootstrap-5-floating-labels/_row.twig" as rowMacro %}

{# Signature pads may grow to 125% of their configured width; use 1 to prevent enlargement. #}
{# Render the opening form tag #}
{% set formTagProperties = {
    attributes: {
        form: { class: "freeform-form", "data-freeform-bootstrap-floating-labels": true, "data-freeform-signature-responsive": true, "data-freeform-signature-theme": "bootstrap-5-floating-labels", "data-freeform-signature-max-scale": 1.25 },
        row: { class: "row" },
        success: { class: "alert alert-success", role: "status" },
        errors: { class: "alert alert-danger", role: "alert" },
        novalidate: true,
    },
    buttons: {
        attributes: {
            submit: { class: "btn btn-primary" },
            back: { class: "btn btn-secondary" },
            save: { class: "btn btn-primary" },
        },
    },
    fields: {
        "@global": {
            attributes: {
                container: { class: "mb-3 col-12" },
                input: {
                    class: "form-control"
                },
                label: { class: "mb-1" },
                instructions: { class: "form-text text-muted mt-1" },
                error: { class: "list-unstyled m-0 fst-italic text-danger" },
            },
        },
        ":required": {
            attributes: {
                label: { "+class": "required" },
            },
        },
        ":errors": {
            attributes: {
                input: { "+class": "is-invalid" },
            },
        },
        "@text, @textarea, @email, @website, @confirm, @regex, @phone, @datetime, @dropdown, @multiple-select, @number, @password": {
            attributes: {
                container: { "+class": "form-floating" },
            },
        },
        "@group": {
            attributes: {
            label: { "+class": "group-label" },
            },
        },
        "@checkbox" : {
            attributes: {
                input: { "=class": "form-check-input checkbox" },
                label: { "+class": "form-check-label" },
            },
        },
        "@dropdown" : {
            attributes: {
                input: { "+class": "form-select" },
            },
        },
        "@file" : {
            attributes: {
                input: { "+class": "form-control-file" },
            },
        },
        "@signature": {
            attributes: {
                input: { "-class": "form-control", "+class": "btn btn-outline-secondary freeform-signature-clear" },
            },
        },
        "@stripe": {
            attributes: {
                input: {
                    "-class": "form-control",
                },
            },
        },
    },
} %}
{% if form.type == 'Page' %}
    {% do form.registerContext(formTagProperties) %}
    <div class="{{ formTagProperties.attributes.form.class }} freeform-page"{% for name, value in formTagProperties.attributes.form %}{% if name starts with 'data-' %} {{ name }}="{{ value is same as(true) ? 'true' : value }}"{% endif %}{% endfor %}{% if form.pageBackgroundColor %} style="background-color: {{ form.pageBackgroundColor }}"{% endif %}>
{% else %}
    {{ form.renderTag(formTagProperties) }}
{% endif %}

{% if form.type != 'Page' %}
    {% include "freeform/_templates/formatting/bootstrap-5-floating-labels/_messages.twig" %}
{% endif %}

{# Render page tabs if multi-page #}
{% if form.type != 'Page' and form.pages|length > 1 %}
    <ul class="nav nav-tabs mb-4">
        {% for page in form.pages %}
            <li class="nav-item"{% if form.currentPage.index == page.index %} aria-current="step"{% endif %}>
                <span class="nav-link{{ form.currentPage.index == page.index ? ' fw-bold active' : ' disabled' }}">
                    {{ page.label }}
                </span>
            </li>
        {% endfor %}
    </ul>
{% endif %}

{# Display form field rows and columns #}
{{ rowMacro.render(form.canvasRows, form) }}

{# Render the closing form tag #}
{% if form.type == 'Page' %}</div>{% else %}{{ form.renderClosingTag }}{% endif %}
