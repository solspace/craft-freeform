{% macro render(row, submission) %}
    {% import "_includes/forms" as forms %}

    <div class="fields-row">
        {%- for field in row.allFields -%}
            {% set useCustomAttributes = field.parameters.useCustomAttributes ?? null %}
            {{ field.renderContainerOpeningTag({
                useCustomAttributes: false,
                attributes: {
                    container: {
                        class: [
                            'fields-column',
                            field.required ? 'field-required',
                        ],
                    },
                },
            }) }}

                {{ craft.freeformSubmissions.renderSubmissionField(field, submission) }}

            {{ field.renderContainerClosingTag }}
            {% do field.setParameters({ useCustomAttributes: useCustomAttributes }) %}
        {% endfor %}
    </div>
{% endmacro %}
