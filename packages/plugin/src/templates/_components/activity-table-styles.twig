{% css %}
.ff-activity-table {
    box-sizing: border-box;
    max-width: 70rem;
    overflow-x: auto;
    padding: 2px;
    border: 1px solid var(--hairline-color, #dbe2eb);
    border-radius: 6px;
    background: var(--pane-bg, var(--white, #fff));
}
.ff-activity-table table { min-width: 32rem; table-layout: fixed; }
.ff-activity-table table th:first-child { width: 47%; overflow-wrap: anywhere; }
.ff-activity-table thead th:nth-child(2) { width: var(--activity-table-secondary-width, 15%); }
.ff-activity-table table th, .ff-activity-table table td { padding-inline: 1.25rem; vertical-align: middle; }
.ff-activity-table thead th { font-size: .75rem; font-weight: 600; color: var(--light-text-color, #667789); }
.ff-activity-table tbody th, .ff-activity-table tbody td { padding-block: .875rem; }
.ff-activity-table tbody tr + tr > * { box-shadow: inset 0 1px 0 rgb(128 128 128 / .22); }
.ff-merge-form-label {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    --merge-accent: var(--secondary-text-color, #596979);
}
.ff-merge-chip-dot { flex: 0 0 .5rem; height: .5rem; border-radius: 50%; background: var(--merge-accent); }
{% endcss %}
