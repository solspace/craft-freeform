{% extends "freeform/_layouts/settings" %}

{% import "_includes/forms" as forms %}
{% import "freeform/_components/boolean-menu" as booleanMenu %}

{% set segment3 = craft.app.request.getSegment(3) %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
    { label: "Reliability"|t("freeform"), url: url("freeform/settings" ~ "/" ~ segment3) },
] %}

{% set title = "Alerts & Digests"|t("freeform") %}
{% set showSettingsHeading = false %}

{% block content %}

    {{ parent() }}

    <input type="hidden" name="action" value="freeform/settings/save-settings">
    {{ redirectInput('freeform/settings/notices-and-alerts') }}
    {{ csrfInput() }}

    {% if freeform.edition.isAtLeast('lite') %}

        <h2 class="first">{{ "Email Alerts"|t('freeform') }}</h2>

        {{ forms.textField({
            class: "code",
            label: "Error Alert Recipients"|t('freeform'),
            instructions: "Send alerts for failed email notifications, integration failures, and other Freeform errors to these comma-separated email addresses. Repeated errors are limited to one alert per hour."|t('freeform'),
            placeholder: "e.g john@smith.com, bethany@corporation.com",
            name: "settings[errorNotificationRecipients]",
            value: settings.errorNotificationRecipients,
            errors: settings.getErrors("errorNotificationRecipients"),
            disabled: readOnly,
        }) }}

        <hr>

        <h2>{{ "Digests"|t('freeform') }}</h2>

        <p>{{ "Digests cover the preceding day or week. Sending depends on site activity and Craft’s queue."|t('freeform') }}</p>

        {% set digestGroups = [
            {
                id:'developer-digest', label:'Developer Digest'|t('freeform'),
                recipientsName:'digestRecipients', recipientsValue:settings.digestRecipients,
                recipientsDescription:'Comma-separated email addresses for performance summaries and recorded errors and warnings.'|t('freeform'),
                recipientsLabel:'Developer Digest Recipients'|t('freeform'),
                frequencyName:'digestFrequency', frequencyValue:settings.digestFrequency,
                scheduleLabel:'Developer Digest Schedule'|t('freeform'),
            },
            {
                id:'stats-digest', label:'Stats Digest'|t('freeform'),
                recipientsName:'clientDigestRecipients', recipientsValue:settings.clientDigestRecipients,
                recipientsDescription:'Comma-separated email addresses for performance summaries.'|t('freeform'),
                recipientsLabel:'Stats Digest Recipients'|t('freeform'),
                frequencyName:'clientDigestFrequency', frequencyValue:settings.clientDigestFrequency,
                scheduleLabel:'Stats Digest Schedule'|t('freeform'),
            },
        ] %}
        {% for digest in digestGroups %}
            <section class="ff-digest-settings-group" role="group" aria-labelledby="{{ digest.id }}-heading">
                <h3 class="cp-h3" id="{{ digest.id }}-heading">{{ digest.label }}</h3>
                {{ forms.textField({
                    id:digest.id ~ '-recipients',
                    class:'code',
                    label:'Recipients'|t('freeform'),
                    inputAttributes:{aria:{label:digest.recipientsLabel}},
                    instructions:digest.recipientsDescription,
                    placeholder:'e.g john@smith.com, bethany@corporation.com',
                    name:'settings[' ~ digest.recipientsName ~ ']',
                    value:digest.recipientsValue,
                    errors:settings.getErrors(digest.recipientsName),
                    disabled:readOnly,
                }) }}
                {% include 'freeform/_components/digest-frequency' with {
                    id:digest.id ~ '-frequency', label:'Schedule'|t('freeform'),
                    accessibleLabel:digest.scheduleLabel, contextLabel:digest.label,
                    name:'settings[' ~ digest.frequencyName ~ ']', value:digest.frequencyValue,
                    errors:settings.errors().get(digest.frequencyName), readOnly:readOnly, instructions:'',
                } only %}
            </section>
        {% endfor %}

        {{ booleanMenu.field({
            includeEnvVars: true,
            label: "Send Digests Only in Production"|t('freeform'),
            instructions: "When enabled, digest emails are sent only when Craft’s environment is set to `production`."|t('freeform'),
            name: "settings[digestOnlyOnProduction]",
            value: settings.digestOnlyOnProduction,
            errors: settings.getErrors("digestOnlyOnProduction"),
            disabled: readOnly,
        }) }}

    {% endif %}

{% endblock %}
