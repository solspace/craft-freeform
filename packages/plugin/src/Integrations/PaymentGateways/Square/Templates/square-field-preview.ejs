<%
    const cardNumberPlaceholder =
        (typeof Craft !== 'undefined' && Craft.t)
            ? Craft.t('freeform', 'Card number')
            : 'Card number';

    const expiryPlaceholder =
        (typeof Craft !== 'undefined' && Craft.t)
            ? Craft.t('freeform', 'MM/YY')
            : 'MM/YY';

    const cvcPlaceholder =
        (typeof Craft !== 'undefined' && Craft.t)
            ? Craft.t('freeform', 'CVV')
            : 'CVV';
%>

<div class="square-demo">
    <div>
        <div class="cc-number">
            <div>
                <input type="text" placeholder="<%= cardNumberPlaceholder %>" />
            </div>
        </div>

        <div class="expiry">
            <div>
                <input type="text" placeholder="<%= expiryPlaceholder %>" />
            </div>
        </div>

        <div class="cvc">
            <div>
                <input type="text" placeholder="<%= cvcPlaceholder %>" />
            </div>
        </div>
    </div>
</div>
