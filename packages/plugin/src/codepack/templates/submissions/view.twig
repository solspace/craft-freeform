{% extends "demo/_layout" %}

{% block title %}Freeform Demo | Submission #{{ craft.app.request.segment(baseUrlSegments + 3) }} for {{ form ? form.name : 'Unknown form' }}{% endblock %}

{% block content %}

    {% set submissionId = craft.app.request.segment(baseUrlSegments + 3) %}

    {# Allow Admins only to view submission data for Demo Templates by default #}
    {% if currentUser and currentUser.admin %}

        {% set submission = form ? freeform.submissions({
            id: submissionId,
            form: formHandle,
            isSpam: spamMode
        }).one : null %}

        {% if submission %}

            {% include "demo/submissions/_detail" %}

        {% else %}

            {% include "demo/_message" with {
                messageTitle: 'Submission not found',
                messageText: 'This submission may have been removed, or the link is no longer valid.'
            } %}

        {% endif %}

    {% else %}

        {% include "demo/_message" with {
            messageType: 'permission',
            messageTitle: 'This page is for administrators',
            messageText: 'To keep submissions private, you’ll need an administrator account to view or manage them here. You can still explore the forms and examples.'
        } %}

    {% endif %}

{% endblock %}
