{% extends "demo/_layout" %}

{% block title %}Freeform Demo | Submissions for {{ form.name|default('-Select a Form-') }}{% endblock %}

{% block content %}
    {# The shared Forms overview now provides links to submissions and spam. #}
    {% if not craft.app.request.segment(baseUrlSegments + 2) %}
        {% redirect demoBaseUrl ~ '/forms' %}
    {% endif %}

    {% if currentUser and currentUser.admin %}
        {% if form %}
            {% paginate freeform.submissions({
                form: form.handle,
                isSpam: spamMode|default(false),
                limit: 50,
                orderBy: 'dateCreated DESC'
            }) as pageInfo, submissions %}

            {% set submissionCount = freeform.submissions({formId: form.id}).count %}
            {% set spamCount = freeform.submissions({formId: form.id, isSpam: true}).count %}
            {% include "demo/submissions/_table" %}
        {% else %}
            {% include "demo/_message" with {
                messageTitle: 'Form not found',
                messageText: 'No form was found with the handle “' ~ formHandle ~ '”. Choose another form to continue.'
            } %}
        {% endif %}
    {% else %}
        {% include "demo/_message" with {
            messageType: 'permission',
            messageTitle: 'This page is for administrators',
            messageText: 'To keep submissions private, you’ll need an administrator account to view or manage them here. You can still explore the forms and examples.'
        } %}
    {% endif %}
{% endblock %}
