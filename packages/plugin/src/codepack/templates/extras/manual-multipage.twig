{% extends "demo/_layout" %}

{% set pageTitle = "Manual multi-page forms | Examples" %}

{# Replace 'freeformManualMultipage' with your form handle #}
{% set demoFormHandle = "freeformManualMultipage" %}

{% block content %}

    {% set form = freeform.form(demoFormHandle, { formattingTemplate: pageTemplateFile }) %}

    <article class="freeform-form-browser freeform-example-detail" aria-labelledby="example-title">
        {% include "demo/extras/_items.twig" with {
            mode: 'header', exampleHandle: 'manual-multipage',
            exampleTitle: 'Manual multi-page forms',
            exampleDescription: 'Build a two-step form with your own markup and Freeform’s field helpers.',
        } %}

    {% if form %}

        <section class="freeform-submissions-panel freeform-example-live" aria-labelledby="live-example-title">
            <div class="freeform-submissions-toolbar"><h3 id="live-example-title">Try the example</h3><span class="freeform-example-step-count">Step {{ form.currentPage.index + 1 }} of 2</span></div>
        {# Return to this example after submission. Remove returnUrl to use the builder setting. #}
        {{ form.renderTag({returnUrl: demoBaseUrl ~ '/extras/manual-multipage', disable: ['submitButtons']}) }}

            {# Display any general errors upon submit #}
            <div class="form-heading-errors">
                {% if form.hasErrors %}
                    <div class="freeform-form-has-errors">
                        {{ "There was an error submitting this form"|t }}

                        {% if form.errors|length %}
                            <ul>
                                {% for error in form.errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {# Set up your needed form page fields #}
            {% set firstName = form.get("firstName") %}
            {% set lastName = form.get("lastName") %}
            {% set company = form.get("company") %}
            {% set email = form.get("email") %}
            {% set phone = form.get("phone") %}
            {% set state = form.get("state") %}
            {% set recipients = form.get("recipients") %}

            {# Steps are indicators. The submit buttons handle page changes. #}
            <ol class="freeform-example-steps" aria-label="Form progress">
                {% for step in ['Your details', 'Contact details'] %}
                    <li{% if form.currentPage.index == loop.index0 %} aria-current="step"{% endif %}><span>{{ loop.index }}</span>{{ step }}</li>
                {% endfor %}
            </ol>

            {# Show page 1 contents only #}
            {% if form.currentPage.index == 0 %}

                <div class="form-field">
                    {# Very manual #}
                    <label for="demo-first-name">{{ firstName.label }}</label>
                    <input id="demo-first-name" name="firstName" value="{{ firstName.value }}" />
                    {{ firstName.renderErrors() }}
                </div>

                <div class="form-field">
                    <label for="demo-last-name">{{ lastName.label }}</label>
                    <input id="demo-last-name" name="lastName" value="{{ lastName.value }}" />
                    {{ lastName.renderErrors() }}
                </div>

                <div class="form-field">
                    {# Somewhat manual #}
                    {{ company.renderLabel() }}
                    {{ company.renderInput() }}
                    {{ company.renderErrors() }}
                </div>

                <div class="freeform-example-form-actions"><button type="submit" name="form_page_submit">Continue <span aria-hidden="true">→</span></button></div>

            {# Show page 2 contents only #}
            {% elseif form.currentPage.index == 1 %}

                <div class="form-field">
                    <label for="demo-email">Email Address</label>
                    <input id="demo-email" type="email" name="email" value="{{ email.value }}" />
                    {{ form.get("email").renderErrors() }}
                </div>

                <div class="form-field">
                    {# Manual errors #}
                    <label for="demo-phone">Phone</label>
                    <input id="demo-phone" type="tel" name="phone" value="{{ phone.value }}" />
                    {% if form.get("phone").hasErrors %}
                        This field is required!
                    {% endif %}
                </div>

                <div class="form-field">
                    {# Manual multi-option field #}
                    <label for="demo-state">State</label>
                    <select id="demo-state" name="state">
                        {# You may also manually hardcode each option as well, as long as these options exist inside the form builder #}
                        {% for option in state.options %}
                            <option value="{{ option.value }}"{{ option.value == state.value ? ' selected' }}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-field">
                    {# Manual Dynamic Recipients field as Select #}
                    <label for="demo-recipients">Recipient</label>
                    <select id="demo-recipients" name="recipients">
                        {% for recipient in recipients.options %}
                            {# value is required to be 0, 1, 2, etc instead of actual email value #}
                            <option value="{{ loop.index0 }}">{{ recipient.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# To include 'Previous' button, be sure to give it a name of 'form_previous_page_button' #}
                <div class="freeform-example-form-actions"><button type="submit" name="form_previous_page_button" formnovalidate>← Previous</button><button type="submit" name="form_page_submit">Finish</button></div>

            {% endif %}

        {{ form.renderClosingTag }}
        </section>

    {% else %}

        {% set setupNoticeMessage %}<p>No form with the handle <code>{{ demoFormHandle }}</code> was found. Follow the setup guide below to connect one.</p>{% endset %}
        {% include "demo/extras/_setup-notice.twig" with { setupNoticeTitle: 'Set up a form to try this example' } %}

    {% endif %}

    {# Keep these requirements aligned with the manually rendered fields above. #}
    {% embed "demo/extras/_setup.twig" with { setupSummary: '2 pages · 7 fields' } %}
        {% block instructions %}
            <div class="freeform-example-connect"><span class="freeform-example-number" aria-hidden="true">1</span><div><h4>Connect your form</h4><p>Set your test form’s handle to <code>{{ demoFormHandle }}</code>, or update <code>demoFormHandle</code> in this template to match your form.</p></div></div>
            <div class="freeform-example-connect"><span class="freeform-example-number" aria-hidden="true">2</span><div><h4>Add two pages with these fields</h4><p>Page names are up to you. Match the handles below, or update the field references in this template.</p></div></div>
            <div class="freeform-example-requirements">
                {% set pageFields = [
                    { name: 'Your details', fields: [
                        { label: 'First name', type: 'Text', handle: 'firstName' },
                        { label: 'Last name', type: 'Text', handle: 'lastName' },
                        { label: 'Company', type: 'Text', handle: 'company' },
                    ] },
                    { name: 'Contact details', fields: [
                        { label: 'Email address', type: 'Email', handle: 'email' },
                        { label: 'Phone', type: 'Phone or Text', handle: 'phone' },
                        { label: 'State', type: 'Dropdown', handle: 'state' },
                        { label: 'Recipient', type: 'Dynamic Recipients', handle: 'recipients' },
                    ] },
                ] %}
                {% for page in pageFields %}
                    <section class="freeform-example-page" aria-labelledby="setup-page-{{ loop.index }}">
                        <div class="freeform-example-page-heading"><span>Page {{ loop.index }}</span><h4 id="setup-page-{{ loop.index }}">{{ page.name }}</h4></div>
                        <dl>{% for field in page.fields %}<div><dt>{{ field.label }}<small>{{ field.type }}</small></dt><dd><code>{{ field.handle }}</code></dd></div>{% endfor %}</dl>
                        {% if loop.index == 2 %}<p>Add options to State and Recipient. Recipient options should have a name and email address.</p>{% endif %}
                    </section>
                {% endfor %}
            </div>
            <div class="freeform-example-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v1"/></svg><p>Additional fields should be optional unless you also render them in this template. Required fields that aren’t displayed will prevent submission.</p></div>
        {% endblock %}
    {% endembed %}
    <p class="freeform-example-template-note">Template: <code>extras/manual-multipage.twig</code> · Includes manual inputs and Freeform’s label, input, and error helpers.</p>
    </article>
{% endblock %}
