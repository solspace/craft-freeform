{{ field.renderContainerOpeningTag }}

    {{ field.renderLabel }}
    {{ field.renderInstructions }}

    <ul class="w-full text-sm font-medium outline-1 -outline-offset-1 outline-gray-300 rounded-md flex">
        {% for scale in field.scales %}
            <li class="w-full">
                <input type="radio" name="{{ field.handle }}"
                    value="{{ scale.value }}"
                    id="{{ field.idAttribute }}-{{ loop.index }}"
                    {{ field.value == scale.value ? "checked" }}
                    class="hidden peer"
                 />
                <label for="{{ field.idAttribute }}-{{ loop.index }}"
                    class="inline-flex justify-center text-center font-medium w-full py-2 px-3 text-gray-900 bg-white cursor-pointer peer-checked:bg-indigo-600 peer-checked:outline-indigo-600 peer-checked:text-white hover:bg-indigo-100 peer-checked:hover:bg-indigo-500
                        {% if loop.index == 1 %}
                            border-r border-gray-300 rounded-tl rounded-bl
                        {% elseif loop.index == field.scales|length %}
                            rounded-tr rounded-br
                        {% else %}
                            border-r border-gray-300
                        {% endif %}">
                    {{ scale }}
                </label>
            </li>
        {% endfor %}
    </ul>

    {% if field.legends %}
        <ul class="flex w-full text-sm font-medium text-gray-500 mt-1">
            {% for legend in field.legends %}
                <li class="w-full
                    {% if loop.index == 1 %}
                        text-left
                    {% elseif loop.index == field.legends|length %}
                        text-right
                    {% else %}
                        text-center
                    {% endif %}">
                    {{ legend }}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {{ field.renderErrors }}

{{ field.renderContainerClosingTag }}
