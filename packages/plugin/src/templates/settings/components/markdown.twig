{% set id = 'markdown-'~craft.app.security.generateRandomString %}

<button type="button" class="markdown-show" onclick="document.getElementById('{{ id }}').click()">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M246.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-9.2-9.2-22.9-11.9-34.9-6.9s-19.8 16.6-19.8 29.6l0 256c0 12.9 7.8 24.6 19.8 29.6s25.7 2.2 34.9-6.9l128-128z"/></svg>
    <span>{{ "Show Setup Instructions"|t('freeform') }}</span>
</button>

<div class="markdown-instructions markdown-body inactive">
    <input class="markdown-toggle-checkbox" type="checkbox" class="hidden" id="{{ id }}" />
    <div class="markdown-container">
        <button type="button" class="markdown-collapse" onclick="document.getElementById('{{ id }}').click()">
            {{ "Collapse"|t('freeform') }}
        </button>

        <div class="markdown-content">
            {{ content|raw }}
        </div>
    </div>
</div>
