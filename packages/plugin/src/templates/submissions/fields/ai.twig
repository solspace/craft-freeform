{% import "_includes/forms" as forms %}

{% set aiValue = submission[field.handle] is not null ? submission[field.handle].value : '' %}
{% set displayValue = aiValue ?: 'Processing...' %}

{{ forms.textareaField({
    label: field.label,
    name: field.handle,
    id: field.handle,
    required: false,
    errors: submission.errors(field.handle),
    value: displayValue,
    readonly: true,
    rows: 3,
    class: 'ai-field-result',
}) }} 
