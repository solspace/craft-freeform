{% extends "freeform/_layouts/settings" %}

{% import "_includes/forms" as forms %}
{% import "freeform/_components/boolean-menu" as booleanMenu %}
{% import "freeform/_components/measurement" as measurement %}
{% import 'freeform/_components/settings-cards' as cards %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
] %}

{% set title = "Spam Protection"|t("freeform") %}

{% block content %}

    {{ parent() }}

    <form action="" method="post" accept-charset="UTF-8">
        <input type="hidden" name="action" value="freeform/settings/save-settings">
        {{ redirectInput('freeform/settings/spam') }}
        {{ csrfInput() }}

        {% set spamBehaviors = {
            simulate_success: {label:'Simulate Success', description:'Show the usual success response without revealing that spam was detected.', path:'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6ZM8 12l3 3 5-6'},
            display_errors: {label:'Display Errors', description:'Show spam errors to help troubleshoot protection settings. Use temporarily.', path:'M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0ZM10 6v5M10 14h.01'},
        } %}
        {% set spamBehaviorInput %}
            <div class="ff-choice-cards">
                {% for value, option in spamBehaviors %}
                    {% set icon %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="{{ option.path }}"/></svg>{% endset %}
                    {{ cards.compactChoice({id:'spam-protection-behavior-' ~ value, name:'settings[spamProtectionBehavior]', value:value, selected:settings.spamProtectionBehavior == value, recommended:value == 'simulate_success', disabled:readOnly, label:option.label|t('freeform'), description:option.description|t('freeform'), icon:icon}) }}
                {% endfor %}
            </div>
        {% endset %}
        {{ forms.field({
            id: "spam-protection-behavior",
            fieldset: true,
            label: "Spam Protection Behavior"|t('freeform'),
            instructions: "Select the behavior you'd like Freeform to take when it detects a submission as being spam."|t('freeform'),
            errors: settings.errors().get('spamProtectionBehavior'),
        }, spamBehaviorInput) }}

        {{ booleanMenu.field({
            includeEnvVars: true,
            label: "Skip Spam Checks for Logged-in Users"|t('freeform'),
            instructions: "Skip spam checks when the visitor is logged in to Craft."|t('freeform'),
            name: "settings[bypassSpamCheckOnLoggedInUsers]",
            value: settings.bypassSpamCheckOnLoggedInUsers,
            errors: settings.errors().get("bypassSpamCheckOnLoggedInUsers"),
            disabled: readOnly,
        }) }}

        <hr>

        <h2>{{ "Spam Folder"|t('freeform') }}</h2>

        {{ booleanMenu.field({
            includeEnvVars: true,
            label: "Use Spam Folder"|t('freeform'),
            instructions: "Keep flagged submissions in the Spam folder for review. Forms must be configured to store submission data."|t('freeform'),
            name: "settings[spamFolderEnabled]",
            value: settings.spamFolderEnabled,
            toggle: "spam-features",
            errors: settings.errors().get("spamFolderEnabled"),
            disabled: readOnly,
        }) }}

        <div id="spam-features" class="field {{ not settings.spamFolderEnabled ? 'hidden' }}">
            <div data-freeform-retention-setting>
                {{ forms.selectField({
                    label: "Automatically Delete Old Spam"|t('freeform'),
                    instructions: "Keep spam submissions for this many days. Cleanup is checked hourly when Freeform is accessed on the website or in the control panel."|t('freeform'),
                    name: "settings[purgableSpamAgeInDays]",
                    value: settings.purgableSpamAgeInDays,
                    errors: settings.errors().get("purgableSpamAgeInDays"),
                    disabled: readOnly,
                    id: "purge-value",
                    options: {
                        0: "Never"|t("freeform"),
                        1: "1 day"|t("freeform"),
                        2: "2 days"|t("freeform"),
                        3: "3 days"|t("freeform"),
                        4: "4 days"|t("freeform"),
                        5: "5 days"|t("freeform"),
                        6: "6 days"|t("freeform"),
                        7: "7 days"|t("freeform"),
                        14: "14 days"|t("freeform"),
                        30: "30 days"|t("freeform"),
                        60: "60 days"|t("freeform"),
                    }
                }) }}
                <div data-freeform-retention-details {{ not settings.purgableSpamAgeInDays ? 'hidden' }}>
                    <div data-freeform-retention-warning role="status" hidden>
                        {{ ui('callout', {variant: 'warning', content: "Saving this setting enables automatic deletion. Deleted spam submissions and their uploaded files cannot be recovered."|t('freeform')}) }}
                    </div>
                </div>
            </div>
        </div>

        <hr>

        <h2>{{ "Submission Limits"|t('freeform') }}</h2>

        {% set input %}
            <div class="freeform-throttling-inputs">
                {{ measurement.input({
                    id: "throttling-count",
                    name: "settings[submissionThrottlingCount]",
                    unit: "submissions"|t('freeform'),
                    value: settings.submissionThrottlingCount,
                    placeholder: "unlimited"|t('freeform'),
                    disabled: readOnly,
                }) }}

                {{ forms.select({
                    id: "throttling-time-frame",
                    name: "settings[submissionThrottlingTimeFrame]",
                    value: settings.submissionThrottlingTimeFrame,
                    disabled: readOnly,
                    options: {
                        m: "per minute"|t("freeform"),
                        s: "per second"|t("freeform"),
                    }
                }) }}
            </div>
        {% endset %}

        {{ forms.field({
            id: "throttling-count",
            label: "Submission Limit per Form"|t("freeform"),
            instructions: "Limit submissions to each form within the selected timeframe. The count is based on saved submissions and is shared across all users of that form. Leave empty or set to 0 for unlimited."|t("freeform"),
            errors: settings.errors().get("submissionThrottlingCount"),
            disabled: readOnly,
            warning: "Low limits can block legitimate submissions. The limit is shared by everyone submitting the same form."|t('freeform'),
        }, input) }}

        <hr>
        <h2>{{ "Submission Timing"|t('freeform') }}</h2>

        {{ measurement.field({
            label: "Minimum Submission Time"|t('freeform'),
            fieldClass: "freeform-submission-timing",
            instructions: "Require this many seconds between loading and submitting a form. Earlier submissions use your Spam Protection Behavior. Set to 0 to disable this check."|t('freeform'),
            name: "settings[minimumSubmitTime]",
            unit: "seconds"|t('freeform'),
            value: settings.minimumSubmitTime,
            errors: settings.errors().get("minimumSubmitTime"),
            disabled: readOnly,
        }) }}

        {{ measurement.field({
            label: "Maximum Submission Time"|t('freeform'),
            fieldClass: "freeform-submission-timing",
            instructions: "Allow this many minutes to submit a form after it loads. Later submissions use your Spam Protection Behavior. Set to 0 to disable this check."|t('freeform'),
            name: "settings[formSubmitExpiration]",
            unit: "minutes"|t('freeform'),
            value: settings.formSubmitExpiration,
            errors: settings.errors().get("formSubmitExpiration"),
            disabled: readOnly,
        }) }}

    </form>

{% endblock %}
