{
  "name": "@solspace/freeform-react",
  "version": "0.1.16",
  "description": "React components and hooks for Solspace Freeform headless forms",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "lint": "biome check src"
  },
  "devDependencies": {
    "@solspace/freeform-core": "workspace:*",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.8.3",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@solspace/freeform-core": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "freeform",
    "craft-cms",
    "headless",
    "react"
  ],
  "author": "Solspace Inc.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
