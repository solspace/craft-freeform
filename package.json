{
  "name": "root",
  "workspaces": [
    "packages/client",
    "packages/scripts",
    "packages/styles"
  ],
  "packageManager": "pnpm@10.17.1",
  "private": true,
  "description": "Freeform plugin for Craft CMS",
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "monaco-editor>dompurify": "3.3.2",
      "locutus@>=2.0.39 <3.0.25": ">=3.0.25",
      "locutus@<3.0.25": ">=3.0.25",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js-pure"
    ]
  },
  "scripts": {
    "dev": "concurrently -n client,scripts,styles \"pnpm --filter @ff/client dev\" \"pnpm --filter @ff/scripts dev\" \"pnpm --filter @ff/styles dev\"",
    "client": "pnpm --filter @ff/client dev",
    "front-end": "concurrently -n scripts,styles \"pnpm --filter @ff/scripts dev\" \"pnpm --filter @ff/styles dev\"",
    "build": "pnpm -r --if-present build",
    "format": "biome check --write",
    "format:verify": "biome check",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "prepare": "husky"
  },
  "author": "Solspace, Inc.",
  "license": "ISC"
}
