{% extends "freeform/_layouts/main" %}

{% set bodyClass = (bodyClass ?? [])|explodeClass|push('freeform-settings') %}

{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = (fullPageForm ?? true) and not (readOnly ?? false) %}
{% set saveShortcutRedirect = saveShortcutRedirect ?? craft.app.request.absoluteUrl %}
{% set retainScrollOnSaveShortcut = true %}
{% set formActions = formActions ?? [{
    label: 'Save and continue editing'|t('app'),
    redirect: saveShortcutRedirect|hash,
    shortcut: true,
    retainScroll: true,
}] %}

{% set navItems = craft.freeform.settingsNavigation %}

{% set segment2 = craft.app.request.getSegment(2) %}
{% set segment3 = craft.app.request.getSegment(3) %}
{% set segment4 = craft.app.request.getSegment(4) %}

{% set settingsCrumbItems = [] %}
{% for id, item in navItems %}
    {% if item.heading is not defined %}
        {% set settingsCrumbItems = settingsCrumbItems|merge([{
            label: item.title|striptags,
            url: cpUrl('freeform/settings/'~id),
            selected: id == segment3~(segment4 ? '/'~segment4),
        }]) %}
    {% endif %}
{% endfor %}
{% set crumbs = (crumbs ?? [
    {label: craft.freeform.name, url: cpUrl('freeform')},
    {label: 'Settings'|t('freeform'), url: cpUrl('freeform/settings')},
])|merge([{label: title, current: true, menu: {
    label: 'Select settings page'|t('freeform'),
    items: settingsCrumbItems,
}}]) %}

{% block actionButton %}
    {% if not readOnly %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block sidebar %}
    {% set segment = segment3~(segment4 ? '/'~segment4) %}
    {% set segment = segment|freeformRegexReplace('/\\/\\d+$/') %}
    {% set items = [] %}
    {% for id, item in navItems %}
        {% set items = items|merge([item.heading is defined ? item : {
            title: item.title,
            url: 'freeform/settings/'~id,
            selected: id == segment,
        }]) %}
    {% endfor %}
    {% include 'freeform/_components/secondary-navigation' with {
        label: 'Settings'|t('freeform'),
        items: items,
    } only %}
{% endblock %}

{% block contentNotice %}
    {% if readOnly ?? false %}
        {{ ui('callout', {
            variant: 'warning',
            content: 'Changes to these settings aren’t permitted in this environment.'|t('freeform'),
        }) }}
    {% endif %}
{% endblock %}

{# Child settings pages may call parent() before rendering their fields. #}
{% block content %}{% endblock %}
