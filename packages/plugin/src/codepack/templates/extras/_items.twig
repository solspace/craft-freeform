{# Keep the Extras menu and index tiles in the same order. #}
{% set examples = [
    {
        handle: "current-user-data",
        title: "Populate a form with Current User Data",
        description: "This example shows you how to populate a form with some User account values from the currently logged in user.",
    },
    {
        handle: "craft-entry-data",
        title: "Populate a form with Craft Entry Data",
        description: "This example shows how to populate some of a form's fields with some data from a Craft Entry.",
    },
    {
        handle: "date-pickers",
        title: "Adjustments to a Date Field Date/Time Picker",
        description: "This example shows some ways to manipulate a Date & Time field type using Freeform's developer events.",
    },
    {
        handle: "suppress-edit-submissions",
        title: "Suppress Notifications when Editing Submissions",
        description: "This example shows how to suppress email notifications and other integrations from being triggered when editing an existing submission.",
    },
    {
        handle: "js-override",
        title: "Overriding Freeform JS behavior",
        description: "This example shows how to manually override Freeform's built-in JS behavior inside a template.",
    },
    {
        handle: "submission-limit",
        title: "Setting Submission Limits",
        description: "This example shows how to set a limit for the number of submissions a form can have.",
    },
    {
        handle: "submission-duplicate",
        title: "Checking Submission Duplicates",
        description: "This example shows how to check if the user has already submitted the form when using the Limit Form Submission Rate setting.",
    },
    {
        handle: "twig-cache",
        title: "Twig Template Caching on Forms",
        description: "This example will show how to refresh the CSRF token and other parts of Freeform when using Twig Caching on a template that contains a form.",
    },
    {
        handle: "formatting-inside-template",
        title: "Formatting Directly Inside Regular Template",
        description: "This example shows how you can add formatting code directly inside a regular template.",
    },
    {
        handle: "manual-form",
        title: "Manual Rendering of Forms",
        description: "This example shows how to manually template a basic form.",
    },
    {
        handle: "manual-multipage",
        title: "Manual Multi-Page Forms",
        description: "This example shows how to manually template multi-page forms.",
    },
    {
        handle: "multiple-forms",
        title: "Multiple Forms in the Same Page",
        description: "This example shows how you might have the same form (or 2 similar ones) more than once in the same template.",
    },
    {
        handle: "parsley",
        title: "Form Validation with Parsley",
        description: "This example will show you how to implement form validation for your Freeform forms with Parsley JS.",
    },
    {
        handle: "relating-submission",
        title: "Relating Submissions to Elements",
        description: "This example will relate the newly created submission to another element via the Freeform Submission relation element field type.",
    },
    {
        handle: "form-field-type",
        title: "Freeform Form Element Field Type",
        description: "This example will show how to display and adjust forms that are assigned to Craft Entries via the Freeform Form element field type.",
    },
    {
        handle: "ajax-div-success",
        title: "Alternate Success Markup from Div after AJAX Submit",
        description: "This example shows how to override the default AJAX success message and load a success message from a `div` instead.",
    },
    {
        handle: "ajax-template-success",
        title: "Alternate Success from Template after AJAX Submit",
        description: "This example shows how to override the default AJAX success message and load a success message from another template instead.",
    },
    {
        handle: "override-return-url",
        title: "Overriding Success Return URL",
        description: "This example shows how to manipulate a form to allow a user to override the Return URL for successful submits.",
    },
    {
        handle: "success-same-page",
        title: "Returning Success to Same Page",
        description: "This example shows how to have a successful submit return to the same page with a success query in the URL.",
    },
] %}

{% for example in examples %}
    {% if mode == "navigation" %}
        <a href="{{ demoBaseUrl }}/extras/{{ example.handle }}"{% if craft.app.request.segment(baseUrlSegments + 2) == example.handle %} class="active" aria-current="page"{% endif %}>{{ example.title }}</a>
    {% elseif mode == "tiles" %}
        <a href="{{ demoBaseUrl }}/extras/{{ example.handle }}" class="freeform-form-tile-item">
            <h3 class="freeform-form-title">{{ example.title }}</h3>
            <p>{{ example.description }}</p>
        </a>
    {% endif %}
{% endfor %}
