{% import 'freeform/_components/activity-glyph' as activityIcons %}
    <div data-activity-results tabindex="-1" aria-label="{{ 'Activity results'|t('freeform') }}">
    {% if filters.submissionId %}<p class="ff-activity-submission-filter">{{ 'Showing submission #{id}'|t('freeform', {id:filters.submissionId}) }}</p>{% endif %}
    <div class="ff-activity-workspace">
        <section class="ff-activity-list" aria-label="{{ 'Activity events'|t('freeform') }}">
            <div class="ff-activity-list-heading"><div><h3>{{ 'Recent activity'|t('freeform') }}</h3><span>{{ activityView == 'submissions' ? ((filters.q or filters.category or filters.level) ? 'Submissions with matching events'|t('freeform') : 'Submission events grouped together'|t('freeform')) : 'Newest first'|t('freeform') }}</span></div><span class="ff-activity-count">{{ '{count} total'|t('freeform', {count:total|number}) }}</span></div>
            <div class="ff-activity-events">
            {% for row in rows %}
                <a data-level="{{ row.level }}" class="ff-activity-event {{ selected and selected.chainKey == row.chainKey ? 'is-selected' }}" href="{{ cpUrl('freeform/activity', filters|merge({before:before, after:after, page:pageNumber, eventId:row.id})) }}" {{ selected and selected.chainKey == row.chainKey ? 'aria-current="true"' }}>
                    {{ activityIcons.glyph(row.event, row.level) }}
                    <span class="ff-activity-event-content"><span class="ff-activity-event-category">{{ row.isChain ?? false ? 'Submission activity'|t('freeform') : (names[row.category] ?? row.category)|t('freeform') }}{% if row.isChain ?? false %}<span class="ff-activity-chain-outcome" data-level="{{ row.level }}">{{ row.level == 'error' ? 'Had errors'|t('freeform') : (row.level == 'warning' ? 'Had warnings'|t('freeform') : 'Events recorded'|t('freeform')) }}</span>{% elseif row.level == 'error' %}<span class="ff-activity-chain-outcome" data-level="error">{{ 'Error'|t('freeform') }}</span>{% endif %}<span class="visually-hidden"> · {{ (levels[row.level] ?? row.level)|t('freeform') }}</span></span><strong>{{ row.title }}</strong><span class="ff-activity-event-meta">{{ row.formId ? forms[row.formId] ?? 'Deleted form'|t('freeform') : (names[row.category] ?? 'System')|t('freeform') }}{% if row.submissionId %}<span class="ff-activity-submission-id">#{{ row.submissionId }}</span>{% endif %}{% if row.isChain ?? false %}<span class="ff-activity-chain-count">{{ row.chainCount == 1 ? '1 event'|t('freeform') : '{count} events'|t('freeform', {count:row.chainCount}) }}</span>{% endif %}</span></span>
                    <span class="ff-activity-event-end"><time datetime="{{ (row.latestDate ?? row.dateCreated)|date('c', 'UTC') }}" title="{{ (row.latestDate ?? row.dateCreated)|datetime('short') }}"><span>{{ (row.latestDate ?? row.dateCreated)|date('short') }}</span><span>{{ (row.latestDate ?? row.dateCreated)|time('short') }}</span></time><span class="ff-activity-event-arrow" aria-hidden="true">→</span></span>
                </a>
            {% else %}
                <div class="ff-activity-empty"><span class="ff-activity-empty-art" aria-hidden="true">{{ activityIcons.glyph('submission', 'success') }}</span><h3>{{ 'No activity to show'|t('freeform') }}</h3><p>{{ 'New events appear here when they match your recording settings. Try clearing the filters, or check your logging mode.'|t('freeform') }}</p></div>
            {% endfor %}
            </div>
        </section>
        <aside class="ff-activity-detail" aria-label="{{ 'Event details'|t('freeform') }}" data-level="{{ selected.level ?? 'info' }}">
            {% if selected %}
                <div class="ff-activity-detail-header">
                    <div class="ff-activity-detail-heading"><span>{{ 'Event details'|t('freeform') }}</span><span class="ff-activity-status" data-level="{{ selected.level }}">{{ (levels[selected.level] ?? selected.level)|t('freeform') }}</span></div>
                    <div class="ff-activity-detail-title">{{ activityIcons.glyph(selected.event, selected.level) }}<h2>{{ selected.title }}</h2></div>
                    <p class="ff-activity-description">{{ selected.description }}</p>
                </div>
                <div class="ff-activity-detail-body">
                    {% if selected.context %}<section class="ff-activity-context-panel"><h3 class="ff-activity-section-label">{{ 'Event context'|t('freeform') }}</h3><dl class="ff-activity-facts ff-activity-context">{% for label,value in selected.context %}<dt>{{ label }}</dt><dd>{{ value }}</dd>{% endfor %}</dl></section>{% endif %}
                    {% if selected.changes %}<section class="ff-activity-context-panel"><h3 class="ff-activity-section-label">{{ 'Changes recorded'|t('freeform') }}</h3><dl class="ff-activity-facts ff-activity-changes">{% for label,count in selected.changes %}<dt>{{ label }}</dt><dd>{{ count }}</dd>{% endfor %}</dl></section>{% endif %}
                    {% if selected.event == 'form-change' and selected.metadata.summaryIncomplete is defined %}<p class="light">{{ 'This summary may be missing some changes. It covers fields, pages, form settings, notifications, and integrations.'|t('freeform') }}</p>{% endif %}
                    <dl class="ff-activity-facts ff-activity-record-facts"><dt>{{ 'Event'|t('freeform') }}</dt><dd>#{{ selected.id }}</dd><dt>{{ 'Recorded'|t('freeform') }}</dt><dd>{{ selected.dateCreated|datetime('short') }}</dd><dt>{{ 'Category'|t('freeform') }}</dt><dd>{{ (names[selected.category] ?? selected.category)|t('freeform') }}</dd>{% if selected.formId %}<dt>{{ 'Form'|t('freeform') }}</dt><dd>{{ forms[selected.formId] ?? 'Deleted form'|t('freeform') }} <span class="light">#{{ selected.formId }}</span></dd>{% endif %}{% if selected.submissionId %}<dt>{{ 'Submission'|t('freeform') }}</dt><dd>{% if canReadSubmission %}<a href="{{ cpUrl('freeform/submissions/' ~ selected.submissionId) }}">#{{ selected.submissionId }}</a>{% else %}#{{ selected.submissionId }}{% endif %}</dd>{% endif %}</dl>
                    <div class="ff-activity-detail-actions">
                        {% if selected.submissionId %}<a class="btn ff-activity-related" href="{{ cpUrl('freeform/activity', {submissionId:selected.submissionId, formId:selected.formId}) }}">{{ 'View submission activity'|t('freeform') }} <span aria-hidden="true">→</span></a>{% endif %}
                        {% if selected.category == 'integrations' and canAccessIntegrations %}<a class="btn" href="{{ cpUrl('freeform/integrations') }}">{{ 'Review integrations'|t('freeform') }}</a>{% endif %}
                        {% if selected.category == 'email' and canManageForm and forms[selected.formId] is defined %}<a class="btn" href="{{ cpUrl('freeform/forms/' ~ selected.formId ~ '/notifications') }}">{{ 'Review notifications'|t('freeform') }}</a>{% endif %}
                    </div>
                    {% if timeline %}<section class="ff-activity-timeline"><div class="ff-activity-timeline-heading"><h3>{{ 'Submission timeline'|t('freeform') }}</h3><span class="ff-activity-count">{{ timeline|length }}</span></div><p class="light">{{ 'Latest 30 recorded events'|t('freeform') }}</p><ol>{% for step in timeline %}<li><a class="ff-activity-timeline-step {{ selected.id == step.id ? 'is-current' }}" href="{{ cpUrl('freeform/activity', filters|merge(activityView == 'events' ? {before:0, view:'submissions', submissionId:step.submissionId, formId:step.formId, eventId:step.id} : {before:before, after:after, page:pageNumber, eventId:step.id})) }}" {{ selected.id == step.id ? 'aria-current="true"' }}>{{ activityIcons.glyph(step.event, step.level) }}<span><strong>{{ step.title }}</strong><time datetime="{{ step.dateCreated|date('c', 'UTC') }}">{{ step.dateCreated|datetime('short') }}</time></span></a></li>{% endfor %}</ol></section>{% endif %}
                    <details class="ff-activity-technical"><summary>{{ 'Technical details'|t('freeform') }}</summary><pre>{{ {eventId:selected.id, type:selected.event, recordedAt:selected.recordedAt, formId:selected.formId, submissionId:selected.submissionId, metadata:selected.metadata}|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre><p>{{ 'Activity excludes raw messages, payloads, credentials, field values, addresses, and IP addresses.'|t('freeform') }}</p></details>
                    <button class="btn ff-activity-copy" type="button" data-activity-copy="{{ {eventId:selected.id, type:selected.event, recordedAt:selected.recordedAt, formId:selected.formId, submissionId:selected.submissionId, metadata:selected.metadata}|json_encode(constant('JSON_PRETTY_PRINT')) }}"><span data-icon="clipboard" aria-hidden="true"></span>{{ 'Copy support summary'|t('freeform') }}</button><p class="ff-activity-copy-status" data-copy-status role="status" data-success="{{ 'Support summary copied.'|t('freeform') }}" data-failure="{{ 'Copy unavailable. Select the text in Technical details to copy it.'|t('freeform') }}"></p>
                </div>
            {% else %}<div class="ff-activity-detail-placeholder">{{ activityIcons.glyph('integration-response', 'info') }}<h3>{{ 'Event details'|t('freeform') }}</h3><p>{{ 'Select an event to inspect its outcome and related submission timeline.'|t('freeform') }}</p></div>{% endif %}
        </aside>
    </div>
    <div class="ff-activity-bottom">{% include '_includes/pagination' with {pageInfo:pageInfo, itemLabel:activityView == 'events' ? 'event'|t('freeform') : 'activity'|t('freeform'), itemsLabel:activityView == 'events' ? 'events'|t('freeform') : 'activities'|t('freeform')} only %}<button class="btn" type="button" data-activity-export aria-haspopup="dialog" aria-controls="activity-export-dialog" {{ not total ? 'disabled' }}>{{ 'Export…'|t('freeform') }}</button></div>
    </div>
