{% extends "demo/_layout" %}

{% set pageTitle = "Alternate Success from Template after AJAX Submit | Examples" %}

{# Replace 'freeformAjaxTemplateSuccess' with your form handle #}
{% set demoFormHandle = "freeformAjaxTemplateSuccess" %}

{% block content %}

    {% set form = freeform.form(demoFormHandle, { formattingTemplate: pageTemplateFile }) %}

    <article class="freeform-form-browser freeform-example-detail" aria-labelledby="example-title">
    {% set exampleDescription %}This example shows how to override the default AJAX success message and load a success message from another template instead.{% endset %}
    {% include "demo/extras/_items.twig" with { mode: 'header', exampleHandle: 'ajax-template-success' } %}

    {% if form %}
        <section class="freeform-submissions-panel freeform-example-demo-panel" aria-labelledby="live-example-title">
            <div class="freeform-submissions-toolbar"><h3 id="live-example-title">Try the example</h3></div>
            <div class="freeform-example-demo-body">

        <div id="extras-form-wrapper">
            {{ form.render }}
        </div>

            </div>
        </section>

    {% else %}

        {% set setupNoticeMessage %}<p>Use a form with the handle <code>{{ demoFormHandle }}</code> to run this example.</p>{% endset %}
        {% include "demo/extras/_setup-notice.twig" %}

    {% endif %}

    {# Instructions to get this page working correctly #}
    {% embed "demo/extras/_setup.twig" %}
        {% block instructions %}
        <ol>
            <li>Rename your test form handle to <code>{{ demoFormHandle }}</code> or adjust the form handle name inside this template to match your test form.</li>
        </ol>
        <p class="freeform-example-instruction-note">
            Please note that using the <b>Load Success Template</b> option for the <b>Success Behavior</b> setting will override this. It's also worth noting that feature supersedes this approach.
        </p>
        {% endblock %}
    {% endembed %}
    <p class="freeform-example-template-note">Template: <code>extras/ajax-template-success.twig</code></p>
    </article>

{% endblock %}

{% block footerJs %}

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script type="text/javascript">
        // Find the form element, can be a specific ID or just look for any forms
        var form = $('form[data-id]');
        form.on('freeform-render-success', function (event) {
            // Disable the default success rendering
            event.preventDefault();

            // We locate the 'form-wrapper' DIV element which contains our form
            // and we swap its contents (the whole form) with the HTML that we
            // fetch from the "/demo/extras/responses/ajax-success-message" template
            $('#extras-form-wrapper').load('{{ siteUrl }}demo/extras/responses/ajax-success-message');
        });
    </script>

{% endblock %}
