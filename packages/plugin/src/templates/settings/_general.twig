{% extends "freeform/_layouts/settings" %}

{% import "_includes/forms" as forms %}
{% import "freeform/_components/boolean-menu" as booleanMenu %}
{% import "freeform/_components/settings-cards" as cards %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
] %}

{% set title = "General Settings"|t("freeform") %}

{% block content %}

	{{ parent() }}

	<input type="hidden" name="action" value="freeform/settings/save-settings">
	{{ redirectInput('freeform/settings/general') }}
	{{ csrfInput() }}

	{% if craft.freeform.pro %}

		{{ forms.textField({
            class: "code",
            label: "Plugin Name"|t('freeform'),
            instructions: "The name shown for Freeform in the control panel."|t('freeform'),
            placeholder: craft.freeform.name,
            id: "pluginName",
            name: "settings[pluginName]",
            value: settings.pluginName,
            errors: settings.getErrors("pluginName"),
            disabled: readOnly,
        }) }}

	{% endif %}

    {% set defaultViews = {
        forms: {label:'Forms', description:'Create and organize forms, or open the builder to edit fields and settings.', available:currentUser.can(constant('Solspace\\Freeform\\Freeform::PERMISSION_FORMS_ACCESS')), path:'M4 4h16v16H4ZM8 8h8M8 12h8M8 16h5'},
        submissions: {label:'Submissions', description:'Search and filter submissions, review their details, and export your form data.', available:currentUser.can(constant('Solspace\\Freeform\\Freeform::PERMISSION_SUBMISSIONS_ACCESS')), path:'M4 4h16v16H4ZM4 13h5l2 3h2l2-3h5'},
        spam: {label:'Spam', description:'Review flagged submissions and approve genuine responses.', available:currentUser.can(constant('Solspace\\Freeform\\Freeform::PERMISSION_SUBMISSIONS_ACCESS')) and craft.freeformServices.settings.isSpamFolderEnabled(), path:'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6ZM9 10l6 6M15 10l-6 6'},
        'ab-tests': {label:'A/B Tests', description:'Manage form experiments and compare conversion rates.', available:currentUser.can(constant('Solspace\\Freeform\\Freeform::PERMISSION_AB_ACCESS')) and craft.freeform.pro and craft.freeformServices.settings.isAbTestsEnabled(), path:'M12 3v5M6 8h12M6 8v5M18 8v5M3 14h6v7H3ZM15 14h6v7h-6Z'},
    } %}
    {% set defaultViewInput %}
        <div class="ff-choice-cards">
            {% for value, option in defaultViews %}
                {% if option.available %}
                    {% set icon %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="{{ option.path }}"/></svg>{% endset %}
                    {{ cards.compactChoice({id:'default-view-' ~ value, name:'settings[defaultView]', value:value, selected:settings.defaultView == value, disabled:readOnly, label:option.label|t('freeform'), description:option.description|t('freeform'), icon:icon}) }}
                {% endif %}
            {% endfor %}
        </div>
    {% endset %}
    {{ forms.field({
        id:'default-view',
        name: 'settings[defaultView]',
        fieldset:true,
        label: "Default View"|t('freeform'),
        instructions: "The default page to go to when clicking the Freeform nav item."|t('freeform'),
        errors: settings.errors().get("defaultView"),
    }, defaultViewInput) }}

    {% set badgeOptions = {
        errors: {label: 'Logged Errors', description: 'Shows recorded errors to help you spot and troubleshoot problems.', path: 'M12 3 2 21h20ZM12 9v5M12 17h.01'},
        submissions: {label: 'Submissions', description: 'Shows the total number of saved submissions, excluding spam.', path: 'M4 4h16v16H4ZM4 13h5l2 3h2l2-3h5'},
        spam: {label: 'Spam Folder', description: 'Shows the number of submissions held in the Spam folder.', path: 'M12 3 20 6v6c0 5-8 9-8 9s-8-4-8-9V6ZM9 9l6 6m0-6-6 6'},
        '': {label: 'None', description: 'Hides the badge beside Freeform in the control panel.', path: 'M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0ZM6 6l12 12'},
    } %}
    {% set badgeInput %}
        <div class="ff-badge-choices"><div class="ff-choice-cards" data-columns="4">
            {% for value, option in badgeOptions %}
                {% set icon %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="{{ option.path }}"/></svg>{% endset %}
                {{ cards.compactChoice({
                    id: 'plugin-badge-' ~ (value ?: 'off'),
                    name: 'settings[badgeType]',
                    value: value,
                    selected: settings.badgeType == value,
                    recommended: value == 'errors',
                    disabled: readOnly,
                    label: option.label|t('freeform'),
                    description: option.description|t('freeform'),
                    icon: icon,
                }) }}
            {% endfor %}
        </div></div>
    {% endset %}
    {{ forms.field({
        id: 'plugin-badge',
        fieldset: true,
        label: "Plugin Badge"|t('freeform'),
        instructions: "Choose what the badge beside Freeform in the control panel counts."|t('freeform'),
        errors: settings.errors().get("badgeType"),
    }, badgeInput) }}

	{% if craft.freeform.pro %}

		{{ booleanMenu.field({
            includeEnvVars: true,
            label: "Site-Aware Forms"|t('freeform'),
            instructions: "Make forms aware of the active Craft site and respect users’ site permissions in the control panel. New forms are available only on the site where they’re created; additional sites can be enabled for each form."|t('freeform'),
            name: "settings[sitesEnabled]",
            value: settings.sitesEnabled,
            errors: settings.errors().get("sitesEnabled"),
            disabled: readOnly,
            tip: "To enable translations on forms per Site, go to the form builder and enable the 'Translatable' setting under the 'Settings' tab."|t('freeform'),
        }) }}

		{{ booleanMenu.field({
            includeEnvVars: true,
            label: "A/B Testing"|t('freeform'),
            instructions: "When enabled, the `A/B Tests` section appears in the Freeform navigation and allows you to create A/B tests for your forms. Disable this to hide the section if you do not plan to use this feature."|t('freeform'),
            name: "settings[abTests]",
            value: settings.abTests,
            errors: settings.errors().get("abTests"),
            disabled: readOnly,
        }) }}

	{% endif %}



	<hr>

	<h2>{{ "Submission Data"|t('freeform') }}</h2>

	{{ booleanMenu.field({
        includeEnvVars: true,
        label: "Update Submission Search Indexes"|t('freeform'),
        instructions: "Update Craft’s search index when submissions are saved."|t('freeform'),
        name: "settings[updateSearchIndexes]",
        value: settings.updateSearchIndexes,
        errors: settings.errors().get("updateSearchIndexes"),
        disabled: readOnly,
    }) }}

	{% if craft.freeform.pro %}

        <div data-freeform-retention-setting>
			{{ forms.selectField({
                label: "Automatically Delete Old Submissions"|t('freeform'),
                instructions: "Keep submissions for this many days. Cleanup is checked hourly when Freeform is accessed on the website or in the control panel."|t('freeform'),
                name: "settings[purgableSubmissionAgeInDays]",
                value: settings.purgableSubmissionAgeInDays,
                errors: settings.errors().get("purgableSubmissionAgeInDays"),
                disabled: readOnly,
                id: "purge-value",
                options: {
                    0: "Never"|t("freeform"),
                    1: "1 day"|t("freeform"),
                    2: "2 days"|t("freeform"),
                    3: "3 days"|t("freeform"),
                    4: "4 days"|t("freeform"),
                    5: "5 days"|t("freeform"),
                    6: "6 days"|t("freeform"),
                    7: "7 days"|t("freeform"),
                    14: "14 days"|t("freeform"),
                    30: "30 days"|t("freeform"),
                    60: "60 days"|t("freeform"),
                    90: "90 days"|t("freeform"),
                    120: "120 days"|t("freeform"),
                    180: "180 days"|t("freeform"),
                    365: "365 days"|t("freeform"),
                }
            }) }}

            <div data-freeform-retention-details {{ not settings.purgableSubmissionAgeInDays ? 'hidden' }}>
                <div data-freeform-retention-warning role="status" hidden>
                    {{ ui('callout', {variant: 'warning', content: "Saving this setting enables automatic deletion. Deleted submissions and their uploaded files cannot be recovered."|t('freeform')}) }}
                </div>

			{{ forms.checkboxSelectField({
                id: "purge-forms",
                label: "Apply to Forms"|t('freeform'),
                instructions: "Choose which forms automatic submission deletion applies to."|t('freeform'),
                name: "settings[purgableFormIds]",
                values: settings.purgableFormIds is null ? '*' : settings.purgableFormIds,
                showAllOption: true,
                options: forms|sort,
                errors: settings.errors().get("purgableFormIds"),
            }) }}
            </div>
		</div>

	{% endif %}

		{{ forms.selectField({
            label: "Automatically Delete Old Unsubmitted Uploads"|t('freeform'),
            instructions: "Choose how long to keep unsubmitted uploads before deleting them."|t('freeform'),
            name: "settings[purgableUnfinalizedAssetAgeInMinutes]",
            value: settings.purgableUnfinalizedAssetAgeInMinutes,
            errors: settings.getErrors("purgableUnfinalizedAssetAgeInMinutes"),
            disabled: readOnly,
            id: "purgableUnfinalizedAssetAgeInMinutes",
            options: {
                0: "Never"|t("freeform"),
                60: "1 hour"|t("freeform"),
                120: "2 hours"|t("freeform"),
                180: "3 hours (recommended)"|t("freeform"),
                240: "4 hours"|t("freeform"),
                480: "8 hours"|t("freeform"),
                720: "12 hours"|t("freeform"),
                1440: "24 hours"|t("freeform"),
                2880: "48 hours"|t("freeform"),
                4320: "72 hours"|t("freeform"),
                10080: "1 week"|t("freeform"),
                20160: "2 weeks"|t("freeform"),
            }
        }) }}

{% endblock %}
