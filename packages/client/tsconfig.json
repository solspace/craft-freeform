{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../plugin/src/Resources/js/client/",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": [
      "config/@types",
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      "@config/*": ["client/config/*"],
      "@editor/*": ["client/src/app/pages/forms/edit/*"],
      "@components/*": ["client/src/app/components/*"],
      "@form-controls/*": ["client/src/app/components/form-controls/*"],
      "@ff-icons/*": ["client/src/assets/icons/*"],
      "@ff-client/*": ["client/src/*"],
      "@ff-widgets/*": ["scripts/src/lib/cp/widgets/*"],
      "@ff-dark-mode-tip": ["scripts/src/lib/cp/dark-mode-tip.ts"],
      "@ff-dark-mode-tip-styles": ["styles/src/shared/dark-mode-tip.css"],
      "@ff-chart-styles": ["styles/src/shared/chart.css"],
      "@ff-empty-state-styles": ["styles/src/shared/empty-state.css"]
    }
  },
  "exclude": ["node_modules"]
}
