{% extends "freeform/_layouts/settings" %}

{% import "_includes/forms" as forms %}

{% set segment3 = craft.app.request.getSegment(3) %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
    { label: "Reliability"|t("freeform"), url: url("freeform/settings" ~ "/" ~ segment3) },
] %}

{% set title = "Diagnostics"|t("freeform") %}

{% block actionButton %}{% endblock %}

{% macro renderIcon(type) %}
    {%- if type == 'WarningValidator' -%}
        <svg aria-hidden="true" viewbox="0 0 576 512">
            <path fill="currentColor" d="M569.517 440.013C587.975 472.007 564.806 512 527.94 512H48.054c-36.937 0-59.999-40.055-41.577-71.987L246.423 23.985c18.467-32.009 64.72-31.951 83.154 0l239.94 416.028zM288 354c-25.405 0-46 20.595-46 46s20.595 46 46 46 46-20.595 46-46-20.595-46-46-46zm-43.673-165.346l7.418 136c.347 6.364 5.609 11.346 11.982 11.346h48.546c6.373 0 11.635-4.982 11.982-11.346l7.418-136c.375-6.874-5.098-12.654-11.982-12.654h-63.383c-6.884 0-12.356 5.78-11.981 12.654z"></path>
        </svg>
    {%- elseif type == 'SuggestionValidator' -%}
        <svg aria-hidden="true" viewbox="0 0 352 512">
            <path fill="currentColor" d="M96.06 454.35c.01 6.29 1.87 12.45 5.36 17.69l17.09 25.69a31.99 31.99 0 0 0 26.64 14.28h61.71a31.99 31.99 0 0 0 26.64-14.28l17.09-25.69a31.989 31.989 0 0 0 5.36-17.69l.04-38.35H96.01l.05 38.35zM0 176c0 44.37 16.45 84.85 43.56 115.78 16.52 18.85 42.36 58.23 52.21 91.45.04.26.07.52.11.78h160.24c.04-.26.07-.51.11-.78 9.85-33.22 35.69-72.6 52.21-91.45C335.55 260.85 352 220.37 352 176 352 78.61 272.91-.3 175.45 0 73.44.31 0 82.97 0 176zm176-80c-44.11 0-80 35.89-80 80 0 8.84-7.16 16-16 16s-16-7.16-16-16c0-61.76 50.24-112 112-112 8.84 0 16 7.16 16 16s-7.16 16-16 16z"></path>
        </svg>
    {%- endif -%}
{% endmacro %}

{% macro renderItems(items, sectionTitle) %}
    <ul>
        {%- for key, item in items -%}
            {%- if item is iterable or item.markup -%}
                <li>
                    {% if item is iterable %}

                        <h3>{{ key }}</h3>
                        {{ _self.renderItems(item, sectionTitle) }}

                    {% else %}

                        <div class="items">
                            <div class="item {{ item.validationClasses|join(' ') }}">
                                {% if sectionTitle == 'Modules' %}
                                    <code>
                                        {{ item.markup }}
                                    </code>
                                {% elseif sectionTitle in ['Integrations', 'Form Types'] %}
                                    <span class="item-inline">
                                        {{ item.markup }}
                                    </span>
                                {% else %}
                                    {{ item.markup }}
                                {% endif %}

                                {% if item.warnings %}
                                    {{ _self.renderIcon('WarningValidator') }}
                                {% endif %}

                                {% if item.suggestions %}
                                    {{ _self.renderIcon('SuggestionValidator') }}
                                {% endif %}
                            </div>
                        </div>

                        {% if item.allValidators %}
                            <ul class="validators">
                                {% for validator in item.allValidators %}
                                    <li class="{{ validator.type|lower }}">
                                        {{ validator.message }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                    {% endif %}
                </li>
            {%- endif -%}
        {%- endfor -%}
    </ul>
{% endmacro %}

{% block content %}

    {{ parent() }}

    {% if not warnings|length %}
        <div class="banner banner-check">
            <h2>
                <svg viewbox="0 0 32 32"><path fill="currentColor" d="M11.941 28.877 0 16.935l5.695-5.695 6.246 6.246L26.305 3.123 32 8.818z"/></svg>

                {{ "All checks passed!"|t('freeform') }}
            </h2>
        </div>
    {% endif %}

    {% for noticeType, noticeData in {'Warnings': warnings, 'Suggestions': suggestions} %}
        {% if noticeData|length %}
            <div class="banner banner-{{ noticeType|lower }}">
                <h2>
                    {{ _self.renderIcon(noticeData[0].type) }}
                    {{ noticeData|length }}
                    {{ noticeType|t('freeform') }}
                </h2>
            </div>
        {% endif %}
    {% endfor %}

    <div class="gridy">
        {% set leftSections = [
            {'title': "Server Checks"|t('freeform'), 'items': server},
            {'title': "Database Checks"|t('freeform'), 'items': database},
            {'title': "Site Settings"|t('freeform'), 'items': site}
        ] %}
        <div class="diag">
            {% for section in leftSections %}
                {% if section.items|length > 0 %}
                    <div class="diag-list{{ section.title == "Statistics" ? " diag-no-margin" }}">
                        <h2>{{ section.title }}</h2>
                        {{ _self.renderItems(section.items) }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% set centerSections = [
            {'title': "Freeform Configuration"|t('freeform'), 'items': configurations}
        ] %}
        <div class="diag">
            {% for section in centerSections %}
                {% if section.items|length > 0 %}
                    <div class="diag-list">
                        <h2>{{ section.title }}</h2>
                        {{ _self.renderItems(section.items) }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% set rightSections = [
            {'title': "Statistics"|t('freeform'), 'items': stats},
            {'title': "Integrations"|t('freeform'), 'items': integrations},
            {'title': "Form Types"|t('freeform'), 'items': formType},
            {'title': "Modules"|t('freeform'), 'items': modules}
        ] %}
        <div class="diag">
            {% for section in rightSections %}
                {% if section.items|length > 0 %}
                    <div class="diag-list diag-no-margin">
                        <h2>{{ section.title }}</h2>
                        {{ _self.renderItems(section.items, section.title) }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
    <hr>
    <section id="freeform-orphan-scan" aria-labelledby="freeform-orphan-scan-heading">
        <h2 id="freeform-orphan-scan-heading">{{ "Orphaned Submissions"|t('freeform') }}</h2>
        <p>{{ "Check for submission records whose Craft element or form no longer exists. This read-only scan runs only when requested and may take time on large sites."|t('freeform') }}</p>
        <button type="button" class="btn" id="freeform-orphan-scan-button">{{ "Scan for orphaned submissions"|t('freeform') }}</button>
        <span class="spinner hidden" id="freeform-orphan-scan-spinner" aria-hidden="true"></span>
        <p id="freeform-orphan-scan-status" role="status" aria-live="polite"></p>
        <p id="freeform-orphan-scan-guide" hidden>
            {{ "For a full database check and repair instructions, see the"|t('freeform') }}
            <a href="https://docs.solspace.com/craft/freeform/v5/guides/database-integrity/" target="_blank" rel="noopener">{{ "database integrity guide"|t('freeform') }}</a>.
        </p>
    </section>

    <hr>
    <section id="freeform-related-scan" aria-labelledby="freeform-related-scan-heading">
        <h2 id="freeform-related-scan-heading">{{ "Related Data Integrity"|t('freeform') }}</h2>
        <p>{{ "Check related form data and other records for missing parents, and check duplicate values where a unique constraint is missing. Orphan checks run in batches; duplicate checks may take longer on large tables. No data is changed."|t('freeform') }}</p>
        <button type="button" class="btn" id="freeform-related-scan-button">{{ "Scan related data and duplicates"|t('freeform') }}</button>
        <span class="spinner hidden" id="freeform-related-scan-spinner" aria-hidden="true"></span>
        <p id="freeform-related-scan-status" role="status" aria-live="polite"></p>
        <ul id="freeform-related-scan-results"></ul>
        <p id="freeform-related-scan-guide" hidden>
            <a href="https://docs.solspace.com/craft/freeform/v5/guides/database-integrity/" target="_blank" rel="noopener">{{ "Database integrity guide"|t('freeform') }}</a>
        </p>
    </section>

    {% js %}
        (() => {
            const section = document.getElementById('freeform-orphan-scan');
            const button = document.getElementById('freeform-orphan-scan-button');
            const spinner = document.getElementById('freeform-orphan-scan-spinner');
            const status = document.getElementById('freeform-orphan-scan-status');
            const guide = document.getElementById('freeform-orphan-scan-guide');
            const messages = {{ {
                starting: "Scanning submissions…"|t('freeform'),
                progress: "Scanned {scanned} submissions; found {affected} orphaned submissions so far."|t('freeform'),
                complete: "Scan complete: {affected} orphaned submissions found among {scanned} checked."|t('freeform'),
                failed: "The scan could not be completed. Partial results: {affected} orphaned submissions found among {scanned} checked. Try again or run the console utility."|t('freeform')
            }|json_encode|raw }};

            button.addEventListener('click', async () => {
                button.disabled = true;
                spinner.classList.remove('hidden');
                section.setAttribute('aria-busy', 'true');
                guide.hidden = true;
                status.textContent = messages.starting;
                let cursor = 0;
                let maxId = null;
                let scanned = 0;
                let affected = 0;
                const format = (message) => message.replace('{scanned}', scanned.toLocaleString()).replace('{affected}', affected.toLocaleString());

                try {
                    while (true) {
                        const response = await Craft.sendActionRequest('POST', 'freeform/diagnostics/scan-orphaned-submissions', {
                            data: { cursor, maxId }
                        });
                        const batch = response.data;
                        if (batch.error || !Number.isInteger(batch.scanned) || !Number.isInteger(batch.affected)) {
                            throw new Error('Scan failed');
                        }
                        cursor = batch.cursor;
                        maxId = batch.maxId;
                        scanned += batch.scanned;
                        affected += batch.affected;
                        status.textContent = format(batch.complete ? messages.complete : messages.progress);
                        if (batch.complete) break;
                    }
                } catch (error) {
                    status.textContent = format(messages.failed);
                } finally {
                    button.disabled = false;
                    spinner.classList.add('hidden');
                    section.setAttribute('aria-busy', 'false');
                    guide.hidden = false;
                }
            });
        })();
    {% endjs %}

    {% js %}
        (() => {
            const section = document.getElementById('freeform-related-scan');
            const button = document.getElementById('freeform-related-scan-button');
            const spinner = document.getElementById('freeform-related-scan-spinner');
            const status = document.getElementById('freeform-related-scan-status');
            const results = document.getElementById('freeform-related-scan-results');
            const guide = document.getElementById('freeform-related-scan-guide');
            const messages = {{ {
                starting: "Scanning related data…"|t('freeform'),
                progress: "Completed {completed} of {total} checks; examined {scanned} related records."|t('freeform'),
                complete: "Scan complete: {orphans} orphaned related rows; {duplicates} rows in duplicate groups; {skipped} checks could not be completed."|t('freeform'),
                failed: "The scan could not be completed. Results below are partial. Try again or ask your developer to investigate."|t('freeform'),
                orphans: "{count} orphaned rows"|t('freeform'),
                duplicates: "{count} rows in duplicate groups"|t('freeform'),
                skipped: "Could not check"|t('freeform')
            }|json_encode|raw }};
            const format = (message, values) => Object.entries(values).reduce((text, [key, value]) => text.replace('{' + key + '}', value.toLocaleString()), message);

            button.addEventListener('click', async () => {
                button.disabled = true;
                spinner.classList.remove('hidden');
                section.setAttribute('aria-busy', 'true');
                guide.hidden = true;
                results.replaceChildren();
                status.textContent = messages.starting;
                let scanId = null;
                try {
                    while (true) {
                        const response = await Craft.sendActionRequest('POST', 'freeform/diagnostics/scan-related-data', { data: { scanId } });
                        const batch = response.data;
                        if (!Array.isArray(batch.results) || !Number.isInteger(batch.completedChecks)) throw new Error('Scan failed');
                        scanId = batch.scanId;
                        results.replaceChildren();
                        let orphans = 0;
                        let duplicates = 0;
                        let skipped = 0;
                        for (const result of batch.results) {
                            if (result.error) skipped += 1;
                            else if (result.type === 'orphans') orphans += result.count;
                            else duplicates += result.count;
                            if (!result.error && !result.count) continue;
                            const row = document.createElement('li');
                            const label = result.table + (result.columns.length ? ' (' + result.columns.join(', ') + ')' : '');
                            row.textContent = label + ': ' + (result.error ? messages.skipped + '. ' + result.error : format(messages[result.type], { count: result.count }));
                            results.appendChild(row);
                        }
                        status.textContent = batch.complete
                            ? format(messages.complete, { orphans, duplicates, skipped })
                            : format(messages.progress, { completed: batch.completedChecks, total: batch.totalChecks, scanned: batch.scanned });
                        if (batch.complete) break;
                    }
                } catch (error) {
                    status.textContent = messages.failed;
                } finally {
                    button.disabled = false;
                    spinner.classList.add('hidden');
                    section.setAttribute('aria-busy', 'false');
                    guide.hidden = false;
                }
            });
        })();
    {% endjs %}
{% endblock %}
