{# name: Hero #}
{# description: A welcoming hero with a headline, copy, and a playful call to action. #}
{# Builder templates are reusable Twig fragments. The current form is available as "form". #}
<section id="about" style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; padding: clamp(1.5rem, 4vw, 3rem); border-radius: 1rem; background: linear-gradient(135deg, #3b0764, #6d28d9); color: white;">
    <div style="flex: 1 1 18rem;">
        <span style="display: inline-block; padding: .3rem .65rem; border-radius: 999px; background: #fbbf24; color: #3b0764; font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;">Small wings, big plans</span>
        <h2 style="margin: .8rem 0 .5rem; font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.1;">Your next adventure has tiny wings.</h2>
        <p style="margin: 0 0 1.25rem; color: #ede9fe;">Meet the dragons who make every journey a little more magical—and only occasionally singe the map.</p>
        <a href="#features" style="display: inline-block; padding: .7rem 1rem; border-radius: .5rem; background: #fbbf24; color: #3b0764; font-weight: 700; text-decoration: none;">See why we fly →</a>
    </div>
    <div aria-hidden="true" style="flex: 0 0 auto; display: grid; place-items: center; width: 6rem; height: 6rem; border: 1px solid #c4b5fd; border-radius: 1.25rem; background: #ffffff1c; font-size: 3.5rem; line-height: 1;">🐉</div>
</section>
