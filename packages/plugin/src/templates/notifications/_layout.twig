{% extends "freeform/_layouts/main" %}
{% hook "freeform.prepareCpTemplate" %}

{% set selectedSubnavItem = "notifications" %}

{% set title = "Email Notifications"|t('freeform') %}

{% block sidebar %}
    {% set segment = craft.app.request.segment(3) %}
    {% set settings = freeform.settings %}
    {% set items = [{ heading: 'Templates'|t('freeform') }] %}
    {% if settings.emailTemplateStorageType in ['files_database', 'files'] %}
        {% set items = items|merge([{
            title: 'File Templates'|t('freeform'),
            url: 'freeform/notifications/files',
            selected: segment == 'files',
        }]) %}
    {% endif %}
    {% if settings.emailTemplateStorageType in ['files_database', 'database'] %}
        {% set items = items|merge([{
            title: 'Database Templates'|t('freeform'),
            url: 'freeform/notifications/database',
            selected: segment == 'database',
        }]) %}
    {% endif %}
    {% set items = items|merge([
        { heading: 'Template Wrappers'|t('freeform') },
        {
            title: 'Notification Wrappers'|t('freeform'),
            url: 'freeform/notifications/wrappers',
            selected: segment == 'wrappers',
        },
    ]) %}
    {% include 'freeform/_components/secondary-navigation' with {
        label: 'Email Notifications'|t('freeform'),
        items: items,
    } only %}
{% endblock %}
