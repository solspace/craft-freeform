{
  "name": "@solspace/freeform-react-theme-bootstrap",
  "version": "0.1.14",
  "description": "Official Bootstrap 5 starter theme for Freeform React",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check src"
  },
  "peerDependencies": {
    "@solspace/freeform-react": "^0.1.0"
  },
  "devDependencies": {
    "@solspace/freeform-react": "workspace:*",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "freeform",
    "craft-cms",
    "headless",
    "react",
    "theme",
    "bootstrap"
  ],
  "author": "Solspace Inc.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
