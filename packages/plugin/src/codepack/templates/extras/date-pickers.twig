{% extends "demo/_layout" %}

{% set pageTitle = "Adjustments to a Date Field Date/Time Picker | Examples" %}

{# Replace 'freeformDatePicker' with your form handle #}
{% set demoFormHandle = "freeformDatePicker" %}

{% block content %}

    {% set form = freeform.form(demoFormHandle, { formattingTemplate: pageTemplateFile }) %}

    <article class="freeform-form-browser freeform-example-detail" aria-labelledby="example-title">
    {% set exampleDescription %}Use Freeform’s built-in date and time picker with the field’s configured format, locale, time interval, and date limits.{% endset %}
    {% include "demo/extras/_items.twig" with { mode: 'header', exampleHandle: 'date-pickers' } %}

    {% if form %}
        <section class="freeform-submissions-panel freeform-example-demo-panel" aria-labelledby="live-example-title">
            <div class="freeform-submissions-toolbar"><h3 id="live-example-title">Try the example</h3></div>
            <div class="freeform-example-demo-body">

        {{ form.render() }}



            </div>
        </section>

    {% else %}

        {% set setupNoticeMessage %}<p>Use a form with the handle <code>{{ demoFormHandle }}</code> to run this example.</p>{% endset %}
        {% include "demo/extras/_setup-notice.twig" %}

    {% endif %}

    {# Instructions to get this page working correctly #}
    {% embed "demo/extras/_setup.twig" %}
        {% block instructions %}
        <ol>
            <li>Rename your test form handle to <code>{{ demoFormHandle }}</code> or adjust the form handle name inside this template to match your test form.</li>
            <li>
                Make sure your test form includes the following field (at minimum):
                <ul>
                    <li>Date field of the Date &amp; Time field type (Pro only).</li>
                    <li>
                        Set the following configuration for this field as:
                        <ul>
                            <li><b>Type</b> set to <i>Both</i></li>
                            <li><b>Date picker</b> set to <i>Freeform</i></li>
                        </ul>
                    </li>
                </ul>
            </li>
        </ol>
        {% endblock %}
    {% endembed %}
    <p class="freeform-example-template-note">Template: <code>extras/date-pickers.twig</code></p>
    </article>

{% endblock %}
