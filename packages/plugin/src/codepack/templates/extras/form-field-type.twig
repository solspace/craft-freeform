{% extends "demo/_layout" %}

{% set pageTitle = "Freeform Form Element Field Type | Examples" %}

{# Replace 'freeform-test' with your Craft Entry slug #}
{% set entry = craft.entries().slug('freeform-test').one %}

{% block content %}

    <article class="freeform-form-browser freeform-example-detail" aria-labelledby="example-title">
    {% set exampleDescription %}This example will show how to display and adjust forms that are assigned to Craft Entries via the Freeform Form element field type.{% endset %}
    {% include "demo/extras/_items.twig" with { mode: 'header', exampleHandle: 'form-field-type' } %}

    {# Make sure the test Craft entry exists #}
    {% if entry %}
        <section class="freeform-submissions-panel freeform-example-demo-panel" aria-labelledby="live-example-title">
            <div class="freeform-submissions-toolbar"><h3 id="live-example-title">Try the example</h3></div>
            <div class="freeform-example-demo-body">

        <div class="freeform-notice{{ colorMode == "dark" ? " freeform-notice-dark" }}">
            <p>Craft Entry:</p>
            <h4>{{ entry.title }} <small>(#{{ entry.id }})</small></h4>
            <p>Posted on {{ entry.postDate.format('F d, Y') }}</p>
        </div>

        {# Make sure the test Freeform Form field type exists #}
        {% if entry['freeformForm'] is defined %}
            {# Check if there's a value for the Freeform Form field type #}
            {% if entry.freeformForm  | length %}
                <h3 class="freeform-form-title">{{ entry.freeformForm.name }}</h3>
                {# Apply additional parameters as you please #}
                {{ entry.freeformForm.render({
                    formattingTemplate: pageTemplateFile,
                    id: "my-test-form",
                    overrideValues: {
                        productTitle: entry.title,
                    }
                }) }}
            {% else %}
                {% set setupNoticeMessage %}Assign a form to this Craft entry to run the example.{% endset %}
        {% include "demo/extras/_setup-notice.twig" %}
            {% endif %}
        {% else %}
            {% set setupNoticeMessage %}Add a Freeform Form field with the handle <code>freeformForm</code> to this Craft section.{% endset %}
        {% include "demo/extras/_setup-notice.twig" %}
        {% endif %}

            </div>
        </section>

    {% else %}

        {% set setupNoticeMessage %}<p>Load an existing Craft entry with a slug of <code>freeform-test</code> to run this example.</p>{% endset %}
        {% include "demo/extras/_setup-notice.twig" %}

    {% endif %}

    {# Instructions to get this page working correctly #}
    {% embed "demo/extras/_setup.twig" %}
        {% block instructions %}
        <ol>
            <li>
                Make sure your test form includes the following Freeform fields at minimum, or adjust the overrides inside this template:
                <ul>
                    <li>Product Title field (text or hidden) with handle of <code>productTitle</code>.</li>
                </ul>
            </li>
            <li>
                Make sure you have a Craft Entry with a slug of <code>freeform-test</code> and includes the following Craft fields at minimum, or adjust the code inside this template:
                <ul>
                    <li>Title field</li>
                    <li>Freeform Form element field type with a handle of <code>freeformForm</code> and a form assigned to it.</li>
                </ul>
            </li>
        </ol>
        {% endblock %}
    {% endembed %}
    <p class="freeform-example-template-note">Template: <code>extras/form-field-type.twig</code></p>
    </article>

{% endblock %}
