{% extends "_layouts/elementindex" %}

{% set bodyClass = (bodyClass ?? [])|explodeClass|push('freeform-cp')|push('freeform-element-index') %}
{% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\Craft6CpBundle') %}

{% set extraPageHeaderHtml %}

    {% if currentUser.can("freeform-formsManage") %}
        <div class="buttons">
            <a class="btn submit add icon" href="{{ url('freeform/forms/new/') }}">
                {{ "Create a new Form"|t('freeform') }}
            </a>
        </div>
    {% endif %}

{% endset %}

{% block content %}
    {{ ui('pane', {
        padding: 0,
        attributes: {id: 'freeform-index-pane', hidden: true, 'data-statuses': statuses|default([])|map(s => {handle: s.handle, color: s.color, label: s.name})|json_encode},
    }) }}
    {{ parent() }}
{% endblock %}

{% block body %}
    {{ parent() }}
    {% include 'freeform/_components/shell-indicators' %}
{% endblock %}
