{% extends "freeform/notifications/_layout" %}

{% set title = 'File Templates'|t('freeform') %}

{% set canManageTemplates = currentUser.can('freeform-notificationsManage') and settings.emailTemplateMethod != 'form' and settings.emailTemplateStorageType in ['files', 'files_database'] and settings.absoluteEmailTemplateDirectory and settings.allowFileTemplateEdit %}

{% block actionButton %}
    {% if canManageTemplates %}
        <div class="buttons"><craft-button variant="primary" icon="plus" href="{{ url('freeform/notifications/files/new') }}">{{ 'New Template'|t('freeform') }}</craft-button></div>
    {% endif %}
{% endblock %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Email Notifications"|t("freeform"), url: url("freeform/notifications") },
    { label: 'Files'|t('freeform'), url: url('freeform/notifications/files') },
] %}

{% set content %}
    {% if notifications|length and settings.emailTemplateMethod != 'form' %}
        <div class="tablepane ff-notification-tablepane">
            <table data-file-templates class="cp-table cp-table--spacious ff-notification-table">
                <thead><tr>
                    <th scope="col" class="ff-notification-name-column">{{ 'Template'|t('freeform') }}</th>
                    <th scope="col">{{ 'File name'|t('freeform') }}</th>
                    {% if canManageTemplates %}<th scope="col" class="ff-notification-actions-column"><span class="visually-hidden">{{ 'Actions'|t('freeform') }}</span></th>{% endif %}
                </tr></thead>
                <tbody>
                    {% for filename, notification in notifications %}
                        <tr data-id="{{ notification.filepath }}" data-name="{{ notification.name }}">
                            <th scope="row" class="ff-notification-name-cell">
                                <div class="ff-notification-heading">
                                    {% if canManageTemplates %}<a href="{{ url('freeform/notifications/files/' ~ notification.filepath) }}">{{ notification.name }}</a>{% else %}<span>{{ notification.name }}</span>{% endif %}
                                </div>
                                {% if notification.description %}<p class="ff-notification-description">{{ notification.description }}</p>{% endif %}
                            </th>
                            <td class="ff-notification-filename-cell"><code class="ff-notification-filename" title="{{ filename }}">{{ filename }}</code></td>
                            {% if canManageTemplates %}
                                <td class="ff-notification-actions-cell">{% include 'freeform/notifications/_actions' with {notificationType: 'files', templateName: notification.name} only %}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    <div data-notification-empty{% if notifications|length and settings.emailTemplateMethod != 'form' %} hidden{% endif %}>
        {% include 'freeform/notifications/_empty' with {kind: 'files'} %}
    </div>
{% endset %}
