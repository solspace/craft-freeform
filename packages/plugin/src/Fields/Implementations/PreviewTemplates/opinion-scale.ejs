<%
  var selectedValue = (defaultValue == null || defaultValue === '') ? null : String(defaultValue);
  var namespace = (handle || 'opinion') + '-' + Date.now();
  var fieldName = (name || handle || 'opinionScale');
%>

<div class="opinion-scale">
    <ul class="opinion-scale-scales">
        <% scales.forEach(function(scale, index) { %>
            <% var value = String(scale[0]); %>
            <% var label = scale[1] || value; %>
            <% var id = namespace + '-' + index; %>
            <% var isChecked = (selectedValue !== null && value === selectedValue); %>

            <li>
                <input id="<%= id %>" type="radio" name="<%= fieldName %>" value="<%= value %>" disabled <%= isChecked ? 'checked' : '' %> />
                <label for="<%= id %>"><%= label %></label>
            </li>
        <% }); %>
    </ul>

    <% if (legends.length > 0 ) { %>
        <ul class="opinion-scale-legends">
            <% legends.forEach(function(legend) { %>
                <li><%= legend[0] %></li>
            <% }); %>
        </ul>
    <% } %>
</div>
