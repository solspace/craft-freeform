{
  "name": "@solspace/freeform-core",
  "version": "0.1.0-beta.1",
  "description": "Framework-neutral headless runtime for Solspace Freeform",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "lint": "biome check"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "4.1.9"
  },
  "keywords": [
    "freeform",
    "craft-cms",
    "headless",
    "forms"
  ],
  "author": "Solspace Inc.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
