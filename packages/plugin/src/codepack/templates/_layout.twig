{%- set demoPrefix = "%prefix%" -%}
{%- set demoRouteSegment = demoPrefix|split('/')|last -%}
{% set baseUrlSegments = 1 %}
{%- if craft.app.request.segment(baseUrlSegments) != demoRouteSegment -%}
    {%- if craft.app.request.segment(baseUrlSegments + 1) == demoRouteSegment -%}
        {%- set baseUrlSegments = baseUrlSegments + 1 -%}
    {%- elseif craft.app.request.segment(baseUrlSegments + 2) == demoRouteSegment -%}
        {%- set baseUrlSegments = baseUrlSegments + 2 -%}
    {%- elseif craft.app.request.segment(baseUrlSegments + 3) == demoRouteSegment -%}
        {%- set baseUrlSegments = baseUrlSegments + 3 -%}
    {%- endif -%}
{%- endif -%}
{%- set demoBaseUrl = siteUrl ~ demoPrefix -%}
{%- set assetBaseUrl = craft.app.request.hostInfo ~ craft.app.request.baseUrl ~ '/assets/' ~ demoPrefix -%}
{%- set demoArea = craft.app.request.segment(baseUrlSegments + 1) -%}
{%- set pageTemplate = craft.app.request.segment(baseUrlSegments + 2)|default('basic-light') -%}
{%- set pageTemplateFile = pageTemplate ~ '/index.twig' -%}
{%- if demoArea == "submissions" -%}
    {%- set spamMode = craft.app.request.segment(baseUrlSegments + 2) != "delete" and (craft.app.request.segment(baseUrlSegments + 4) == "spam" or craft.app.request.segment(baseUrlSegments + 3) == "spam") -%}
{%- endif -%}
{%- if demoArea == "forms" -%}
    {%- set formHandle = craft.app.request.segment(baseUrlSegments + 3) -%}
{%- elseif demoArea == "submissions" and craft.app.request.segment(baseUrlSegments + 2) == "delete" -%}
    {%- set formHandle = craft.app.request.segment(baseUrlSegments + 3) -%}
    {%- set pageTemplateFile = null -%}
{%- elseif demoArea in ["submissions", "custom"] -%}
    {%- set formHandle = craft.app.request.segment(baseUrlSegments + 2) -%}
    {%- set pageTemplateFile = null -%}
{%- elseif demoArea == "extras" -%}
    {%- set formHandle = "" -%}
    {%- set pageTemplateFile = "basic-light/index.twig" -%}
{%- elseif demoArea is empty -%}
    {%- set formHandle = "" -%}
    {%- set pageTemplate = "basic-dark" %}
{%- endif -%}
{%- if formHandle -%}
    {%- set form = freeform.form(formHandle, {
        formattingTemplate: pageTemplateFile,
    }) -%}
{%- endif -%}

{%- set colorMode = pageTemplate in ["basic-dark", "bootstrap-5-dark", "tailwind-3-dark", "tailwind-4-dark", "daisyui-5-dark", "conversational"] ? "dark" : "light" -%}

<!doctype html>
<html lang="en"
{%- if colorMode == "dark" %}
 data-theme="dark"
{%- endif -%}
{%- if pageTemplate == "bootstrap-5-dark" %} data-bs-theme="dark"{%- endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>{% block title %}{{ pageTitle ? "Freeform Demo | " ~ pageTitle : "Freeform Demo" }}{% endblock %}</title>
    {% if demoArea == "forms" and craft.app.request.segment(baseUrlSegments + 3) %}
        {% if pageTemplate in ["bootstrap-5", "bootstrap-5-dark", "bootstrap-5-floating-labels"] %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        {% endif %}
        {% if pageTemplate == "foundation-6" %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/css/foundation.min.css" crossorigin="anonymous">
            <script src="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/js/foundation.min.js" crossorigin="anonymous"></script>
        {% endif %}
        {% if pageTemplate in ["tailwind-4-light", "tailwind-4-dark"] %}
            <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
        {% endif %}
        {% if pageTemplate in ["tailwind-3", "tailwind-3-dark"] %}
            <script src="https://cdn.tailwindcss.com/3.4.17"></script>
        {% endif %}
    {% endif %}
    <link href="{{ assetBaseUrl }}/css/demo.css" rel="stylesheet">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ assetBaseUrl }}/favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ assetBaseUrl }}/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ assetBaseUrl }}/favicon/favicon-16x16.png">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

{% block headerCss %}{% endblock %}

</head>
<body{% if spamMode is defined and spamMode == true %} class="freeform-spam-mode"{% endif %}>

    {% macro pageTemplateItem(template, form, demoBaseUrl, pageTemplateSegment, editSegment, editTokenSegment) %}
        {% if template == "divider" %}
            <hr />
        {% else %}
            <a{% if craft.app.request.segment(pageTemplateSegment) == template %} class="active" aria-current="page"{% endif %} href="{{ demoBaseUrl }}/forms/{{ template }}/{{ form }}{% if craft.app.request.segment(editSegment) == "edit" %}/edit/{{ craft.app.request.segment(editTokenSegment) }}{% endif %}">{{ template|title|replace({'-':' '}) }}</a>
        {% endif %}
    {% endmacro %}

    <header class="freeform-nav">
        <a href="{{ demoBaseUrl }}/" class="freeform-logo">
            <img src="{{ assetBaseUrl }}/images/freeform.svg" alt=""><h1>Freeform Demo</h1>
        </a>
        {% if demoArea == "forms" or demoArea is empty %}
            This section {{ craft.app.request.segment(baseUrlSegments + 3) ? "has" : "will" }} automatically {{ craft.app.request.segment(baseUrlSegments + 3) ? "loaded" : "load" }} the
            <div class="freeform-nav-dropdown">
                <button class="freeform-nav-button" type="button">
                    {{ pageTemplate ? pageTemplate|title|replace({'-':' '}) : 'Select a template...' }}
                </button>
                <div class="freeform-nav-dropdown-content">
                {% for pageTemplate in (["basic-light", "basic-dark", "basic-floating-labels", "conversational", "multipage-all-fields", "divider", "grid", "flexbox", "divider", "bootstrap-5", "bootstrap-5-dark", "bootstrap-5-floating-labels", "daisyui-5-light", "daisyui-5-dark", "tailwind-4-light", "tailwind-4-dark", "tailwind-3", "tailwind-3-dark", "foundation-6"]) -%}
                    {{ _self.pageTemplateItem(pageTemplate, formHandle, demoBaseUrl, baseUrlSegments + 2, baseUrlSegments + 4, baseUrlSegments + 5) }}
                {%- endfor %}
                </div>
            </div>
            formatting template for the
            <div class="freeform-nav-dropdown">
                <button class="freeform-nav-button{{ form.name is not defined ? " dropdown-glow"}}" type="button">
                    <span class="freeform-form-circle"{% if form.color is defined %} style="background-color: {{ form.color|e('html_attr') }}"{% else %} hidden{% endif %}></span>{{ form.name is defined ? form.name : 'Select a form...' }}
                </button>
                <div class="freeform-nav-dropdown-content">
                {% set forms = freeform.forms %}
                {% for form in forms %}
                    <a{% if formHandle == form.handle %} class="active" aria-current="page"{% endif %} href="{{ demoBaseUrl }}/forms/{{ pageTemplate ?: 'basic-light' }}/{{ form.handle }}"><span class="freeform-form-circle" style="background-color: {{ form.color|e('html_attr') }}"></span>{{ form.name }}</a>
                {% endfor %}
                </div>
            </div>
            form.
        {% elseif demoArea == "submissions" %}
            {{ craft.app.request.segment(baseUrlSegments + 2) ? "Viewing" : "View" }} submissions for the
            <div class="freeform-nav-dropdown">
                <button class="freeform-nav-button{{ form.name is not defined ? " dropdown-glow"}}" type="button">
                    <span class="freeform-form-circle"{% if form.color is defined %} style="background-color: {{ form.color|e('html_attr') }}"{% else %} hidden{% endif %}></span>{{ form.name is defined ? form.name : 'Select a form...' }}
                </button>
                <div class="freeform-nav-dropdown-content">
                {% set forms = freeform.forms %}
                {% for form in forms %}
                    <a{% if formHandle == form.handle %} class="active" aria-current="page"{% endif %} href="{{ demoBaseUrl }}/submissions/{{ form.handle }}"><span class="freeform-form-circle" style="background-color: {{ form.color|e('html_attr') }}"></span>{{ form.name }} ({{ freeform.submissions({formId: form.id}).count }})</a>
                {% endfor %}
                </div>
            </div>
            form.
        {% elseif demoArea == "custom" %}
            This section {{ form is defined and form ? "has" : "will" }} automatically {% if form is defined and form %}loaded the <code>{{ form.settings.formattingTemplate }}</code>{% else %}load the{% endif %} formatting template for the
            <div class="freeform-nav-dropdown">
                <button class="freeform-nav-button{{ form.name is not defined ? " dropdown-glow"}}" type="button">
                    <span class="freeform-form-circle"{% if form.color is defined %} style="background-color: {{ form.color|e('html_attr') }}"{% else %} hidden{% endif %}></span>{{ form.name is defined ? form.name : 'Select a form...' }}
                </button>
                <div class="freeform-nav-dropdown-content">
                {% set forms = freeform.forms %}
                {% for form in forms %}
                    <a{% if formHandle == form.handle %} class="active" aria-current="page"{% endif %} href="{{ demoBaseUrl }}/custom/{{ form.handle }}"><span class="freeform-form-circle" style="background-color: {{ form.color|e('html_attr') }}"></span>{{ form.name }}</a>
                {% endfor %}
                </div>
            </div>
            form. Consider forcing a
            <div class="freeform-nav-dropdown">
                <button class="freeform-nav-button" type="button">
                    {{ "sample template"|t('freeform') }}
                </button>
                <div class="freeform-nav-dropdown-content">
                {% for pageTemplate in (["basic-light", "basic-dark", "basic-floating-labels", "conversational", "multipage-all-fields", "divider", "grid", "flexbox", "divider", "bootstrap-5", "bootstrap-5-dark", "bootstrap-5-floating-labels", "daisyui-5-light", "daisyui-5-dark", "tailwind-4-light", "tailwind-4-dark", "tailwind-3", "tailwind-3-dark", "foundation-6"]) -%}
                    {{ _self.pageTemplateItem(pageTemplate, formHandle, demoBaseUrl, baseUrlSegments + 2, baseUrlSegments + 4, baseUrlSegments + 5) }}
                {%- endfor %}
                </div>
            </div>
            instead.
        {% elseif demoArea == "extras" %}
            Try another extras demo:
            <div class="freeform-nav-dropdown">
                <button class="freeform-nav-button" type="button">
                    Please select...
                </button>
                <div class="freeform-nav-dropdown-content extras-dropdown">
                    {% include "demo/extras/_items.twig" with { mode: "navigation" } %}
                </div>
            </div>
        {% else %}
        {% endif %}
        <div class="freeform-menu">
            <input id="freeform-menu-toggle" type="checkbox" aria-label="Toggle demo navigation" />
            <label class="freeform-menu-hamburger" for="freeform-menu-toggle">
                <div class="top"></div>
                <div class="top-inner"></div>
                <div class="meat"></div>
                <div class="bottom-inner"></div>
                <div class="bottom"></div>
            </label>
            <nav class="freeform-menu-list" aria-label="Demo sections">
                <a href="{{ demoBaseUrl }}/forms"{% if demoArea == 'forms' %} class="active" aria-current="page"{% endif %}>Forms</a>
                <a href="{{ demoBaseUrl }}/submissions"{% if demoArea == 'submissions' %} class="active" aria-current="page"{% endif %}>Submissions</a>
                <a href="{{ demoBaseUrl }}/custom"{% if demoArea == 'custom' %} class="active" aria-current="page"{% endif %}>Custom</a>
                <a href="{{ demoBaseUrl }}/extras"{% if demoArea == 'extras' %} class="active" aria-current="page"{% endif %}>Extras</a>
            </nav>
        </div>
    </header>

    <main class="freeform-form-content" id="main-content">

{% block content %}{% endblock %}

    </main>

{% block footerJs %}{% endblock %}

{% if demoArea == "extras" %}
    <script>
        document.addEventListener('freeform-ready', (event) => {
            event.options.scrollOffset = -200;
        });
    </script>
{% endif %}

</body>
</html>
