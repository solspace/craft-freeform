
    <svg viewBox="0 0 240 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        {% if mode == 'custom' %}
            <g class="ff-settings-art-sheet">
                <rect x="36" y="12" width="168" height="76" rx="8" fill="white" stroke-opacity=".3"/>
                <path d="M56 32h128M56 50h128M56 68h128" stroke-opacity=".25"/>
                <circle class="ff-settings-art-slider" style="--slider-travel:34px" cx="91" cy="32" r="6" fill="currentColor" stroke="white" stroke-width="3"/>
                <circle class="ff-settings-art-slider" style="--slider-travel:-38px;--slider-delay:-.7s" cx="151" cy="50" r="6" fill="currentColor" stroke="white" stroke-width="3"/>
                <circle class="ff-settings-art-slider" style="--slider-travel:22px;--slider-delay:-1.3s" cx="114" cy="68" r="6" fill="currentColor" stroke="white" stroke-width="3"/>
            </g>
            <path d="M18 43v14M11 50h14M220 23v10M215 28h10" opacity=".4"/>
        {% else %}
            {% set count = mode == 'minimal' ? 2 : (mode == 'standard' ? 4 : 6) %}
            <path d="M20 50h20M200 50h20" stroke-dasharray="3 4" opacity=".35"/>
            <g class="ff-settings-art-sheet">
                <rect x="44" y="9" width="152" height="82" rx="8" fill="white" stroke-opacity=".3"/>
                <path d="M57 22h43" stroke-width="3" opacity=".55"/>
                <path d="M57 29h126" stroke-opacity=".15"/>
                {% for i in 0..5 %}
                    {% set y = 39 + i * 8 %}
                    <g class="{{ i < count ? 'ff-settings-art-row' }}" style="--art-row:{{ i }}" opacity="{{ i < count ? 1 : 0.12 }}">
                        <circle cx="60" cy="{{ y }}" r="2.5" fill="currentColor" stroke="none"/>
                        <path d="M70 {{ y }}h{{ i is even ? 75 : 94 }}" stroke-width="2.5" opacity=".5"/>
                        {% if mode == 'detailed' %}<path d="M170 {{ y }}h10" stroke-width="2.5" opacity=".3"/>{% endif %}
                    </g>
                {% endfor %}
            </g>
            <circle class="ff-settings-art-node" cx="20" cy="50" r="4" fill="currentColor" stroke="none" opacity=".5"/>
            <circle class="ff-settings-art-node ff-settings-art-node-end" cx="220" cy="50" r="4" fill="currentColor" stroke="none" opacity=".5"/>
        {% endif %}
    </svg>
