{% extends "_layouts/elementindex" %}

{% set extraPageHeaderHtml %}

    {% if currentUser.can("freeform-formsManage") %}
        <div class="buttons">
            <a class="btn submit add icon" href="{{ url('freeform/forms/new/') }}">
                {{ "Create a new Form"|t('freeform') }}
            </a>
        </div>
    {% endif %}

{% endset %}

{% block body %}
    {{ parent() }}
    {% if elementType in ['Solspace\\Freeform\\Elements\\Submission', 'Solspace\\Freeform\\Elements\\SpamSubmission'] %}
        {% include 'freeform/submissions/_undo' %}
    {% endif %}
    {% hook 'freeform-beta-widget' %}
{% endblock %}
