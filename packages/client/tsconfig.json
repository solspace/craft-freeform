{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../plugin/src/Resources/js/client/",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": [
      "config/@types",
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      "@config/*": ["./config/*"],
      "@editor/*": ["./src/app/pages/forms/edit/*"],
      "@components/*": ["./src/app/components/*"],
      "@form-controls/*": ["./src/app/components/form-controls/*"],
      "@ff-icons/*": ["./src/assets/icons/*"],
      "@ff-client/*": ["./src/*"],
      "@ff-widgets/*": ["../scripts/src/lib/cp/widgets/*"],
      "@ff-chart-styles": ["../styles/src/shared/chart.css"]
    }
  },
  "exclude": ["node_modules"]
}
