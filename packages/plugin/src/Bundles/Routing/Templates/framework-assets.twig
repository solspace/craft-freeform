    {% if not isCustomFormattingTemplate and formattingTemplate in ['bootstrap-5-light/index.twig', 'bootstrap-5-dark/index.twig', 'bootstrap-5-floating-labels/index.twig'] %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    {% elseif not isCustomFormattingTemplate and formattingTemplate in ['daisyui-5-light/index.twig', 'daisyui-5-dark/index.twig'] %}
        <link href="https://cdn.jsdelivr.net/npm/daisyui@5.7.27" rel="stylesheet" type="text/css">
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
    {% elseif not isCustomFormattingTemplate and formattingTemplate in ['tailwind-4-light/index.twig', 'tailwind-4-dark/index.twig'] %}
