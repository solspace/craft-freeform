{% extends "freeform/_layouts/settings" %}

{% import "_includes/forms" as forms %}
{% import "freeform/_components/boolean-menu" as booleanMenu %}
{% import "freeform/_components/measurement" as measurement %}
{% import "freeform/_components/settings-cards" as cards %}

{% set crumbs = [
    { label: craft.freeform.name, url: url("freeform") },
    { label: "Settings"|t("freeform"), url: url("freeform/settings") },
] %}

{% set title = "Form Behavior"|t("freeform") %}

{% block content %}

    {{ parent() }}

    <input type="hidden" name="action" value="freeform/settings/save-settings">
    {{ redirectInput('freeform/settings/form-behavior') }}
    {{ csrfInput() }}


    {{ booleanMenu.field({
        includeEnvVars: true,
        label: "Allow URL Prefilling"|t('freeform'),
        instructions: "Allow form fields to be prefilled using matching URL parameters, such as `?topic=support`."|t('freeform'),
        name: "settings[fillWithGet]",
        value: settings.fillWithGet,
        errors: settings.errors().get("fillWithGet"),
        disabled: readOnly,
    }) }}

    {{ booleanMenu.field({
        includeEnvVars: true,
        label: "Automatically Scroll to Form"|t('freeform'),
        instructions: "Automatically scroll to the form after submission to show errors, the next page, or a success message. Applies to standard and AJAX submissions."|t('freeform'),
        name: "settings[autoScrollToErrors]",
        value: settings.autoScrollToErrors,
        errors: settings.errors().get("autoScrollToErrors"),
        disabled: readOnly,
    }) }}

    {{ booleanMenu.field({
        includeEnvVars: true,
        label: "Prevent Duplicate Submissions"|t('freeform'),
        instructions: "Use unique submission tokens to reject repeat submissions of the same form instance within one minute."|t('freeform'),
        name: "settings[useIdempotencyKey]",
        value: settings.useIdempotencyKey,
        errors: settings.errors().get("useIdempotencyKey"),
        disabled: readOnly,
    }) }}

    {% if (craft.app.config.general.asyncCsrfInputs) %}
        {{ forms.selectField({
            label: "CSRF Token Refresh"|t('freeform'),
            instructions: "Choose whether Freeform refreshes CSRF tokens once per page view, before every request, or never. Once per page view is recommended when using page caching."|t('freeform'),
            name: "settings[csrfRefresh]",
            value: settings.csrfRefresh,
            errors: settings.errors().get("csrfRefresh"),
            disabled: readOnly,
            options: {
                "once": "Once Per Page View (recommended)"|t('freeform'),
                "always": "Every Request"|t('freeform'),
                "none": "Never"|t('freeform'),
            },
        }) }}
    {% endif %}


    {% set scriptLocations = {
        footer: {label: 'Page Footer', description: 'Inserts scripts at the end of the page body.', path: 'M4 15h16M8 18h8'},
        form: {label: 'Inside Form', description: 'Outputs scripts with the form markup instead of registering them with the page.', path: 'M8 8h8M8 12h8M8 16h5'},
        manual: {label: 'None (add manually)', description: 'Disables automatic insertion. Load Freeform’s scripts and styles in your templates.', path: 'm9 9-3 3 3 3m6-6 3 3-3 3'},
    } %}
    {% set scriptLocationInput %}
        <div class="ff-choice-cards">
            {% for location, option in scriptLocations %}
                {% set icon %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="{{ option.path }}"/></svg>{% endset %}
                {{ cards.compactChoice({
                    id: 'script-location-' ~ location,
                    name: 'settings[scriptInsertLocation]',
                    value: location,
                    selected: settings.scriptInsertLocation == location,
                    recommended: location == 'footer',
                    disabled: readOnly,
                    label: option.label|t('freeform'),
                    description: option.description|t('freeform'),
                    icon: icon,
                }) }}
            {% endfor %}
        </div>
        <p class="warning with-icon" data-script-insert-warning role="status" {{ settings.scriptInsertLocation != 'manual' ? 'hidden' }}>
            {{ "Please ensure that you manually load Freeform's JS and CSS using the 'freeform.loadScripts()' function in your template(s)."|t('freeform') }}
        </p>
    {% endset %}
    {{ forms.field({
        id: 'script-insert-location',
        fieldset: true,
        label: "Script Placement"|t('freeform'),
        instructions: "Choose where Freeform inserts the scripts used by forms and fields."|t('freeform'),
        errors: settings.errors().get("scriptInsertLocation"),
    }, scriptLocationInput) }}

    {% if craft.freeform.pro %}

        <hr>

        <h2>{{ "Save & Continue Later"|t('freeform') }}</h2>

        {{ forms.selectField({
            label: "Keep Saved Progress For"|t('freeform'),
            instructions: "How long to keep saved progress after it was last updated."|t('freeform'),
            name: "settings[saveFormTtl]",
            value: settings.saveFormTtl,
            errors: settings.errors().get("saveFormTtl"),
            disabled: readOnly,
            options: {
                0: "Please select"|t("freeform"),
                1: "1 day"|t("freeform"),
                2: "2 days"|t("freeform"),
                3: "3 days"|t("freeform"),
                4: "4 days"|t("freeform"),
                5: "5 days"|t("freeform"),
                6: "6 days"|t("freeform"),
                7: "7 days"|t("freeform"),
                14: "14 days"|t("freeform"),
                30: "30 days"|t("freeform"),
                60: "60 days"|t("freeform"),
                90: "90 days"|t("freeform"),
                120: "120 days"|t("freeform"),
                180: "180 days"|t("freeform"),
                365: "365 days"|t("freeform"),
            }
        }) }}

        {{ measurement.field({
            label: "Maximum Saved Forms per Session"|t('freeform'),
            instructions: "The maximum number of saved forms to keep in each session. When exceeded, the least recently updated saves are removed. Set to 0 for unlimited."|t('freeform'),
            id: "save-form-session-limit",
            name: "settings[saveFormSessionLimit]",
            unit: "forms"|t('freeform'),
            value: settings.saveFormSessionLimit,
            errors: settings.errors().get("saveFormSessionLimit"),
            disabled: readOnly,
            placeholder: "0 for unlimited"|t('freeform'),
        }) }}

    {% endif %}




{% endblock %}
