{% import "_includes/forms" as forms %}

{% set selectedValues = submission[field.handle] is not null ? submission[field.handle].value : [] %}
{% set inputs = '' %}
{% for opt in field.options %}
    {% set inputs = inputs ~ '<div>' %}
    {% set inputs = inputs ~ forms.checkbox({
        name: field.handle~'[]',
        value: opt.value,
        label: opt.label,
        checked: opt.value in selectedValues,
    }) %}
    {% set inputs = inputs ~ '</div>' %}
{% endfor %}

{{ forms.field(
    {
        label: field.label,
        instructions: field.instructions,
        id: field.handle,
        required: field.required,
        errors: submission.errors(field.handle),
    },
    inputs | raw
) }}
