{% set successBanner %}
    <div{{ form.attributes.success|raw }}>
      <div class="flex">
        <div class="shrink-0">
          <svg class="size-6 text-green-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-2">
          <h3 class="text-md font-medium text-green-800">{{ form.successMessage | t('freeform') }}</h3>
        </div>
      </div>
    </div>
{% endset %}
{% set errorBanner %}
    <div{{ form.attributes.errors|raw }}>
      <div class="flex">
        <div class="shrink-0">
        <svg class="size-6 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
        </svg>
        </div>
        <div class="ml-2">
          <h3 class="text-md font-medium text-red-800">{{ form.errorMessage | t('freeform') }}</h3>
            <div class="mt-2 text-sm text-red-700"{% if not form.errors|length %} hidden{% endif %}>
              <ul role="list" class="list-disc space-y-1 pl-5" data-freeform-banner-errors>
                {% for error in form.errors %}
                  <li>{{ error }}</li>
                {% endfor %}
              </ul>
            </div>
        </div>
      </div>
    </div>
{% endset %}
{% if form.settings.ajax %}
  <template data-freeform-success-template>{{ successBanner }}</template>
  <template data-freeform-error-template>{{ errorBanner }}</template>
{% else %}
  {% if form.submittedSuccessfully %}{{ successBanner }}{% endif %}
  {% if form.hasErrors %}{{ errorBanner }}{% endif %}
{% endif %}
