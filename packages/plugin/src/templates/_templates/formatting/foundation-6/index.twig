{% do view.registerAssetBundle('Solspace\\Freeform\\Resources\\Bundles\\FormattingTemplates\\Foundation6Bundle') %}

{% import "freeform/_templates/formatting/foundation-6/_row.twig" as rowMacro %}

{# Signature pads may grow to 125% of their configured width; use 1 to prevent enlargement. #}
{# Render the opening form tag #}
{% set formTagProperties = {
    attributes: {
        form: { class: "freeform-form", "data-freeform-foundation": true, "data-freeform-signature-responsive": true, "data-freeform-signature-theme": "foundation-6", "data-freeform-signature-max-scale": 1.25 },
        row: { class: "grid-x grid-margin-x" },
        success: { class: "callout success", role: "status" },
        errors: { class: "callout alert", role: "alert" },
        novalidate: true,
    },
    buttons: {
        attributes: {
            container: { class: "cell submit-buttons" },
            submit: { class: "button primary" },
            back: { class: "button secondary" },
            save: { class: "button primary" },
        },
    },
    fields: {
        "@global": {
            attributes: {
                container: { class: "cell" },
                label: { class: "freeform-label" },
                input: {
                    class: "freeform-field",
                },
                instructions: { class: "help-text" },
                error: { class: "no-bullet freeform-errors" },
            },
        },
        ":required": {
            attributes: {
                label: { "+class": "required" },
            },
        },
        ":errors": {
            attributes: {
                input: { "+class": "has-error" },
            },
        },
        "@group": {
            attributes: {
                label: { "+class": "h6" },
            },
        },
        "@signature": {
            attributes: {
                input: { "-class": "freeform-field", "+class": "button secondary freeform-signature-clear" },
            },
        },
    },
} %}
{% if form.type == 'Page' %}
    {% do form.registerContext(formTagProperties) %}
    <div class="{{ formTagProperties.attributes.form.class }} freeform-page"{% for name, value in formTagProperties.attributes.form %}{% if name starts with 'data-' %} {{ name }}="{{ value is same as(true) ? 'true' : value }}"{% endif %}{% endfor %}{% if form.pageBackgroundColor %} style="background-color: {{ form.pageBackgroundColor }}"{% endif %}>
{% else %}
    {{ form.renderTag(formTagProperties) }}
{% endif %}

{% if form.type != 'Page' %}
    {% include "freeform/_templates/formatting/foundation-6/_messages.twig" %}
{% endif %}

{# Render page tabs if multi-page #}
{% if form.type != 'Page' and form.pages|length > 1 %}
    <ul class="menu freeform-page-tabs">
        {% for page in form.pages %}
            <li class="menu-text{{ form.currentPage.index == page.index ? ' is-active' : '' }}"{% if form.currentPage.index == page.index %} aria-current="step"{% endif %}>
                {{ page.label }}
            </li>
        {% endfor %}
    </ul>
{% endif %}

{# Display form field rows and columns #}
{{ rowMacro.render(form.canvasRows, form) }}

{# Render the closing form tag #}
{% if form.type == 'Page' %}</div>{% else %}{{ form.renderClosingTag }}{% endif %}
