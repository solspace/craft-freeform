{% import "_includes/forms" as forms %}
{% set typeDefinition = integration.typeDefinition %}

{{ csrfInput() }}
{{ redirectInput('freeform/settings/integrations/'~typeDefinition.shortName) }}

<input type="hidden" name="id" value="{{ integration.id }}" />
<input type="hidden" name="class" value="{{ integration.class }}" />
<input type="hidden" name="action" value="{{ action }}" />
<input type="hidden" name="type" value="{{ type }}" />

<div id="integration-title">
    <img
        src="{{ typeDefinition.iconUrl }}"
        alt="{{ typeDefinition.name }}"
    />

    <span>{{ typeDefinition.name }}</span>

    {% if integration.integrationObject|implementsClass('Solspace\\Freeform\\Library\\Integrations\\APIIntegrationInterface') %}
        {% include "freeform/settings/components/auth-checker" with { integration: integration } %}
    {% endif %}
</div>
<ul id="auth-errors"></ul>

{{ forms.textField({
    label: "Name"|t('freeform'),
    instructions: "What this integration will be called in the CP."|t('freeform'),
    id: 'name',
    name: 'name',
    value: integration.name,
    errors: integration.getErrors('name'),
    autofocus: true,
    required: true
}) }}

{{ forms.textField({
    label: "Handle"|t('freeform'),
    instructions: "The unique name used to identify this integration."|t('freeform'),
    class: "code",
    id: 'handle',
    name: 'handle',
    value: integration.handle,
    errors: integration.getErrors('handle'),
    required: true
}) }}

<hr>

{% if integration.errors('integration') %}
    <ul class="errors field">
        {% for error in integration.errors('integration') %}
            <li>{{ error }}</li>
        {% endfor %}
    </ul>
{% endif %}

<div class="propertiesWrapper">

    {% if typeDefinition.readme %}

        {{ include('freeform/settings/components/markdown', {
            content: typeDefinition.readmeContent|markdown('gfm-comment')
        }) }}

        <hr>

    {% endif %}

    <div class="property-editor" data-class="{{ typeDefinition.class }}">
        {% for property in typeDefinition.properties | filter((prop) => not prop.hasFlag('internal', 'instance')) %}

            {{ include('freeform/settings/integrations/_components/property', { type: typeDefinition }) }}

        {% endfor %}
    </div>

</div>
